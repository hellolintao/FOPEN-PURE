.setting-page {
  min-height: 100vh;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding: var(--space-7);
  gap: var(--space-7);
}

.brand-block {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-3);
  max-width: 640rpx;
}

.brand-tape {
  margin-bottom: var(--space-3);
}

.brand-mark {
  font-family: var(--font-family-display);
  font-size: 168rpx;
  font-weight: 900;
  line-height: 0.85;
  letter-spacing: -0.06em;
  color: var(--color-ink);
}

.brand-sub {
  font-size: 26rpx;
  font-weight: 900;
  letter-spacing: 0.12em;
  color: var(--color-muted);
  text-transform: uppercase;
}

.brand-divider {
  width: 96rpx;
  height: 6rpx;
  background: var(--color-lime);
  margin: var(--space-4) 0;
}

.brand-meta {
  font-size: var(--font-body-size);
  color: var(--color-muted);
  letter-spacing: 0.02em;
  line-height: 1.5;
}

.setting-section {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.section-title {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--color-ink);
}

.setting-row {
  width: 100%;
  min-height: 112rpx;
  border-radius: 8rpx;
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  padding: var(--space-4);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: var(--space-1);
  text-align: left;
  line-height: 1.4;
}

.setting-row::after {
  border: 0;
}

.row-main {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--color-ink);
}

.row-meta {
  font-size: 24rpx;
  color: var(--color-muted);
}

.warning {
  border-color: #f59e0b;
}

.danger {
  border-color: #dc2626;
}
