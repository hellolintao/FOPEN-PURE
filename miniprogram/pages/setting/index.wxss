/* ========== 容器 ========== */
.setting-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0f0f1a 0%, #1a1a2e 50%, #0d0d14 100%);
  padding-bottom: 40rpx;
}

/* ========== 顶部标题 ========== */
.header-section {
  padding: 60rpx 40rpx 40rpx 40rpx;
  text-align: center;
}

.page-title {
  font-size: 52rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #a78bfa 0%, #7c3aed 50%, #c084fc 100%);
  background-clip: text;
  -webkit-background-clip: text;
  color: transparent;
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 20rpx rgba(124, 58, 237, 0.3);
}

.title-underline {
  width: 120rpx;
  height: 6rpx;
  background: linear-gradient(90deg, transparent, #7c3aed, transparent);
  margin: 16rpx auto 0;
  border-radius: 3rpx;
}

/* ========== 设置列表 ========== */
.setting-list {
  padding: 0 24rpx;
}

.setting-section {
  margin-bottom: 24rpx;
  background: rgba(26, 26, 46, 0.6);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.section-title {
  padding: 24rpx 32rpx 16rpx 32rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
  font-weight: 500;
}

/* ========== 设置项 ========== */
.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
  transition: background 0.2s ease;
  position: relative;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-item:active {
  background: rgba(255, 255, 255, 0.03);
}

.item-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.item-icon {
  font-size: 36rpx;
}

.item-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.item-value {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-right: 8rpx;
}

.item-arrow {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.3);
  line-height: 1;
}

/* ========== 退出登录项 ========== */
.logout-item {
  border-bottom: none;
}

.logout-item .item-label {
  color: #ff6b6b;
}

/* ========== 版本信息 ========== */
.version-info {
  text-align: center;
  padding: 40rpx 0;
}

.version-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.3);
}
