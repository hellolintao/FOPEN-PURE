<view class="member-edit-container">
  <view class="member-edit-title">{{isEdit ? '编辑会员' : '新增会员'}}</view>
  
  <view class="form-section">
    <!-- 头像（只读显示） -->
    <view class="avatar-section">
      <view class="avatar-preview">
        <image wx:if="{{member.avatarUrl}}" src="{{member.avatarUrl}}" class="avatar-img" mode="aspectFill" />
        <view wx:else class="avatar-placeholder">
          <text class="placeholder-icon">👤</text>
          <text class="placeholder-text">默认头像</text>
        </view>
      </view>
    </view>

    <!-- 会员姓名 -->
    <view class="form-item">
      <view class="field-label">
        <text class="required">*</text>会员姓名
      </view>
      <input class="dialog-input" placeholder="请输入会员姓名" value="{{member.name}}" data-key="name" bindinput="onInput" />
    </view>

    <!-- 手机号 -->
    <view class="form-item">
      <view class="field-label">手机号</view>
      <input class="dialog-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{member.phone}}" data-key="phone" bindinput="onInput" />
    </view>

    <!-- 状态 -->
    <view class="form-item">
      <view class="field-label">
        <text class="required">*</text>会员状态
      </view>
      <picker mode="selector" range="{{statusOptions}}" range-key="label" value="{{statusIndex}}" bindchange="onPickStatus">
        <view class="dialog-input picker-input">
          <text class="picker-text">{{member.status ? statusOptions[statusIndex].label : '选择状态'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 是否管理员 -->
    <view class="form-item">
      <view class="field-label">管理员权限</view>
      <view class="switch-wrapper">
        <switch
          class="switch"
          checked="{{member.admin}}"
          bindchange="onAdminChange"
          color="#1890ff"
        />
        <text class="switch-label">{{member.admin ? '是' : '否'}}</text>
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="dialog-actions">
    <button wx:if="{{isEdit}}" class="dialog-btn delete" bindtap="onDeleteMember">删除会员</button>
    <button class="dialog-btn cancel" bindtap="onCancel">取消</button>
    <button class="dialog-btn primary" bindtap="onSubmit">{{isEdit ? '保存修改' : '确认新增'}}</button>
  </view>
</view>
