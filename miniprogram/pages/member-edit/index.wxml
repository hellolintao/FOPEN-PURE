<view class="me-page">

  <!-- HEAD -->
  <view class="me-head anim-stage-rise">
    <view class="head-tapes">
      <text class="tape tape-stamped">EDIT MEMBER · 编辑</text>
    </view>
    <text class="head-title">编辑会员</text>
  </view>

  <!-- AVATAR -->
  <view class="avatar-card anim-stage-rise anim-delay-1">
    <view class="avatar-wrap">
      <image wx:if="{{member.avatarUrl}}" src="{{member.avatarUrl}}" class="avatar-img" mode="aspectFill" />
      <view wx:else class="avatar-placeholder">
        <text class="placeholder-text">{{member.name ? member.name.charAt(0) : '会'}}</text>
      </view>
    </view>
    <view class="avatar-meta">
      <text class="avatar-meta-label">AVATAR</text>
      <text class="avatar-meta-val">{{member.avatarUrl ? '已上传' : '默认头像'}}</text>
    </view>
  </view>

  <!-- FORM -->
  <view class="me-form anim-stage-rise anim-delay-2">
    <view class="form-item">
      <view class="field-label">
        <text class="num field-num">01</text>
        <text class="field-text">会员姓名 <text class="required">*</text></text>
      </view>
      <input class="form-input" placeholder="请输入会员姓名" placeholder-class="form-placeholder" value="{{member.name}}" data-key="name" bindinput="onInput" />
    </view>

    <view class="form-item">
      <view class="field-label">
        <text class="num field-num">02</text>
        <text class="field-text">手机号</text>
      </view>
      <input class="form-input num" type="number" maxlength="11" placeholder="请输入手机号" placeholder-class="form-placeholder" value="{{member.phone}}" data-key="phone" bindinput="onInput" />
    </view>

    <view class="form-item">
      <view class="field-label">
        <text class="num field-num">03</text>
        <text class="field-text">会员状态 <text class="required">*</text></text>
      </view>
      <picker mode="selector" range="{{statusOptions}}" range-key="label" value="{{statusIndex}}" bindchange="onPickStatus">
        <view class="form-input picker-input">
          <text class="{{member.status ? '' : 'form-placeholder'}}">{{member.status ? statusOptions[statusIndex].label : '选择状态'}}</text>
          <text class="picker-arrow num">→</text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <view class="field-label">
        <text class="num field-num">04</text>
        <text class="field-text">打法 <text class="optional">(选填)</text></text>
      </view>
      <picker mode="selector" range="{{playStyleOptions}}" range-key="label" value="{{playStyleIndex}}" bindchange="onPickPlayStyle">
        <view class="form-input picker-input">
          <text class="{{member.playStyle ? '' : 'form-placeholder'}}">{{member.playStyle ? playStyleOptions[playStyleIndex].label : '选择打法'}}</text>
          <text class="picker-arrow num">→</text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <view class="field-label">
        <text class="num field-num">05</text>
        <text class="field-text">管理员权限</text>
      </view>
      <view class="switch-row">
        <switch class="switch" checked="{{member.admin}}" bindchange="onAdminChange" color="#0B0C09" />
        <text class="switch-label">{{member.admin ? '是 · ADMIN' : '否 · MEMBER'}}</text>
      </view>
    </view>
  </view>

  <!-- ACTIONS -->
  <view class="me-actions anim-stage-rise anim-delay-3">
    <view wx:if="{{isEdit}}" class="me-btn me-btn-danger tap-scale" bindtap="onDeleteMember">删除会员</view>
    <view class="me-btn me-btn-ghost tap-scale" bindtap="onCancel">取消</view>
    <view class="me-btn me-btn-primary tap-scale" bindtap="onSubmit">保存修改</view>
  </view>
</view>
