.me-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: var(--space-5) var(--space-5) 160rpx;
}

/* ============================================================
 * HEAD
 * ============================================================ */
.me-head {
  margin-bottom: var(--space-6);
}

.head-tapes {
  margin-bottom: var(--space-4);
}

.head-title {
  display: block;
  font-size: 56rpx;
  font-weight: 900;
  color: var(--color-ink);
  line-height: 1;
  letter-spacing: -0.01em;
}

/* ============================================================
 * AVATAR CARD
 * ============================================================ */
.avatar-card {
  display: flex;
  align-items: center;
  gap: var(--space-5);
  padding: var(--space-5);
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-md);
  margin-bottom: var(--space-5);
}

.avatar-wrap {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: var(--color-bg-3);
  border: 2rpx solid var(--color-ink);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.placeholder-text {
  font-size: 48rpx;
  font-weight: 900;
  color: var(--color-ink);
}

.avatar-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.avatar-meta-label {
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-muted);
}

.avatar-meta-val {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--color-ink);
}

/* ============================================================
 * FORM
 * ============================================================ */
.me-form {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
  margin-bottom: var(--space-6);
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.field-label {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
}

.field-num {
  font-size: 18rpx;
  font-weight: 900;
  color: var(--color-muted);
  letter-spacing: 0.08em;
}

.field-text {
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 0.06em;
  color: var(--color-ink);
  text-transform: uppercase;
}

.required {
  color: var(--color-danger);
  margin-left: 4rpx;
}

.form-input {
  width: 100%;
  background: var(--color-bg-3);
  border-radius: var(--radius-sm);
  color: var(--color-ink);
  font-size: 28rpx;
  font-weight: 700;
  padding: 0 24rpx;
  min-height: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  box-sizing: border-box;
}

.form-placeholder {
  color: var(--color-muted-2);
  font-weight: 600;
}

.picker-input {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-arrow {
  font-size: 24rpx;
  font-weight: 900;
  color: var(--color-ink);
}

.switch-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: 8rpx 0;
}

.switch-label {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--color-ink);
  letter-spacing: 0.04em;
}

/* ============================================================
 * ACTIONS
 * ============================================================ */
.me-actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.me-btn {
  width: 100%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-5) 0;
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.me-btn-primary {
  background: var(--color-ink);
  color: var(--color-bg);
}

.me-btn-ghost {
  background: var(--color-bg);
  color: var(--color-ink);
  border: 2rpx solid var(--color-ink);
}

.me-btn-danger {
  background: var(--color-bg);
  color: var(--color-danger);
  border: 2rpx solid var(--color-danger);
}
