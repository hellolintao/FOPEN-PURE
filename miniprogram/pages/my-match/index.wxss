.mm-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: var(--space-5) var(--space-5) 160rpx;
}

/* ============================================================
 * HEAD
 * ============================================================ */
.mm-head {
  margin-bottom: var(--space-6);
}

.head-tapes {
  margin-bottom: var(--space-4);
}

.head-titles {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
}

.head-title-zh {
  font-size: 64rpx;
  font-weight: 900;
  color: var(--color-ink);
  line-height: 0.95;
  letter-spacing: -0.01em;
}

.head-title-en {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--color-muted-2);
  letter-spacing: 0.08em;
}

/* ============================================================
 * STATE
 * ============================================================ */
.mm-state {
  padding: var(--space-7) 0;
}

.mm-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-4);
  padding: var(--space-9) 0;
  text-align: center;
}

.mm-empty-hint {
  font-size: var(--font-body-size);
  color: var(--color-muted);
  max-width: 480rpx;
  line-height: 1.5;
}

/* ============================================================
 * SCORABLE
 * ============================================================ */
.scorable-block {
  background: var(--color-lime);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  margin-bottom: var(--space-7);
  box-shadow: 6rpx 6rpx 0 var(--color-ink);
}

.scorable-head {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-3);
}

.scorable-count {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: var(--color-ink-3);
  text-transform: uppercase;
  margin-left: auto;
}

.scorable-list {
  background: var(--color-bg);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.scorable-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-4) var(--space-5);
  gap: var(--space-3);
  border-bottom: 1rpx solid var(--color-border);
}

.scorable-row:last-child { border-bottom: 0; }

.scorable-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
  flex: 1;
}

.scorable-tournament {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-ink);
  letter-spacing: 0.01em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scorable-opponent {
  font-family: var(--font-family-num);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.06em;
  color: var(--color-muted);
}

.scorable-status-wrap {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  flex-shrink: 0;
}

.scorable-status {
  display: inline-flex;
  align-items: center;
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: var(--radius-sm);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.scorable-status.status-pending { background: var(--color-bg-3); color: var(--color-ink-3); }
.scorable-status.status-submitted { background: var(--color-ink); color: var(--color-bg); }
.scorable-status.status-confirmed { background: var(--color-lime); color: var(--color-ink); }

.scorable-arrow {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--color-ink);
  line-height: 1;
}

/* ============================================================
 * TOURNAMENT LIST
 * ============================================================ */
.tournament-list {
  display: flex;
  flex-direction: column;
}

.section-head {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.section-count {
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: var(--color-muted);
  text-transform: uppercase;
  margin-left: auto;
}

.tournament-card {
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-md);
  margin-bottom: var(--space-4);
  overflow: hidden;
}

.tc-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-4) var(--space-5);
  background: var(--color-ink);
  color: var(--color-bg);
  gap: var(--space-3);
}

.tc-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 900;
  color: var(--color-bg);
  letter-spacing: -0.01em;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tc-type {
  flex-shrink: 0;
  font-family: var(--font-family-num);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.16em;
  color: var(--color-lime);
  padding: 4rpx 12rpx;
  border: 1rpx solid var(--color-lime);
  border-radius: var(--radius-sm);
}

.tc-body {
  padding: var(--space-4) var(--space-5);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.tc-row {
  display: flex;
  align-items: baseline;
  gap: var(--space-4);
}

.tc-label {
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.16em;
  color: var(--color-muted);
  text-transform: uppercase;
  min-width: 96rpx;
}

.tc-value {
  flex: 1;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-ink);
  letter-spacing: 0.01em;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tc-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-3) var(--space-5);
  border-top: 1rpx solid var(--color-border);
  background: var(--color-bg-3);
}

.tc-cta-text {
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-ink);
}

.tc-cta-arrow {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--color-ink);
  line-height: 1;
}
