.mm-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: var(--space-5) var(--space-5) 160rpx;
}

/* ============================================================
 * HEAD
 * ============================================================ */
.mm-head {
  margin-bottom: var(--space-6);
}

.head-tapes {
  margin-bottom: var(--space-4);
}

.head-titles {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
}

.head-title-zh {
  font-size: 64rpx;
  font-weight: 900;
  color: var(--color-ink);
  line-height: 0.95;
  letter-spacing: -0.01em;
}

.head-title-en {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--color-muted-2);
  letter-spacing: 0.08em;
}

/* ============================================================
 * STATE
 * ============================================================ */
.mm-state {
  padding: var(--space-7, 48rpx) var(--space-5, 24rpx);
}

/* ============================================================
 * HERO
 * ============================================================ */
.mm-hero {
  background: var(--color-ink);
  color: #FFF;
  border-radius: var(--radius-lg, 24rpx);
  padding: var(--space-6, 32rpx);
  margin: 0 var(--space-5, 24rpx) var(--space-5, 24rpx);
}

.mm-hero-eyebrow {
  font-size: 22rpx;
  opacity: 0.7;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.mm-hero-big {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  margin: 12rpx 0;
}

.mm-hero-cta {
  display: inline-block;
  background: var(--color-lime);
  color: var(--color-ink);
  font-size: 26rpx;
  font-weight: 700;
  padding: 16rpx 32rpx;
  border-radius: var(--radius-sm, 8rpx);
  margin-top: 16rpx;
}

.mm-hero-cta--sec {
  background: rgba(255,255,255,0.15);
  color: #FFF;
}

/* ============================================================
 * BLOCKS
 * ============================================================ */
.mm-block {
  background: var(--color-bg-2);
  border-radius: var(--radius-md, 16rpx);
  padding: var(--space-5, 24rpx);
  margin: 0 var(--space-5, 24rpx) var(--space-4, 16rpx);
}

.mm-block-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-ink);
  margin-bottom: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.mm-block-meta {
  font-size: 22rpx;
  color: var(--color-muted);
  font-weight: 400;
}

/* ============================================================
 * ROWS
 * ============================================================ */
.mm-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-top: 1rpx dashed var(--color-border);
}

.mm-row:first-child {
  border-top: 0;
}

.mm-row-l {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.mm-row-t {
  font-size: 26rpx;
  color: var(--color-ink);
  font-weight: 500;
}

.mm-row-s {
  font-size: 22rpx;
  color: var(--color-muted);
  margin-top: 4rpx;
}
