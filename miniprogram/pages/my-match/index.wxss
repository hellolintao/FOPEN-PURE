/* ========== 容器 ========== */
.my-match-container {
  min-height: 100vh;
  background: #f7f7f7;
  padding: 24rpx;
}

/* ========== 加载和空状态 ========== */
.loading,
.empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  color: #999;
  font-size: 28rpx;
}

/* ========== 赛事列表 ========== */
.tournament-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ========== 赛事卡片 ========== */
.tournament-card {
  background: #ffffff;
  border-radius: 8rpx;
  overflow: hidden;
}

.tournament-card:active {
  background: #f5f5f5;
}

/* ========== 卡片头部 ========== */
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid #e5e5e5;
}

.header-left {
  flex: 1;
}

.tournament-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.header-right {
  padding-left: 20rpx;
}

.tournament-type {
  font-size: 24rpx;
  color: #666666;
  background: #f0f0f0;
  padding: 8rpx 16rpx;
  border-radius: 4rpx;
}

/* ========== 卡片内容 ========== */
.card-body {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-row {
  display: flex;
  align-items: center;
}

.info-label {
  font-size: 28rpx;
  color: #666666;
  min-width: 140rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333333;
  flex: 1;
}

/* ========== 状态样式 ========== */
.status-upcoming {
  color: #ffa500;
}

.status-ongoing {
  color: #52c41a;
}

.status-ended {
  color: #999999;
}

/* ========== Phase 8 可录分块 ========== */
.scorable-block {
  background: #fff7ed;
  margin: 16rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}
.block-title {
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
  font-size: 28rpx;
}
.scorable-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #fed7aa;
  gap: 12rpx;
}
.scorable-row:last-child {
  border-bottom: 0;
}
.scorable-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
  flex: 1;
}
.scorable-tournament {
  font-weight: 500;
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.scorable-opponent {
  font-size: 24rpx;
  color: #777;
}
.scorable-status {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}
.scorable-status.status-pending  { background: rgba(0,0,0,0.06); color: #777; }
.scorable-status.status-submitted { background: rgba(234,179,8,0.12); color: #ca8a04; }
