<view class="my-match-container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- 可录分比赛 -->
  <view wx:if="{{!loading && scorable.length > 0}}" class="scorable-block">
    <text class="block-title">可录分比赛</text>
    <view
      wx:for="{{scorable}}"
      wx:key="_id"
      class="scorable-row"
      bindtap="onOpenScoreRow"
      data-tid="{{item.tournamentId}}"
      data-mid="{{item.sourceMatchId}}"
    >
      <view class="scorable-info">
        <text class="scorable-tournament">{{item.tournamentName}}</text>
        <text class="scorable-opponent">vs {{item.opponentLabel}}</text>
      </view>
      <text class="scorable-status status-{{item.resultStatus}}">{{item.statusLabel}}</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!loading && tournamentList.length === 0 && scorable.length === 0}}" class="empty">
    <text>暂无参赛记录</text>
  </view>

  <!-- 赛事列表 -->
  <view wx:if="{{!loading && tournamentList.length > 0}}" class="tournament-list">
    <view
      wx:for="{{tournamentList}}"
      wx:key="tournament._id"
      class="tournament-card"
      bindtap="onCardTap"
      data-tournament-id="{{item.tournament._id}}"
    >
      <!-- 卡片标题 -->
      <view class="card-header">
        <view class="header-left">
          <text class="tournament-name">{{item.tournament.name}}</text>
        </view>
        <view class="header-right">
          <text class="tournament-type">{{item.tournament.type === 'singles' ? '单打' : '双打'}}</text>
        </view>
      </view>

      <!-- 卡片内容 -->
      <view class="card-body">

        <!-- 队伍名 -->
        <view wx:if="{{item.registration.teamName}}" class="info-row">
          <text class="info-label">队伍：</text>
          <text class="info-value">{{item.registration.teamName}}</text>
        </view>

        <view class="info-row">
          <text class="info-label">参赛选手：</text>
          <text class="info-value">{{item.registration.playerName}} {{item.registration.partnerName || ''}}</text>
        </view>        

        <!-- 赛事状态 -->
        <!-- <view class="info-row">
          <text class="info-label">状态：</text>
          <text class="info-value status-{{item.tournament.status}}">
            {{item.tournament.status === 'upcoming' ? '待开始' : item.tournament.status === 'ongoing' ? '进行中' : '已结束'}}
          </text>
        </view> -->
      </view>
    </view>
  </view>
</view>
