<view class="mm-page">

  <!-- Visual-stream HEAD preserved -->
  <view class="mm-head anim-stage-rise">
    <view class="head-tapes">
      <text class="tape tape-stamped">MY MATCHES · 我的比赛</text>
    </view>
    <view class="head-titles">
      <text class="head-title-zh">我的比赛</text>
      <text class="head-title-en num">MATCHES</text>
    </view>
  </view>

  <!-- Loading -->
  <view wx:if="{{loadState === 'loading'}}" class="mm-state">
    <skeleton-loader rows="{{6}}" />
  </view>

  <!-- Error -->
  <view wx:elif="{{loadState === 'error'}}" class="mm-state">
    <empty-state icon="warn" title="加载失败" subtitle="{{error.message || ''}}" action="重新加载" bindaction="onRetry" />
  </view>

  <!-- Loaded -->
  <block wx:elif="{{loadState === 'loaded'}}">
    <!-- Empty -->
    <view wx:if="{{summary.registrations.length === 0 && summary.pending.length === 0 && summary.submitted.length === 0 && summary.confirmed.length === 0}}" class="mm-state">
      <empty-state icon="sprout" title="本周没有比赛" subtitle="加入下一场赛事或查看历史" action="查看赛程" bindaction="onViewSchedule" />
    </view>

    <block wx:else>
      <!-- Hero -->
      <view class="mm-hero">
        <text class="mm-hero-eyebrow">本周</text>
        <text class="mm-hero-big">{{summary.pending.length > 0 ? ('你有 ' + summary.pending.length + ' 场待录分') : (summary.submitted.length > 0 ? (summary.submitted.length + ' 场等管理员确认') : '本周没有比赛')}}</text>
        <view wx:if="{{summary.pending.length > 0}}" class="mm-hero-cta" bindtap="onRecordNow">→ 现在录</view>
        <view wx:else class="mm-hero-cta mm-hero-cta--sec" bindtap="onViewSchedule">查看赛程</view>
      </view>

      <!-- 我的报名 -->
      <view wx:if="{{summary.registrations.length > 0}}" class="mm-block">
        <view class="mm-block-title">
          <text>我的报名</text>
          <status-tag type="muted" text="{{summary.registrations.length}}" />
        </view>
        <view class="mm-row" wx:for="{{summary.registrations}}" wx:key="tournamentId" data-tournamentid="{{item.tournamentId}}" bindtap="onRegistrationRow">
          <view class="mm-row-l">
            <text class="mm-row-t">{{item.tournamentName}}</text>
            <text class="mm-row-s">{{item.withdrawDeadlineLabel ? ('可退至 ' + item.withdrawDeadlineLabel) : item.statusLabel}}</text>
          </view>
          <status-tag type="{{item.canWithdraw ? 'amber' : 'muted'}}" text="{{item.statusLabel}}" />
        </view>
      </view>

      <!-- 待录分 -->
      <view wx:if="{{summary.pending.length > 0}}" class="mm-block">
        <view class="mm-block-title">
          <text>待录分</text>
          <status-tag type="amber" text="{{summary.pending.length}}" />
        </view>
        <view class="mm-row" wx:for="{{summary.pending}}" wx:key="matchId" data-matchid="{{item.matchId}}" data-tournamentid="{{item.tournamentId}}" bindtap="onPendingRow">
          <view class="mm-row-l">
            <text class="mm-row-t">{{item.tournamentName}} {{item.round}}-{{item.position}}</text>
            <text class="mm-row-s">{{item.courtName}} · vs {{item.opponentLabel || item.p2.name}}</text>
          </view>
          <status-tag type="amber" text="录分" />
        </view>
      </view>

      <!-- 确认中 -->
      <view wx:if="{{summary.submitted.length > 0}}" class="mm-block">
        <view class="mm-block-title">
          <text>确认中</text>
          <status-tag type="amber" text="{{summary.submitted.length}}" />
        </view>
        <view class="mm-row" wx:for="{{summary.submitted}}" wx:key="matchId" data-matchid="{{item.matchId}}" data-tournamentid="{{item.tournamentId}}" bindtap="onSubmittedRow">
          <view class="mm-row-l">
            <text class="mm-row-t">{{item.tournamentName}} {{item.round}} · {{item.scoreLabel || (item.score.sets[0].a + ':' + item.score.sets[0].b)}}</text>
            <text class="mm-row-s">等管理员确认 · vs {{item.opponentLabel}}</text>
          </view>
          <status-tag type="amber" text="确认中" />
        </view>
      </view>

      <!-- 已确认 -->
      <view wx:if="{{summary.confirmed.length > 0}}" class="mm-block">
        <view class="mm-block-title">
          <text>已确认</text>
          <text class="mm-block-meta">最近 10 场</text>
        </view>
        <view class="mm-row" wx:for="{{summary.confirmed}}" wx:key="matchId">
          <view class="mm-row-l">
            <text class="mm-row-t">{{item.tournamentName}} {{item.round}} · {{item.scoreLabel || (item.score.sets[0].a + ':' + item.score.sets[0].b)}} {{item.isWinner ? '胜' : '负'}}</text>
            <text class="mm-row-s">+{{item.pointsEarned}} 积分</text>
          </view>
          <status-tag type="ok" text="已确认" />
        </view>
      </view>
    </block>
  </block>
</view>
