<view class="tournament-detail-container">
  <!-- 赛事信息单元 -->
  <view class="section-card">
    <view class="card-header">
      <text class="header-title">赛事信息</text>
      <button class="header-edit-btn" bindtap="onEdit">
        <text class="edit-icon">✏️</text>
      </button>
    </view>
    <view class="info-content">
      <view class="info-row compact">
        <text class="label">名称</text>
        <text class="value">{{tournament.name}}</text>
      </view>
      <view class="info-row compact">
        <text class="label">赛季</text>
        <text class="value">{{tournament.seasonName || '-'}}</text>
      </view>
      <view class="info-row compact">
        <text class="label">类型</text>
        <text class="value">{{tournament.type === 'singles' ? '单打' : '双打'}}</text>
      </view>
      <view class="info-row compact">
        <text class="label">时间</text>
        <text class="value">{{tournament.startDate}} 至 {{tournament.endDate}}</text>
      </view>
      <!-- <view class="info-row compact">
        <text class="label">场地</text>
        <text class="value">{{tournament.location}}</text>
      </view>
      <view class="info-row compact">
        <text class="label">状态</text>
        <view class="status-badge {{tournament.status}}">{{getStatusText(tournament.status)}}</view>
      </view> -->
      <view class="info-row compact" wx:if="{{tournament.description}}">
        <text class="label">描述</text>
        <text class="value desc">{{tournament.description}}</text>
      </view>
      <view class="info-divider">配置</view>
      <view class="info-row compact">
        <text class="label">最大人数</text>
        <text class="value">{{tournament.config.maxPlayers || '-'}}人</text>
      </view>
      <view class="info-row compact">
        <text class="label">每场人数</text>
        <text class="value">{{tournament.config.playersPerMatch || '-'}}人</text>
      </view>
      <view class="info-row compact">
        <text class="label">当前轮次</text>
        <text class="value">第{{tournament.config.currentRound || 1}}轮</text>
      </view>
      <view class="info-row compact">
        <text class="label">总轮数</text>
        <text class="value">{{tournament.config.totalRounds || '-'}}轮</text>
      </view>
      <view class="info-row compact">
        <text class="label">赛制</text>
        <text class="value">{{tournament.config.format == 'knockout' ? '淘汰赛' : '常规赛'}}</text>
      </view>
      <!-- <view class="info-row compact">
        <text class="label">淘汰类型</text>
        <text class="value">{{tournament.config.eliminationType === 'single' ? '单败淘汰' : '双败淘汰'}}</text>
      </view> -->
      <view class="info-row compact" wx:if="{{tournament.config.seedPlayers && tournament.config.seedPlayers.length > 0}}">
        <text class="label">种子选手</text>
        <text class="value">{{tournament.config.seedPlayers.join(', ')}}</text>
      </view>
      <view class="info-divider">积分规则</view>
      <view class="points-grid">
        <view class="point-item">
          <text class="point-label">胜</text>
          <text class="point-value win">{{tournament.pointsRules.win || 0}}</text>
        </view>
        <view class="point-item">
          <text class="point-label">负</text>
          <text class="point-value loss">{{tournament.pointsRules.loss || 0}}</text>
        </view>
        <view class="point-item">
          <text class="point-label">弃</text>
          <text class="point-value walkover">{{tournament.pointsRules.walkover || 0}}</text>
        </view>
      </view>
      <view class="bonus-section" wx:if="{{tournament.pointsRules.bonusByRound}}">
        <view class="bonus-grid">
          <view class="bonus-item" wx:if="{{tournament.pointsRules.bonusByRound[1] !== undefined}}">
            <text class="bonus-label">第1轮</text>
            <text class="bonus-value">{{tournament.pointsRules.bonusByRound[1]}}</text>
          </view>
          <view class="bonus-item" wx:if="{{tournament.pointsRules.bonusByRound[2] !== undefined}}">
            <text class="bonus-label">第2轮</text>
            <text class="bonus-value">{{tournament.pointsRules.bonusByRound[2]}}</text>
          </view>
          <view class="bonus-item" wx:if="{{tournament.pointsRules.bonusByRound[3] !== undefined}}">
            <text class="bonus-label">第3轮</text>
            <text class="bonus-value">{{tournament.pointsRules.bonusByRound[3]}}</text>
          </view>
          <view class="bonus-item" wx:if="{{tournament.pointsRules.bonusByRound[4] !== undefined}}">
            <text class="bonus-label">第4轮</text>
            <text class="bonus-value">{{tournament.pointsRules.bonusByRound[4]}}</text>
          </view>
          <view class="bonus-item" wx:if="{{tournament.pointsRules.bonusByRound[5] !== undefined}}">
            <text class="bonus-label">第5轮</text>
            <text class="bonus-value">{{tournament.pointsRules.bonusByRound[5]}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 参赛人员单元 -->
  <view class="section-card">
    <view class="card-header">
      <text class="header-title">参赛人员</text>
      <button class="header-btn {{registrations.length > 0 ? 'change' : 'add'}}" bindtap="onAddPlayer">
        {{registrations.length > 0 ? '去变更' : '去添加'}}
      </button>
    </view>
    <view class="players-content">
      <view wx:if="{{registrations.length === 0}}" class="empty-state">
        <text class="empty-icon">👥</text>
        <text class="empty-text">暂无参赛人员</text>
      </view>
      <view wx:else class="players-grid">
        <view class="player-card" wx:for="{{registrations}}" wx:key="_id">
          <view class="player-badge">{{item.seed}}</view>

          <!-- 单打显示 -->
          <text class="player-name singles" wx:if="{{tournament.type === 'singles'}}">{{item.playerName}}</text>

          <!-- 双打显示 -->
          <view wx:if="{{tournament.type === 'doubles'}}" class="doubles-info">
            <text class="player-name">{{item.teamName || item.playerName}}</text>
            <view class="players-row">
              <text class="player-detail">{{item.playerName}}</text>
              <text class="player-divider">|</text>
              <text class="player-detail">{{item.partnerName}}</text>
            </view>
          </view>

          <view class="player-status {{item.status}}">
            {{item.status === 'confirmed' ? '已确认' : item.status === 'withdrew' ? '已退赛' : '已报名'}}
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 对位表单元 -->
  <view class="section-card">
    <view class="card-header">
      <text class="header-title">对位表</text>
      <button class="header-btn" bindtap="onEditMatchups">
        {{brackets.length > 0 ? '查看' : '创建'}}
      </button>
    </view>
    <view class="matchups-content">
      <view wx:if="{{brackets.length === 0}}" class="empty-state">
        <text class="empty-icon">📊</text>
        <text class="empty-text">暂无对位信息</text>
      </view>
      <view wx:else class="brackets-list">
        <view class="round-section" wx:for="{{brackets}}" wx:key="_id">
          <view class="round-header">
            <text class="round-title">第{{item.round}}轮</text>
          </view>
          <view class="round-matches">
            <view class="round-match" wx:for="{{item.matches}}" wx:for-item="match" wx:key="matchId">
              <view class="match-player">
                <text class="player-name">{{match.player1.name}}</text>
              </view>
              <view class="match-divider">Vs</view>
              <view class="match-player">
                <text class="player-name">{{match.player2.name}}</text>
              </view>
              <view class="match-status {{match.status}}">
                {{match.status === 'pending' ? '待开始' : match.status === 'ongoing' ? '进行中' : '已完成'}}
              </view>
            </view>
          </view>
        </view>
        <view class="enter-score-btn" bindtap="onEnterScore">
          <text>录入成绩</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 删除按钮 -->
  <view class="delete-section">
    <button class="delete-btn" bindtap="onDelete">
      <text class="delete-icon">🗑️</text>
      <text class="delete-text">删除赛事</text>
    </button>
  </view>
</view>
