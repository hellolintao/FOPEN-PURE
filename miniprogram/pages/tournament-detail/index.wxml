<view class="tournament-detail-container">
  <!-- 赛事信息 -->
  <view class="section-card">
    <view class="card-header">
      <text class="header-title">赛事信息</text>
    </view>
    <view class="info-content">
      <view class="info-row compact">
        <text class="label">名称</text>
        <text class="value">{{tournament.name}}</text>
      </view>
      <view class="info-row compact">
        <text class="label">赛季</text>
        <text class="value">{{tournament.seasonName || '-'}}</text>
      </view>
      <view class="info-row compact">
        <text class="label">类型</text>
        <text class="value">{{tournament.type === 'singles' ? '单打' : '双打'}}</text>
      </view>
      <view class="info-row compact">
        <text class="label">时间</text>
        <text class="value">{{tournament.startDate}}{{tournament.endDate ? ' 至 ' + tournament.endDate : ''}}</text>
      </view>
      <view class="info-row compact" wx:if="{{tournament.description}}">
        <text class="label">描述</text>
        <text class="value desc">{{tournament.description}}</text>
      </view>
      <view class="info-divider">配置</view>
      <view class="info-row compact">
        <text class="label">最大人数</text>
        <text class="value">{{tournamentDisplay.maxPlayers}}人</text>
      </view>
      <view class="info-row compact">
        <text class="label">每场人数</text>
        <text class="value">{{tournamentDisplay.playersPerMatch}}人</text>
      </view>
      <view class="info-row compact" wx:if="{{tournamentDisplay.showRoundInfo}}">
        <text class="label">当前轮次</text>
        <text class="value">第{{tournamentDisplay.currentRound}}轮</text>
      </view>
      <view class="info-row compact" wx:if="{{tournamentDisplay.showRoundInfo}}">
        <text class="label">总轮数</text>
        <text class="value">{{tournamentDisplay.totalRounds}}轮</text>
      </view>
      <view class="info-row compact">
        <text class="label">赛制</text>
        <text class="value">{{tournamentDisplay.formatText}}</text>
      </view>
      <view class="info-row compact" wx:if="{{tournamentDisplay.hasSeedPlayers}}">
        <text class="label">种子选手</text>
        <text class="value">{{tournamentDisplay.seedPlayersText}}</text>
      </view>

      <view class="info-divider">积分规则</view>
      <view class="points-grid" wx:if="{{tournamentDisplay.pointsMode === 'winLoss'}}">
        <view class="point-item">
          <text class="point-label">胜</text>
          <text class="point-value win">{{tournamentDisplay.win}}</text>
        </view>
        <view class="point-item">
          <text class="point-label">负</text>
          <text class="point-value loss">{{tournamentDisplay.loss}}</text>
        </view>
        <view class="point-item" wx:if="{{tournamentDisplay.walkover !== undefined}}">
          <text class="point-label">弃</text>
          <text class="point-value walkover">{{tournamentDisplay.walkover}}</text>
        </view>
      </view>
      <view class="bonus-section" wx:if="{{tournamentDisplay.pointsMode === 'placement'}}">
        <view class="bonus-grid">
          <view class="bonus-item" wx:for="{{tournamentDisplay.placementRows}}" wx:key="label">
            <text class="bonus-label">{{item.label}}</text>
            <text class="bonus-value">{{item.value}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 参赛人员 -->
  <view class="section-card">
    <view class="card-header">
      <text class="header-title">参赛人员</text>
    </view>
    <view class="players-content">
      <view wx:if="{{registrations.length === 0}}" class="empty-state">
        <text class="empty-icon">👥</text>
        <text class="empty-text">暂无参赛人员</text>
      </view>
      <view wx:else class="players-grid">
        <view class="player-card" wx:for="{{registrations}}" wx:key="_id">
          <view class="player-badge">{{item.seed}}</view>
          <text class="player-name singles" wx:if="{{tournament.type === 'singles'}}">{{item.playerName}}</text>
          <view wx:if="{{tournament.type === 'doubles'}}" class="doubles-info">
            <text class="player-name">{{item.teamName || item.playerName}}</text>
            <view class="players-row">
              <text class="player-detail">{{item.playerName}}</text>
              <text class="player-divider">|</text>
              <text class="player-detail">{{item.partnerName}}</text>
            </view>
          </view>
          <view class="player-status {{item.displayStatus}}">{{item.displayStatusText}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 赛程（只读） -->
  <view class="section-card">
    <view class="card-header">
      <text class="header-title">赛程</text>
    </view>
    <view wx:if="{{scheduleCourts.length === 0}}" class="empty-state">
      <text class="empty-icon">📅</text>
      <text class="empty-text">暂无排程</text>
    </view>
    <scroll-view wx:else scroll-x class="schedule-scroll">
      <view class="schedule-table">
        <view class="schedule-row header">
          <view class="time-col">时间</view>
          <view wx:for="{{scheduleCourts}}" wx:key="courtId" class="schedule-cell head">
            <text class="court-name">{{item.name}}</text>
          </view>
        </view>
        <view wx:for="{{scheduleRows}}" wx:for-item="row" wx:key="slotKey" class="schedule-row">
          <view class="time-col">{{row.slotLabel}}</view>
          <view
            wx:for="{{row.cells}}"
            wx:for-item="cell"
            wx:key="courtId"
            class="schedule-cell cell-{{cell.__rowKind}}"
          >
            <block wx:if="{{cell.kind === 'match'}}">
              <view class="match-line">
                <text class="player">{{cell.__player1Label}}</text>
                <text class="vs">VS</text>
                <text class="player">{{cell.__player2Label}}</text>
              </view>
            </block>
            <block wx:elif="{{cell.kind === 'freePlay'}}">
              <view class="free-line">
                <text class="free-title">自由拉球</text>
              </view>
            </block>
            <block wx:else>
              <text class="empty-cell">-</text>
            </block>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 删除按钮 -->
  <view wx:if="{{isAdmin}}" class="delete-section">
    <button class="delete-btn" bindtap="onDelete">
      <text class="delete-icon">🗑️</text>
      <text class="delete-text">删除赛事</text>
    </button>
  </view>
</view>

<!-- 固定底部操作栏 -->
<view wx:if="{{tournament}}" class="footer-bar">
  <block wx:if="{{tournament.status === 'draft' && isAdmin}}">
    <button class="footer-btn primary full" bindtap="onResumeDraft">继续创建</button>
  </block>
  <block wx:else>
    <button wx:if="{{isAdmin}}" class="footer-btn ghost" bindtap="onEdit">编辑</button>
    <button class="footer-btn primary" bindtap="onEnterScore">录入成绩</button>
  </block>
</view>
