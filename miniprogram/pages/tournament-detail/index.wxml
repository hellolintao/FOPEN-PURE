<view class="td-page">

  <view wx:if="{{loading}}" class="td-loading">
    <skeleton-loader rows="{{8}}" />
  </view>

  <block wx:elif="{{tournament}}">

    <!-- HERO -->
    <view class="td-hero anim-stage-rise">
      <view class="hero-tapes">
        <text class="tape tape-stamped">TOURNAMENT</text>
        <text class="tape tape-ghost">{{tournament.type === 'singles' ? 'SINGLES · 单打' : 'DOUBLES · 双打'}}</text>
      </view>
      <text class="hero-title">{{tournament.name}}</text>
      <view class="hero-meta">
        <view class="hero-meta-block">
          <text class="hero-meta-label">SEASON</text>
          <text class="hero-meta-val">{{tournament.seasonName || '—'}}</text>
        </view>
        <view class="hero-meta-block">
          <text class="hero-meta-label">DATE</text>
          <text class="hero-meta-val">{{tournament.startDate}}{{tournament.endDate ? ' → ' + tournament.endDate : ''}}</text>
        </view>
        <view class="hero-meta-block">
          <text class="hero-meta-label">FORMAT</text>
          <text class="hero-meta-val">{{tournamentDisplay.formatText}}</text>
        </view>
      </view>
      <view wx:if="{{tournament.description}}" class="hero-desc">
        <text>{{tournament.description}}</text>
      </view>
    </view>

    <!-- CONFIG · stat grid -->
    <view class="td-section anim-stage-rise anim-delay-1">
      <view class="td-section-head">
        <text class="tape">配置 · CONFIG</text>
      </view>
      <view class="config-grid">
        <view class="stat-block">
          <text class="stat-num num">{{tournamentDisplay.maxPlayers}}</text>
          <text class="stat-label">最大人数</text>
        </view>
        <view class="stat-block">
          <text class="stat-num num">{{tournamentDisplay.playersPerMatch}}</text>
          <text class="stat-label">每场人数</text>
        </view>
        <view wx:if="{{tournamentDisplay.showRoundInfo}}" class="stat-block">
          <text class="stat-num num">R{{tournamentDisplay.currentRound}}/{{tournamentDisplay.totalRounds}}</text>
          <text class="stat-label">当前/总轮</text>
        </view>
      </view>
      <view wx:if="{{tournamentDisplay.hasSeedPlayers}}" class="config-seed">
        <text class="config-seed-label">种子选手</text>
        <text class="config-seed-value">{{tournamentDisplay.seedPlayersText}}</text>
      </view>
    </view>

    <!-- POINTS RULES -->
    <view class="td-section anim-stage-rise anim-delay-2">
      <view class="td-section-head">
        <text class="tape">积分规则 · POINTS</text>
      </view>
      <view wx:if="{{tournamentDisplay.pointsMode === 'winLoss'}}" class="points-row">
        <view class="point-card point-win">
          <text class="point-card-num num">{{tournamentDisplay.win}}</text>
          <text class="point-card-label">胜</text>
        </view>
        <view class="point-card point-loss">
          <text class="point-card-num num">{{tournamentDisplay.loss}}</text>
          <text class="point-card-label">负</text>
        </view>
        <view wx:if="{{tournamentDisplay.walkover !== undefined}}" class="point-card point-wo">
          <text class="point-card-num num">{{tournamentDisplay.walkover}}</text>
          <text class="point-card-label">弃</text>
        </view>
      </view>
      <view wx:if="{{tournamentDisplay.pointsMode === 'placement'}}" class="points-placement">
        <view class="placement-row" wx:for="{{tournamentDisplay.placementRows}}" wx:key="label">
          <text class="placement-label">{{item.label}}</text>
          <text class="placement-divider"></text>
          <text class="placement-num num">{{item.value}}</text>
        </view>
      </view>
    </view>

    <!-- REGISTRATIONS -->
    <view class="td-section anim-stage-rise anim-delay-3">
      <view class="td-section-head">
        <text class="tape">参赛人员 · ROSTER</text>
        <text class="td-section-count num">{{registrations.length}}</text>
      </view>
      <view wx:if="{{registrations.length === 0}}" class="td-empty">
        <text>暂无报名</text>
      </view>
      <view wx:else class="roster-grid">
        <view class="roster-card {{item.displayStatus}}" wx:for="{{registrations}}" wx:key="_id">
          <view class="roster-seed">
            <text class="num">{{item.seed}}</text>
          </view>
          <text class="roster-name singles" wx:if="{{tournament.type === 'singles'}}">{{item.playerName}}</text>
          <view wx:if="{{tournament.type === 'doubles'}}" class="roster-doubles">
            <text class="roster-name">{{item.teamName || item.playerName}}</text>
            <view class="roster-doubles-row">
              <text class="roster-detail">{{item.playerName}}</text>
              <text class="roster-detail-sep">/</text>
              <text class="roster-detail">{{item.partnerName}}</text>
            </view>
          </view>
          <view class="roster-status">{{item.displayStatusText}}</view>
        </view>
      </view>
    </view>

    <!-- SCHEDULE -->
    <view class="td-section anim-stage-rise anim-delay-4">
      <view class="td-section-head">
        <text class="tape">赛程 · SCHEDULE</text>
      </view>
      <view wx:if="{{scheduleCourts.length === 0}}" class="td-empty">
        <text>暂无排程</text>
      </view>
      <scroll-view wx:else scroll-x class="schedule-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="schedule-table">
          <view class="schedule-row header">
            <view class="time-col">TIME</view>
            <view wx:for="{{scheduleCourts}}" wx:key="courtId" class="schedule-cell head">
              <text class="court-name">{{item.name}}</text>
            </view>
          </view>
          <view wx:for="{{scheduleRows}}" wx:for-item="row" wx:key="slotKey" class="schedule-row">
            <view class="time-col num">{{row.slotLabel}}</view>
            <view
              wx:for="{{row.cells}}"
              wx:for-item="cell"
              wx:key="courtId"
              class="schedule-cell cell-{{cell.__rowKind}}"
            >
              <block wx:if="{{cell.kind === 'match' && cell.__isDoubles}}">
                <view class="match-line doubles">
                  <view class="team-row">
                    <text class="player">{{cell.__doublesP1}}</text>
                    <text class="slash">/</text>
                    <text class="player">{{cell.__doublesPartner1}}</text>
                  </view>
                  <text class="vs num">VS</text>
                  <view class="team-row">
                    <text class="player">{{cell.__doublesP2}}</text>
                    <text class="slash">/</text>
                    <text class="player">{{cell.__doublesPartner2}}</text>
                  </view>
                </view>
              </block>
              <block wx:elif="{{cell.kind === 'match'}}">
                <view class="match-line">
                  <text class="player">{{cell.__player1Label}}</text>
                  <text class="vs num">VS</text>
                  <text class="player">{{cell.__player2Label}}</text>
                </view>
              </block>
              <block wx:elif="{{cell.kind === 'freePlay'}}">
                <view class="free-line">
                  <text class="free-title">自由拉球</text>
                </view>
              </block>
              <block wx:else>
                <text class="empty-cell">—</text>
              </block>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- DELETE -->
    <view wx:if="{{isAdmin}}" class="td-danger">
      <view class="delete-btn tap-scale" bindtap="onDelete">
        <text class="delete-label">删除赛事</text>
        <text class="delete-meta">不可恢复</text>
      </view>
    </view>

  </block>
</view>

<view wx:if="{{tournament}}" class="td-footer">
  <block wx:if="{{tournament.status === 'draft' && isAdmin}}">
    <view class="footer-cta cta-lime full" bindtap="onResumeDraft">
      <text>继续创建</text>
    </view>
  </block>
  <block wx:else>
    <view wx:if="{{isAdmin}}" class="footer-cta cta-secondary" bindtap="onEdit">编辑</view>
    <view class="footer-cta cta-lime flex-1" bindtap="onEnterScore">录入成绩</view>
  </block>
</view>
