<view class="td-page">

  <view wx:if="{{loading}}" class="td-loading">
    <skeleton-loader rows="{{8}}" />
  </view>

  <block wx:elif="{{tournament}}">

    <!-- PHASE -->
    <view class="td-section phase-strip anim-stage-rise">
      <view class="phase-steps">
        <view class="phase-step {{item.active ? 'active' : ''}} {{item.done ? 'done' : ''}}" wx:for="{{phaseSteps}}" wx:key="key">
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- HERO -->
    <view class="td-hero anim-stage-rise">
      <view class="hero-tapes">
        <text class="tape tape-stamped">TOURNAMENT</text>
        <text class="tape tape-ghost">{{tournamentDisplay.typeText}}</text>
        <text class="td-status status-{{tournamentDisplay.statusKind}}">{{tournamentDisplay.statusLabel}}</text>
      </view>
      <text class="hero-title">{{tournament.name}}</text>
      <view class="hero-meta">
        <view class="hero-meta-block">
          <text class="hero-meta-label">赛季</text>
          <text class="hero-meta-val">{{tournamentDisplay.seasonText}}</text>
        </view>
        <view class="hero-meta-block">
          <text class="hero-meta-label">比赛时间</text>
          <text class="hero-meta-val">{{tournamentDisplay.matchTimeText}}</text>
        </view>
        <view class="hero-meta-block">
          <text class="hero-meta-label">地点</text>
          <text class="hero-meta-val">{{tournamentDisplay.locationText}}</text>
        </view>
        <view class="hero-meta-block">
          <text class="hero-meta-label">报名截止</text>
          <text class="hero-meta-val">{{tournamentDisplay.registrationDeadlineText}}</text>
        </view>
        <view class="hero-meta-block">
          <text class="hero-meta-label">退赛截止</text>
          <text class="hero-meta-val">{{tournamentDisplay.withdrawDeadlineText}}</text>
        </view>
        <view class="hero-meta-block hero-meta-wide hero-meta-court-time">
          <text class="hero-meta-label">场地时间</text>
          <text class="hero-meta-val hero-meta-val-wrap">{{tournamentDisplay.courtTimeText}}</text>
        </view>
      </view>
      <view wx:if="{{tournament.description}}" class="hero-desc">
        <text>{{tournament.description}}</text>
      </view>
    </view>

    <!-- REGISTRATIONS -->
    <view id="registration-section" wx:if="{{showRegistrationModule || activeRegistrationCount > 0 || showScheduleSection || showResultsSection}}" class="td-section anim-stage-rise anim-delay-3">
      <view class="td-section-head">
        <text class="tape">参赛人员 · ROSTER</text>
        <text class="td-section-count num">{{activeRegistrationCount}}</text>
      </view>
      <view wx:if="{{activeRegistrationCount === 0}}" class="td-empty">
        <text>暂无报名</text>
      </view>
      <view wx:else class="roster-grid">
        <view class="roster-card {{item.displayStatus}}" wx:for="{{registrations}}" wx:key="_id">
          <view class="roster-seed">
            <text class="num">{{item.seed}}</text>
          </view>
          <view class="roster-avatar-wrap">
            <image wx:if="{{item.avatarUrl}}" class="roster-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
            <view wx:else class="roster-avatar roster-avatar-fallback">
              <text class="roster-avatar-initial">{{item.playerInitial}}</text>
            </view>
          </view>
          <text class="roster-name singles">{{item.playerName}}</text>
        </view>
      </view>
      <view wx:if="{{showRegistrationModule && phase === 'pending_schedule'}}" class="next-stage-copy">
        <text>报名已截止，管理员正在安排对局。</text>
        <text wx:if="{{withdrawDeadlineLabel}}">可退赛至 {{withdrawDeadlineLabel}}</text>
      </view>
    </view>

    <!-- SCHEDULE -->
    <view wx:if="{{showScheduleSection}}" class="td-section anim-stage-rise anim-delay-4">
      <view class="td-section-head">
        <text class="tape">赛程 · SCHEDULE</text>
      </view>
      <view wx:if="{{scheduleCourts.length === 0}}" class="td-empty">
        <text>暂无排程</text>
      </view>
      <scroll-view wx:else scroll-x class="schedule-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="schedule-table" style="grid-template-columns: 96rpx repeat({{scheduleCourts.length}}, minmax(240rpx, max-content));">
          <!-- Header · TIME label + court cells -->
          <view class="time-col head">TIME</view>
          <view wx:for="{{scheduleCourts}}" wx:key="courtId" class="schedule-cell head">
            <text class="court-name">{{item.name}}</text>
          </view>
          <!-- Data · flat under grid -->
          <block wx:for="{{scheduleRows}}" wx:for-item="row" wx:key="slotKey">
            <view class="time-col num">{{row.slotLabel}}</view>
            <view
              wx:for="{{row.cells}}"
              wx:for-item="cell"
              wx:key="courtId"
              class="schedule-cell cell-{{cell.__rowKind}}"
            >
              <block wx:if="{{cell.kind === 'match' && cell.__isDoubles}}">
                <view class="match-line doubles">
                  <view class="team-row">
                    <text class="player">{{cell.__doublesP1}}</text>
                    <text class="slash">/</text>
                    <text class="player">{{cell.__doublesPartner1}}</text>
                  </view>
                  <text class="vs num">VS</text>
                  <view class="team-row">
                    <text class="player">{{cell.__doublesP2}}</text>
                    <text class="slash">/</text>
                    <text class="player">{{cell.__doublesPartner2}}</text>
                  </view>
                </view>
              </block>
              <block wx:elif="{{cell.kind === 'match'}}">
                <view class="match-line">
                  <text class="player">{{cell.__player1Label}}</text>
                  <text class="vs num">VS</text>
                  <text class="player">{{cell.__player2Label}}</text>
                </view>
              </block>
              <block wx:elif="{{cell.kind === 'freePlay'}}">
                <view class="free-line">
                  <text class="free-title">自由拉球</text>
                </view>
              </block>
              <block wx:else>
                <text class="empty-cell">—</text>
              </block>
            </view>
          </block>
        </view>
      </scroll-view>
    </view>

    <!-- POINTS RULES -->
    <view class="td-section anim-stage-rise anim-delay-5">
      <view class="td-section-head">
        <text class="tape">积分规则 · POINTS</text>
      </view>
      <view wx:if="{{tournamentDisplay.pointsMode === 'winLoss'}}" class="points-row">
        <view class="point-card point-win">
          <text class="point-card-num num">{{tournamentDisplay.win}}</text>
          <text class="point-card-label">胜</text>
        </view>
        <view class="point-card point-loss">
          <text class="point-card-num num">{{tournamentDisplay.loss}}</text>
          <text class="point-card-label">负</text>
        </view>
        <view wx:if="{{tournamentDisplay.walkover !== undefined}}" class="point-card point-wo">
          <text class="point-card-num num">{{tournamentDisplay.walkover}}</text>
          <text class="point-card-label">弃</text>
        </view>
      </view>
      <view wx:if="{{tournamentDisplay.pointsMode === 'placement'}}" class="points-placement">
        <view class="placement-row" wx:for="{{tournamentDisplay.placementRows}}" wx:key="label">
          <text class="placement-label">{{item.label}}</text>
          <text class="placement-divider"></text>
          <text class="placement-num num">{{item.value}}</text>
        </view>
      </view>
    </view>

    <!-- RESULTS -->
    <view wx:if="{{showResultsSection && resultDisplay.visible}}" class="td-section result-section anim-stage-rise anim-delay-6">
      <view class="td-section-head">
        <text class="tape">赛果 · RESULTS</text>
        <text class="td-section-count num">{{resultDisplay.completedText}}</text>
      </view>
      <view wx:if="{{resultDisplay.standings.length > 0}}" class="result-standings">
        <view class="result-standing-head">
          <text class="result-standing-member">会员</text>
          <text class="result-standing-record">胜负</text>
          <text class="result-standing-points">单打</text>
          <text class="result-standing-points">双打</text>
        </view>
        <view class="result-standing-row" wx:for="{{resultDisplay.standings}}" wx:key="standingKey">
          <view class="result-standing-member">
            <text class="result-rank num">{{item.rank}}</text>
            <image wx:if="{{item.avatarUrl}}" class="result-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
            <view wx:else class="result-avatar result-avatar-fallback">
              <text class="result-avatar-initial">{{item.playerInitial}}</text>
            </view>
            <text class="result-member-name">{{item.memberName}}</text>
          </view>
          <text class="result-standing-record num">{{item.recordText}}</text>
          <text class="result-standing-points num">{{item.singlesPointsText}}</text>
          <text class="result-standing-points num">{{item.doublesPointsText}}</text>
        </view>
      </view>
      <view class="result-groups">
        <view class="result-group" wx:for="{{resultDisplay.groups}}" wx:for-item="group" wx:key="round">
          <text class="result-group-label">{{group.label}}</text>
          <view class="result-match" wx:for="{{group.matches}}" wx:for-item="match" wx:key="matchId">
            <view class="result-match-main">
              <text class="result-side">{{match.p1Label}}</text>
              <text class="result-score num">{{match.scoreText || '—'}}</text>
              <text class="result-side result-side-right">{{match.p2Label}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- DELETE -->
    <view wx:if="{{isAdmin}}" class="td-danger">
      <view class="delete-btn tap-scale" bindtap="onDelete">
        <text class="delete-label">删除赛事</text>
        <text class="delete-meta">不可恢复</text>
      </view>
    </view>

  </block>
</view>

<view wx:if="{{tournament}}" class="td-footer">
  <block wx:for="{{footerActions}}" wx:key="key">
    <button wx:if="{{item.key === 'share'}}" open-type="share" class="footer-cta {{item.className}}">{{item.label}}</button>
    <view wx:elif="{{item.key === 'resumeDraft'}}" class="footer-cta {{item.className}}" bindtap="onResumeDraft">{{item.label}}</view>
    <view wx:elif="{{item.key === 'edit'}}" class="footer-cta {{item.className}}" bindtap="onEdit">{{item.label}}</view>
    <view wx:elif="{{item.key === 'arrangeSchedule'}}" class="footer-cta {{item.className}}" bindtap="onArrangeSchedule">{{item.label}}</view>
    <view wx:elif="{{item.key === 'editSchedule'}}" class="footer-cta {{item.className}}" bindtap="onEditSchedule">{{item.label}}</view>
    <view wx:elif="{{item.key === 'enterScore'}}" class="footer-cta {{item.className}} {{canOpenScore ? '' : 'cta-disabled'}}" bindtap="onEnterScore">{{item.label}}</view>
    <view wx:elif="{{item.key === 'adjustResults'}}" class="footer-cta {{item.className}}" bindtap="onAdjustResults">{{item.label}}</view>
    <view wx:elif="{{item.key === 'registerSelf' && selfRegistrationSupported}}" class="footer-cta {{item.className}}" bindtap="onRegisterSelf">{{item.label}}</view>
    <view wx:elif="{{item.key === 'withdrawSelf'}}" class="footer-cta {{item.className}}" bindtap="onWithdrawSelf">{{item.label}}</view>
  </block>
</view>
