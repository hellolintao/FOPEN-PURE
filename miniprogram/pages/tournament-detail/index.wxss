.td-page {
  padding: var(--space-5) var(--space-5) 200rpx;
  background: var(--color-bg);
  min-height: 100vh;
}

.td-loading {
  padding: var(--space-7) 0;
}

/* ============================================================
 * HERO
 * ============================================================ */
.td-hero {
  margin-bottom: var(--space-7);
}

.hero-tapes {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  flex-wrap: wrap;
  margin-bottom: var(--space-4);
}

.hero-title {
  display: block;
  font-size: 60rpx;
  font-weight: 900;
  color: var(--color-ink);
  line-height: 1;
  letter-spacing: -0.01em;
  margin-bottom: var(--space-5);
}

.hero-meta {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-3);
  padding: var(--space-4) 0;
  border-top: 2rpx solid var(--color-ink);
  border-bottom: 2rpx solid var(--color-ink);
}

.hero-meta-block {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.hero-meta-label {
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-muted);
}

.hero-meta-val {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-ink);
  letter-spacing: 0.01em;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hero-desc {
  margin-top: var(--space-4);
  font-size: var(--font-body-size);
  color: var(--color-ink-3);
  line-height: 1.5;
  max-width: 640rpx;
}

/* ============================================================
 * SECTION
 * ============================================================ */
.td-section {
  margin-bottom: var(--space-7);
}

.td-section-head {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.td-section-count {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-ink);
  margin-left: auto;
}

/* ============================================================
 * CONFIG
 * ============================================================ */
.config-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-3);
  padding: var(--space-5);
  background: var(--color-bg-3);
  border-radius: var(--radius-md);
}

.config-grid .stat-block {
  align-items: flex-start;
}

.config-seed {
  margin-top: var(--space-4);
  padding: var(--space-4) var(--space-5);
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-md);
}

.config-seed-label {
  display: block;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.14em;
  color: var(--color-muted);
  text-transform: uppercase;
  margin-bottom: var(--space-2);
}

.config-seed-value {
  display: block;
  font-size: var(--font-body-size);
  font-weight: 700;
  color: var(--color-ink);
  line-height: 1.4;
}

/* ============================================================
 * POINTS RULES
 * ============================================================ */
.points-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-3);
}

.point-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-2);
  padding: var(--space-5);
  border-radius: var(--radius-md);
  background: var(--color-bg-3);
}

.point-card-num {
  font-size: 72rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: -0.03em;
  color: var(--color-ink);
}

.point-card-label {
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-muted);
}

.point-win { background: var(--color-lime); }
.point-win .point-card-num { color: var(--color-ink); }
.point-win .point-card-label { color: var(--color-ink-3); }

.point-loss { background: var(--color-ink); }
.point-loss .point-card-num { color: var(--color-bg); }
.point-loss .point-card-label { color: var(--color-muted-2); }

.point-wo { background: var(--color-bg-3); }

.points-placement {
  display: flex;
  flex-direction: column;
}

.placement-row {
  display: grid;
  grid-template-columns: 120rpx 1fr 120rpx;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-4) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.placement-row:last-child { border-bottom: none; }

.placement-label {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-ink);
  letter-spacing: 0.02em;
}

.placement-divider {
  height: 2rpx;
  background: var(--color-bg-3);
  width: 100%;
}

.placement-num {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--color-ink);
  text-align: right;
  letter-spacing: -0.02em;
}

/* ============================================================
 * ROSTER (registrations)
 * ============================================================ */
.roster-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-3);
}

.roster-card {
  position: relative;
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-md);
  padding: var(--space-6) var(--space-3) var(--space-3);
  text-align: center;
  min-height: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  box-shadow: 4rpx 4rpx 0 var(--color-ink);
}

.roster-card.withdrew {
  border-color: var(--color-border-strong);
  box-shadow: 4rpx 4rpx 0 var(--color-border-strong);
  opacity: 0.7;
}

.roster-card.confirmed {
  background: var(--color-lime-wash);
}

.roster-seed {
  position: absolute;
  top: -22rpx;
  left: 50%;
  transform: translateX(-50%);
  min-width: 56rpx;
  height: 44rpx;
  padding: 0 12rpx;
  background: var(--color-ink);
  color: var(--color-bg);
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 0.04em;
}

.roster-name {
  display: block;
  font-size: 26rpx;
  font-weight: 800;
  color: var(--color-ink);
  letter-spacing: 0.01em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.roster-name.singles { font-size: 30rpx; margin-top: 8rpx; }

.roster-doubles {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  width: 100%;
  margin-top: 8rpx;
}

.roster-doubles-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.roster-detail {
  font-size: 20rpx;
  color: var(--color-muted);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 90rpx;
}

.roster-detail-sep { color: var(--color-muted-2); font-size: 20rpx; }

.roster-status {
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-muted);
}

.roster-card.confirmed .roster-status { color: var(--color-ink); }
.roster-card.withdrew .roster-status { color: var(--color-muted-2); }

/* ============================================================
 * SCHEDULE (scroll-x table)
 * ============================================================ */
.schedule-scroll {
  width: 100%;
}

.schedule-table {
  display: flex;
  flex-direction: column;
  min-width: 920rpx;
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--color-bg);
}

.schedule-row {
  display: flex;
  min-height: 104rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.schedule-row:last-child { border-bottom: 0; }

.schedule-row.header {
  min-height: 64rpx;
  background: var(--color-ink);
}

.schedule-row.header .time-col {
  color: var(--color-bg);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.schedule-row .time-col {
  flex: 0 0 116rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
  border-right: 1rpx solid var(--color-border);
  color: var(--color-muted);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.schedule-row.header .time-col { border-right-color: var(--color-ink-2); }

.schedule-cell {
  flex: 0 0 240rpx;
  min-width: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
  border-right: 1rpx solid var(--color-border);
  background: var(--color-bg);
  box-sizing: border-box;
}

.schedule-cell:last-child { border-right: 0; }

.schedule-cell.head {
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 12rpx;
  background: var(--color-ink);
}

.schedule-cell.head .court-name {
  font-size: 22rpx;
  font-weight: 800;
  color: var(--color-bg);
  letter-spacing: 0.04em;
}

/* row tint by cell kind */
.schedule-cell.cell-regularRound { background: var(--color-lime-wash); }
.schedule-cell.cell-bracket { background: var(--color-bg-2); }
.schedule-cell.cell-extra { background: var(--color-bg-3); }
.schedule-cell.cell-freePlay { background: var(--color-bg-3); }
.schedule-cell.cell-unavailable { background: var(--color-bg-3); color: var(--color-muted-2); }

.schedule-cell .match-line { width: 100%; display: flex; align-items: center; justify-content: center; gap: 8rpx; }
.schedule-cell .match-line.doubles { flex-direction: column; gap: 4rpx; }
.schedule-cell .match-line.doubles .team-row { display: flex; align-items: center; gap: 6rpx; justify-content: center; }
.schedule-cell .match-line.doubles .slash { color: var(--color-muted-2); font-size: 22rpx; }
.schedule-cell .match-line.doubles .vs { font-size: 18rpx; }
.schedule-cell .match-line.doubles .player { max-width: 88rpx; }

.schedule-cell .player {
  max-width: 92rpx;
  padding: 6rpx 8rpx;
  border-radius: 6rpx;
  background: var(--color-bg);
  border: 1rpx solid var(--color-border);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-ink);
  text-align: center;
}

.schedule-cell .vs {
  color: var(--color-muted-2);
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 0.16em;
}

.schedule-cell .free-line { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.schedule-cell .free-title { font-weight: 700; font-size: 22rpx; color: var(--color-ink-3); letter-spacing: 0.04em; }
.schedule-cell .empty-cell { color: var(--color-muted-2); font-size: 22rpx; }

/* ============================================================
 * EMPTY
 * ============================================================ */
.td-empty {
  padding: var(--space-7) 0;
  text-align: center;
  font-size: var(--font-body-size);
  color: var(--color-muted);
}

/* ============================================================
 * DANGER · DELETE
 * ============================================================ */
.td-danger {
  margin-top: var(--space-9);
}

.delete-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-5) var(--space-6);
  border: 2rpx solid var(--color-danger);
  background: var(--color-bg);
  border-radius: var(--radius-md);
}

.delete-label {
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 0.04em;
  color: var(--color-danger);
}

.delete-meta {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: var(--color-muted);
  text-transform: uppercase;
}

/* ============================================================
 * FOOTER BAR
 * ============================================================ */
.td-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-5) calc(var(--space-3) + env(safe-area-inset-bottom));
  background: var(--color-bg);
  border-top: 2rpx solid var(--color-ink);
  z-index: 50;
}

.footer-cta {
  flex: 1;
  min-height: 88rpx;
  padding: 0 var(--space-5);
  font-size: 30rpx;
  letter-spacing: 0.04em;
  font-weight: 800;
}

.footer-cta.full { flex: 1; }
