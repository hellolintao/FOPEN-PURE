.td-page {
  padding: var(--space-5) var(--space-5) 200rpx;
  background: var(--color-bg);
  min-height: 100vh;
}

.td-loading {
  padding: var(--space-7) 0;
}

/* ============================================================
 * PHASE
 * ============================================================ */
.phase-strip {
  margin-bottom: var(--space-5);
}

.phase-steps {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--space-2);
  border-top: 2rpx solid var(--color-ink);
  border-bottom: 2rpx solid var(--color-ink);
  padding: var(--space-2) 0;
}

.phase-step {
  min-width: 0;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-bg);
  color: var(--color-muted);
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 0.08em;
}

.phase-step.done {
  background: var(--color-bg-2);
  color: var(--color-ink-3);
  border-color: var(--color-border-strong);
}

.phase-step.active {
  background: var(--color-lime);
  color: var(--color-ink);
  border-color: var(--color-ink);
}

/* ============================================================
 * HERO
 * ============================================================ */
.td-hero {
  margin-bottom: var(--space-7);
}

.hero-tapes {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  flex-wrap: wrap;
  margin-bottom: var(--space-4);
}

.td-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: var(--radius-sm);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.08em;
}

.td-status.status-draft,
.td-status.status-upcoming,
.td-status.status-pendingSchedule,
.td-status.status-scheduleDraft {
  background: var(--color-bg-3);
  color: var(--color-ink-3);
}

.td-status.status-registration,
.td-status.status-ongoing {
  background: var(--color-lime);
  color: var(--color-ink);
}

.td-status.status-ended {
  background: var(--color-bg-3);
  color: var(--color-muted);
}

.td-status.status-completed,
.td-status.status-settled {
  background: var(--color-ink);
  color: var(--color-bg);
}

.td-status.status-cancelled,
.td-status.status-unknown {
  background: var(--color-bg-3);
  color: var(--color-muted);
}

.hero-title {
  display: block;
  font-size: 60rpx;
  font-weight: 900;
  color: var(--color-ink);
  line-height: 1;
  letter-spacing: -0.01em;
  margin-bottom: var(--space-5);
}

.hero-meta {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-3);
  padding: var(--space-4) 0;
  border-top: 2rpx solid var(--color-ink);
  border-bottom: 2rpx solid var(--color-ink);
}

.hero-meta-block {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.hero-meta-status,
.hero-meta-wide {
  grid-column: 1 / -1;
}

.hero-meta-court-time {
  padding-top: var(--space-2);
  border-top: 1rpx solid var(--color-border);
}

.hero-meta-label {
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-muted);
}

.hero-meta-val {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-ink);
  letter-spacing: 0.01em;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hero-meta-val-wrap {
  overflow: visible;
  white-space: normal;
  text-overflow: clip;
  line-height: 1.35;
  word-break: break-all;
}

.hero-desc {
  margin-top: var(--space-4);
  font-size: var(--font-body-size);
  color: var(--color-ink-3);
  line-height: 1.5;
  max-width: 640rpx;
}

/* ============================================================
 * SECTION
 * ============================================================ */
.td-section {
  margin-bottom: var(--space-7);
}

.td-section-head {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.td-section-count {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-ink);
  margin-left: auto;
}

/* ============================================================
 * RESULTS
 * ============================================================ */
.result-section .td-section-count {
  max-width: 320rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 22rpx;
  color: var(--color-muted);
}

.result-standings {
  overflow: hidden;
  margin-bottom: var(--space-5);
  border-top: 4rpx solid var(--color-ink);
  border-bottom: 4rpx solid var(--color-ink);
}

.result-standing-head,
.result-standing-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 112rpx 88rpx 88rpx;
  align-items: center;
  gap: var(--space-2);
  min-width: 0;
}

.result-standing-head {
  min-height: 56rpx;
  padding: 0 var(--space-2);
  background: var(--color-bg-2);
  color: var(--color-muted);
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 0.12em;
}

.result-standing-row {
  min-height: 96rpx;
  padding: 0 var(--space-2);
  border-top: 1rpx solid var(--color-border);
  background: var(--color-bg);
}

.result-standing-member {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  min-width: 0;
}

.result-rank {
  width: 32rpx;
  flex: 0 0 32rpx;
  font-size: 20rpx;
  font-weight: 900;
  color: var(--color-muted);
  text-align: center;
}

.result-avatar {
  width: 52rpx;
  height: 52rpx;
  flex: 0 0 52rpx;
  display: block;
  overflow: hidden;
  border: 2rpx solid var(--color-ink);
  border-radius: 50%;
  background: var(--color-bg-3);
}

.result-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-lime-wash);
}

.result-avatar-initial {
  font-size: 22rpx;
  font-weight: 900;
  color: var(--color-ink);
  line-height: 1;
}

.result-member-name {
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 26rpx;
  font-weight: 900;
  color: var(--color-ink);
  letter-spacing: 0;
}

.result-standing-record,
.result-standing-points {
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  text-align: center;
  color: var(--color-ink);
}

.result-standing-record {
  font-size: 22rpx;
  font-weight: 800;
}

.result-standing-points {
  font-size: 26rpx;
  font-weight: 900;
}

.result-groups {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.result-group {
  min-width: 0;
  border-top: 2rpx solid var(--color-ink);
}

.result-group-label {
  display: block;
  padding: var(--space-2) 0;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.16em;
  color: var(--color-muted);
}

.result-match {
  min-width: 0;
  padding: var(--space-3) 0;
  border-top: 1rpx solid var(--color-border);
}

.result-match-main {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  align-items: center;
  gap: var(--space-3);
  min-width: 0;
}

.result-side {
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 0;
  color: var(--color-ink);
}

.result-side-right {
  text-align: right;
}

.result-score {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 96rpx;
  max-width: 180rpx;
  height: 44rpx;
  padding: 0 14rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-sm);
  background: var(--color-lime);
  color: var(--color-ink);
  font-size: 24rpx;
  font-weight: 900;
}

/* ============================================================
 * POINTS RULES
 * ============================================================ */
.points-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-3);
}

.point-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-2);
  padding: var(--space-5);
  border-radius: var(--radius-md);
  background: var(--color-bg-3);
}

.point-card-num {
  font-size: 72rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: -0.03em;
  color: var(--color-ink);
}

.point-card-label {
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-muted);
}

.point-win { background: var(--color-lime); }
.point-win .point-card-num { color: var(--color-ink); }
.point-win .point-card-label { color: var(--color-ink-3); }

.point-loss { background: var(--color-ink); }
.point-loss .point-card-num { color: var(--color-bg); }
.point-loss .point-card-label { color: var(--color-muted-2); }

.point-wo { background: var(--color-bg-3); }

.points-placement {
  display: flex;
  flex-direction: column;
}

.placement-row {
  display: grid;
  grid-template-columns: 120rpx 1fr 120rpx;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-4) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.placement-row:last-child { border-bottom: none; }

.placement-label {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-ink);
  letter-spacing: 0.02em;
}

.placement-divider {
  height: 2rpx;
  background: var(--color-bg-3);
  width: 100%;
}

.placement-num {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--color-ink);
  text-align: right;
  letter-spacing: -0.02em;
}

/* ============================================================
 * ROSTER (registrations)
 * ============================================================ */
.roster-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-3);
}

.roster-card {
  position: relative;
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-md);
  padding: 56rpx var(--space-3) var(--space-4);
  text-align: center;
  min-height: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-2);
  box-shadow: 4rpx 4rpx 0 var(--color-ink);
}

.roster-card.withdrew {
  border-color: var(--color-border-strong);
  box-shadow: 4rpx 4rpx 0 var(--color-border-strong);
  opacity: 0.7;
}

.roster-seed {
  position: absolute;
  top: -22rpx;
  left: 50%;
  transform: translateX(-50%);
  min-width: 56rpx;
  height: 44rpx;
  padding: 0 12rpx;
  background: var(--color-ink);
  color: var(--color-bg);
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 0.04em;
}

/* ============================================================
 * 头像
 * ============================================================ */
.roster-avatar-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--color-bg-3);
  border: 2rpx solid var(--color-ink);
  box-sizing: border-box;
  flex: 0 0 96rpx;
}

.roster-avatar {
  width: 100%;
  height: 100%;
  display: block;
}

.roster-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-lime-wash);
}

.roster-avatar-initial {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--color-ink);
  font-family: var(--font-family-display);
  letter-spacing: 0;
  line-height: 1;
}

/* 双打：两个头像横向叠放 */
.roster-doubles-avatars {
  display: inline-flex;
  align-items: center;
}

.roster-doubles-avatars .roster-avatar-wrap.stacked {
  width: 84rpx;
  height: 84rpx;
  flex: 0 0 84rpx;
}

.roster-doubles-avatars .roster-avatar-wrap.overlap {
  margin-left: -28rpx;
  border-color: var(--color-ink);
}

/* 文本 */
.roster-name {
  display: block;
  font-size: 26rpx;
  font-weight: 800;
  color: var(--color-ink);
  letter-spacing: 0.01em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.roster-name.singles {
  font-size: 28rpx;
}

.next-stage-copy {
  margin-top: var(--space-4);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding-top: var(--space-4);
  border-top: 1rpx solid var(--color-border);
  color: var(--color-ink-3);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.roster-doubles {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  width: 100%;
}

.roster-doubles-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.roster-detail {
  font-size: 20rpx;
  color: var(--color-muted);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 90rpx;
}

.roster-detail-sep { color: var(--color-muted-2); font-size: 20rpx; }

/* ============================================================
 * SCHEDULE (scroll-x table)
 * ============================================================ */
.schedule-scroll {
  width: 100%;
}

.schedule-table {
  display: grid;
  /* grid-template-columns inline */
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--color-bg);
  width: max-content;
  min-width: 100%;
}

.time-col,
.schedule-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-right: 1rpx solid var(--color-border);
  border-bottom: 1rpx solid var(--color-border);
  min-height: 104rpx;
  background: var(--color-bg);
}

.time-col {
  background: var(--color-bg-2);
  font-family: var(--font-family-num);
  font-size: 24rpx;
  font-weight: 800;
  color: var(--color-ink);
  padding: 8rpx 4rpx;
  letter-spacing: -0.02em;
}

.schedule-cell {
  position: relative;
  padding: 12rpx 8rpx;
}

.time-col.head,
.schedule-cell.head {
  min-height: 64rpx;
  background: var(--color-ink);
  color: var(--color-bg);
  border-right-color: var(--color-ink-2);
  border-bottom-color: var(--color-ink);
}

.time-col.head {
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  font-family: inherit;
}

.schedule-cell.head {
  flex-direction: column;
  gap: 4rpx;
  padding: 8rpx 12rpx;
}

.schedule-cell.head .court-name {
  font-size: 22rpx;
  font-weight: 800;
  color: var(--color-bg);
  letter-spacing: 0.04em;
}

/* row tint by cell kind */
.schedule-cell.cell-regularRound { background: var(--color-lime-wash); }
.schedule-cell.cell-bracket { background: var(--color-bg-2); }
.schedule-cell.cell-extra { background: var(--color-lime-wash); }
.schedule-cell.cell-freePlay { background: var(--color-warn-wash); }
.schedule-cell.cell-unavailable { background: var(--color-bg-3); color: var(--color-muted-2); }

.schedule-cell.cell-mine {
  background: var(--color-lime-soft);
  box-shadow: inset 0 0 0 4rpx var(--color-lime);
}

.schedule-cell .match-line { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; }
.schedule-cell .match-line.doubles { gap: 4rpx; }
.schedule-cell .match-line.doubles .team-row { display: flex; align-items: center; gap: 6rpx; justify-content: center; }
.schedule-cell .match-line.doubles .slash { color: var(--color-muted-2); font-size: 18rpx; }
.schedule-cell .match-line .vs { font-size: 16rpx; }
.schedule-cell .match-line.doubles .player { max-width: 200rpx; padding: 2rpx 8rpx; }

.schedule-cell .player {
  max-width: 320rpx;
  padding: 4rpx 10rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
  font-weight: 800;
  color: var(--color-ink);
  text-align: center;
  letter-spacing: 0;
  line-height: 1.15;
}

.schedule-cell.cell-mine .player-mine {
  background: var(--color-lime);
  border-color: var(--color-ink);
}

.schedule-cell .vs {
  color: var(--color-muted-2);
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 0.16em;
}

.schedule-cell .free-line { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.schedule-cell .free-title { font-weight: 700; font-size: 22rpx; color: var(--color-ink-3); letter-spacing: 0.04em; }
.schedule-cell .empty-cell { color: var(--color-muted-2); font-size: 22rpx; }

/* ============================================================
 * EMPTY
 * ============================================================ */
.td-empty {
  padding: var(--space-7) 0;
  text-align: center;
  font-size: var(--font-body-size);
  color: var(--color-muted);
}

/* ============================================================
 * DANGER · DELETE
 * ============================================================ */
.td-danger {
  margin-top: var(--space-9);
}

.delete-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-5) var(--space-6);
  border: 2rpx solid var(--color-danger);
  background: var(--color-bg);
  border-radius: var(--radius-md);
}

.delete-label {
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 0.04em;
  color: var(--color-danger);
}

.delete-meta {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: var(--color-muted);
  text-transform: uppercase;
}

/* ============================================================
 * FOOTER BAR
 * ============================================================ */
.td-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-5) calc(var(--space-3) + env(safe-area-inset-bottom));
  background: var(--color-bg);
  border-top: 2rpx solid var(--color-ink);
  z-index: 50;
}

.footer-cta {
  flex: 1;
  min-height: 88rpx;
  padding: 0 var(--space-5);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 30rpx;
  letter-spacing: 0.04em;
  font-weight: 800;
}

.footer-cta.full { flex: 1; }

.share-cta {
  flex: 0 0 156rpx;
  min-width: 0;
  line-height: 1;
}

.footer-cta.cta-disabled {
  background: var(--color-bg-3);
  color: var(--color-muted);
  border: 2rpx solid var(--color-border);
}
