<view class="manage-page">

  <!-- HEAD -->
  <view class="manage-head anim-stage-rise">
    <view class="head-tapes">
      <text class="tape tape-stamped">ADMIN · 管理后台</text>
    </view>
    <view class="head-titles">
      <text class="head-title-zh">管理</text>
      <text class="head-title-en num">CONTROL</text>
    </view>
  </view>

  <!-- ADMIN GRID -->
  <view class="manage-grid anim-stage-rise anim-delay-1">
    <view class="m-tile tap-scale" bindtap="onSeasonManage">
      <text class="m-tile-num num">01</text>
      <text class="m-tile-text">赛季管理</text>
      <text class="m-tile-arrow num">→</text>
    </view>
    <view class="m-tile tap-scale" bindtap="onTournamentManage">
      <text class="m-tile-num num">02</text>
      <text class="m-tile-text">赛事管理</text>
      <text class="m-tile-arrow num">→</text>
    </view>
    <view class="m-tile tap-scale" bindtap="onMemberManage">
      <text class="m-tile-num num">03</text>
      <text class="m-tile-text">会员管理</text>
      <text class="m-tile-arrow num">→</text>
    </view>
  </view>

  <!-- BRACKETS SECTION -->
  <view class="brackets-section anim-stage-rise anim-delay-2">
    <view class="section-head">
      <text class="tape tape-lime tape-stamped-lime">PENDING · 待录入</text>
      <text wx:if="{{bracketsList.length}}" class="section-count num">{{bracketsList.length}}</text>
    </view>

    <view wx:if="{{loading}}" class="loading-state">
      <skeleton-loader rows="{{4}}" />
    </view>

    <view wx:elif="{{!bracketsList.length}}" class="empty-state">
      <text class="tape">暂无待录入对阵</text>
    </view>

    <view wx:else class="brackets-list">
      <view
        class="bracket-card tap-scale"
        wx:for="{{bracketsList}}" wx:key="_id"
        bindtap="onBracketTap"
        data-tournamentid="{{item.tournamentId}}"
        data-bracketid="{{item._id}}"
        data-round="{{item.round}}"
      >
        <view class="bracket-head">
          <view class="bracket-head-info">
            <text class="bracket-tournament">{{tournamentsMap[item.tournamentId].name || '未知赛事'}}</text>
            <text class="bracket-tip">点击录入比分</text>
          </view>
          <text class="bracket-round-tape num">R{{item.round < 10 ? '0' : ''}}{{item.round}}</text>
        </view>

        <view class="matches-list">
          <view class="match-item" wx:for="{{item.matches}}" wx:key="matchId" wx:for-item="match">
            <text class="match-player">{{match.player1.name || '待定'}}</text>
            <text class="match-vs num">VS</text>
            <text class="match-player">{{match.player2.name || '待定'}}</text>
          </view>
        </view>

        <view class="bracket-foot">
          <text class="bracket-time num">{{item.updateTime || item.createTime}}</text>
          <text class="bracket-cta">录入 →</text>
        </view>
      </view>
    </view>
  </view>
</view>
