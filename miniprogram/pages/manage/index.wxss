.manage-container {
  background: linear-gradient(180deg, #101017 0%, #0d0d14 100%);
  min-height: 100vh;
  color: #FFFFFF;
  padding: 40rpx 0;
}
.manage-title {
  font-size: 44rpx;
  color: #7c3aed;
  text-align: center;
  margin-bottom: 48rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 12rpx rgba(124,58,237,0.3);
}
.manage-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  margin: 0 40rpx;
}
.manage-item {
  background: linear-gradient(135deg, #1a1a2e 0%, #16162a 100%);
  border-radius: 20rpx;
  padding: 40rpx 0;
  text-align: center;
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 500;
  box-shadow: 0 8rpx 32rpx rgba(124,58,237,0.12), inset 0 1rpx 0 rgba(255,255,255,0.05);
  transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s;
}
.manage-item:active {
  background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%);
  color: #FFFFFF;
  transform: scale(0.98);
  box-shadow: 0 12rpx 40rpx rgba(124,58,237,0.3);
}
