.manage-container {
  background: #f7f7f7;
  min-height: 100vh;
  padding: 40rpx;
  box-sizing: border-box;
}

.manage-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.manage-card {
  background: #ffffff;
  border-radius: 8rpx;
  padding: 80rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.manage-card:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.card-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}
