.manage-container {
  background: #101017;
  min-height: 100vh;
  color: #FFFFFF;
  padding: 40rpx 0;
}
.manage-title {
  font-size: 40rpx;
  color: #7c3aed;
  text-align: center;
  margin-bottom: 48rpx;
}
.manage-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  margin: 0 40rpx;
}
.manage-item {
  background: #181828;
  border-radius: 20rpx;
  padding: 40rpx 0;
  text-align: center;
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 500;
  box-shadow: 0 4rpx 24rpx rgba(124,58,237,0.08);
  transition: background 0.2s;
}
.manage-item:active {
  background: #7c3aed;
  color: #FFFFFF;
}
