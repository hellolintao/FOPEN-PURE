.manage-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: var(--space-5) var(--space-5) 160rpx;
}

/* ============================================================
 * HEAD
 * ============================================================ */
.manage-head {
  margin-bottom: var(--space-6);
}

.head-tapes {
  margin-bottom: var(--space-4);
}

.head-titles {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
}

.head-title-zh {
  font-size: 72rpx;
  font-weight: 900;
  color: var(--color-ink);
  line-height: 0.95;
  letter-spacing: -0.01em;
}

.head-title-en {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--color-muted-2);
  letter-spacing: 0.08em;
}

/* ============================================================
 * GRID
 * ============================================================ */
.manage-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  margin-bottom: var(--space-7);
}

.m-tile {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  padding: var(--space-5) var(--space-6);
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-md);
}

.m-tile-num {
  font-size: 24rpx;
  font-weight: 900;
  color: var(--color-muted);
  letter-spacing: 0.04em;
  min-width: 56rpx;
}

.m-tile-text {
  flex: 1;
  font-size: 32rpx;
  font-weight: 900;
  color: var(--color-ink);
  letter-spacing: 0.02em;
}

.m-tile-arrow {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--color-ink);
  line-height: 1;
}

/* ============================================================
 * BRACKETS SECTION
 * ============================================================ */
.brackets-section {
  display: flex;
  flex-direction: column;
}

.section-head {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.section-count {
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-muted);
  margin-left: auto;
}

.loading-state {
  padding: var(--space-5) 0;
}

.empty-state {
  padding: var(--space-7) 0;
  text-align: center;
}

.brackets-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.bracket-card {
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.bracket-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding: var(--space-4) var(--space-5);
  background: var(--color-ink);
  color: var(--color-bg);
}

.bracket-head-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.bracket-tournament {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--color-bg);
  letter-spacing: 0.01em;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.bracket-tip {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--color-muted-2);
}

.bracket-round-tape {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  background: var(--color-lime);
  color: var(--color-ink);
  border-radius: var(--radius-sm);
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 0.04em;
}

.matches-list {
  display: flex;
  flex-direction: column;
}

.match-item {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-5);
  border-bottom: 1rpx solid var(--color-border);
}

.match-item:last-child {
  border-bottom: 0;
}

.match-player {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-ink);
  letter-spacing: 0.01em;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.match-player:first-child { text-align: right; }
.match-player:last-child { text-align: left; }

.match-vs {
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.16em;
  color: var(--color-muted-2);
}

.bracket-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-3) var(--space-5);
  background: var(--color-bg-3);
  border-top: 1rpx solid var(--color-border);
}

.bracket-time {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-muted);
  letter-spacing: 0.04em;
}

.bracket-cta {
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-ink);
}
