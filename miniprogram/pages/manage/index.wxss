.manage-container {
  background: linear-gradient(180deg, #101017 0%, #0d0d14 100%);
  min-height: 100vh;
  color: #fff;
  padding: 60rpx 40rpx;
  box-sizing: border-box;
}

/* 头部 */
.manage-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.manage-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.manage-subtitle {
  display: block;
  font-size: 26rpx;
  color: #888;
}

/* 卡片网格 */
.manage-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.manage-card {
  background: linear-gradient(135deg, #1a1a2e 0%, #16162a 100%);
  border-radius: 24rpx;
  padding: 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  border: 1rpx solid rgba(124,58,237,0.1);
  box-shadow: 0 4rpx 20rpx rgba(124,58,237,0.1);
  transition: all 0.3s ease;
}

.manage-card:active {
  transform: scale(0.96);
  box-shadow: 0 8rpx 32rpx rgba(124,58,237,0.2);
}

.card-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.season-card .card-icon {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.tournament-card .card-icon {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.match-card .card-icon {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.member-card .card-icon {
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  display: block;
}

.card-desc {
  font-size: 22rpx;
  color: #888;
  display: block;
}
