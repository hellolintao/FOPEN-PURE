.tournament-add-player-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f7f7;
}

/* 已报名人员区域 */
.registered-section {
  flex: 1;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  min-height: 200rpx;
}

.section-header {
  padding: 24rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
}

.section-hint {
  font-size: 24rpx;
  color: #999999;
}

.list-wrapper {
  flex: 1;
  overflow: hidden;
}

.registered-list {
  height: 100%;
  padding: 20rpx 0rpx;
}

.empty-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

.registered-item {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
}

.member-avatar-placeholder {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #666666;
  font-size: 26rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.member-name {
  flex: 1;
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.remove-icon {
  font-size: 40rpx;
  color: #999999;
  line-height: 1;
  padding: 0 10rpx;
}

/* 会员列表区域 */
.member-list-section {
  flex: 2;
  background: #f7f7f7;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  margin-top: 20rpx;
}

.search-bar {
  margin: 20rpx 30rpx;
  background: #ffffff;
  border-radius: 8rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  height: 72rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 100%;
}

.clear-btn {
  font-size: 32rpx;
  color: #999999;
  padding: 0 10rpx;
}

.member-list {
  height: 100%;
  padding: 0 00rpx 0rpx;
}

.empty-list {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.loading-text {
  color: #999999;
  font-size: 28rpx;
}

.member-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 8rpx;
  padding: 24rpx 24rpx;
  margin-bottom: 12rpx;
}

.member-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.member-name-text {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-phone {
  color: #999999;
  font-size: 24rpx;
}

.select-badge {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.select-badge.selected {
  background: #333333;
}

.select-icon {
  color: #999999;
  font-size: 32rpx;
  line-height: 1;
  font-weight: bold;
}

.select-badge.selected .select-icon {
  color: #ffffff;
}

/* 底部按钮 */
.footer-actions {
  background: #ffffff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: #333333;
  border-radius: 8rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 400;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  background: #e0e0e0;
  color: #999999;
}
