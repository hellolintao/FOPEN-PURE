.tournament-add-player-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
  padding: var(--space-4);
  box-sizing: border-box;
  gap: var(--space-4);
}

/* ============================================================
 * REGISTERED SECTION (top)
 * ============================================================ */
.registered-section {
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  max-height: 320rpx;
  overflow: hidden;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-3) var(--space-4);
  background: var(--color-ink);
  color: var(--color-bg);
}

.section-title {
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.section-hint {
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: var(--color-muted-2);
  text-transform: uppercase;
}

.list-wrapper {
  flex: 1;
  overflow: hidden;
}

.registered-list {
  height: 100%;
  padding: var(--space-2) var(--space-3);
}

.empty-hint {
  padding: var(--space-5) 0;
  text-align: center;
  color: var(--color-muted);
  font-size: 22rpx;
  font-weight: 700;
}

.registered-item {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: 10rpx 16rpx;
  margin: 4rpx;
  background: var(--color-lime);
  border-radius: var(--radius-pill);
}

.member-avatar-placeholder {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--color-ink);
  color: var(--color-lime);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 900;
}

.registered-item .member-name {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--color-ink);
  letter-spacing: 0.01em;
}

.remove-icon {
  font-size: 24rpx;
  font-weight: 900;
  color: var(--color-ink-3);
  padding: 0 4rpx;
}

/* ============================================================
 * MEMBER LIST SECTION
 * ============================================================ */
.member-list-section {
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  flex: 1;
  overflow: hidden;
}

.search-bar {
  display: flex;
  align-items: center;
  padding: var(--space-3) var(--space-4);
  background: var(--color-bg-3);
  border-bottom: 1rpx solid var(--color-border);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-ink);
  height: 56rpx;
  line-height: 56rpx;
}

.clear-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-ink);
  color: var(--color-bg);
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 900;
}

.member-list {
  flex: 1;
  height: 100%;
}

.empty-list,
.loading {
  padding: var(--space-7) 0;
  text-align: center;
  color: var(--color-muted);
  font-size: var(--font-body-size);
}

.empty-text,
.loading-text {
  font-size: var(--font-body-size);
  font-weight: 700;
}

.member-item {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-4) var(--space-5);
  border-bottom: 1rpx solid var(--color-border);
}

.member-item:last-child { border-bottom: 0; }

.member-item .member-avatar-placeholder {
  width: 72rpx;
  height: 72rpx;
  background: var(--color-bg-3);
  color: var(--color-ink);
  font-size: 32rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-ink);
}

.member-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.member-name-text {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-ink);
  letter-spacing: 0.01em;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.select-badge {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 900;
  color: var(--color-ink);
  flex-shrink: 0;
}

.select-badge.selected {
  background: var(--color-ink);
  color: var(--color-bg);
}

.select-icon {
  line-height: 1;
}

/* ============================================================
 * FOOTER
 * ============================================================ */
.footer-actions {
  flex-shrink: 0;
  padding-top: var(--space-3);
}

.submit-btn {
  width: 100%;
  margin: 0;
  background: var(--color-lime) !important;
  color: var(--color-ink) !important;
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: 0.04em;
  padding: var(--space-5) 0;
  border-radius: var(--radius-pill) !important;
  border: 2rpx solid var(--color-ink);
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn::after { border: none; }

.submit-btn[disabled] {
  background: var(--color-bg-3) !important;
  color: var(--color-muted) !important;
  border-color: var(--color-border) !important;
}

.submit-btn:active:not([disabled]) {
  background: var(--color-lime-strong) !important;
  transform: scale(0.99);
}
