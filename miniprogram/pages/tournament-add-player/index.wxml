<view class="tournament-add-player-container">
  <!-- 已报名人员区域 (占1/3) -->
  <view class="registered-section">
    <view class="section-header">
      <view class="header-title">
        <text class="title-icon">✅</text>
        <text>已报名人员 ({{selectedMembers.length}}人)</text>
      </view>
      <text class="section-subtitle">点击移除</text>
    </view>

    <scroll-view class="registered-list" scroll-y enhanced show-scrollbar="{{false}}">
      <view wx:if="{{selectedMembers.length === 0}}" class="empty-hint">
        <text class="hint-icon">📋</text>
        <text class="hint-text">暂无报名人员</text>
        <text class="hint-desc">从下方列表中选择添加</text>
      </view>

      <view class="registered-item" wx:for="{{selectedMembers}}" wx:key="_id" bindtap="onRemoveMember" data-member="{{item}}">
        <image wx:if="{{item.avatarUrl}}" class="member-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="member-avatar-placeholder">{{item.name.charAt(0) || '会'}}</view>
        <text class="member-name">{{item.name}}</text>
        <view class="remove-badge">
          <text class="remove-icon">✕</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 会员列表区域 (占2/3) -->
  <view class="member-list-section">
    <view class="section-header">
      <text class="header-title">会员列表</text>
    </view>

    <!-- 搜索框 -->
    <view class="search-bar">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索会员姓名或手机号"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        confirm-type="search"
        bindconfirm="onSearch"
      />
      <view class="clear-btn" wx:if="{{searchKeyword}}" bindtap="onClearSearch">✕</view>
    </view>

    <!-- 会员列表 -->
    <scroll-view class="member-list" scroll-y enhanced show-scrollbar="{{false}}">
      <view wx:if="{{memberList.length === 0 && !loading}}" class="empty-list">
        <text class="empty-icon">👤</text>
        <text class="empty-text">{{searchKeyword ? '未找到相关会员' : '暂无会员数据'}}</text>
      </view>

      <view wx:if="{{loading}}" class="loading">
        <text class="loading-text">加载中...</text>
      </view>

      <view class="member-item" wx:for="{{memberList}}" wx:key="_id" bindtap="onSelectMember" data-member="{{item}}">
        <image wx:if="{{item.avatarUrl}}" class="member-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="member-avatar-placeholder">{{item.name.charAt(0) || '会'}}</view>
        <view class="member-info">
          <text class="member-name">{{item.name}}</text>
          <text class="member-phone">{{item.phone || '未填写手机号'}}</text>
        </view>
        <view class="select-badge {{isMemberSelected(item._id) ? 'selected' : ''}}">
          <text class="select-icon">{{isMemberSelected(item._id) ? '✓' : '+'}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 底部按钮 -->
  <view class="footer-actions">
    <button class="submit-btn" bindtap="onSubmit" disabled="{{selectedMembers.length === 0}}">
      <text class="btn-icon">✓</text>
      <text class="btn-text">确认添加 ({{selectedMembers.length}}人)</text>
    </button>
  </view>
</view>
