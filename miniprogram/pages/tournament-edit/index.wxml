<view class="tournament-edit-container">
  <view class="tournament-edit-title">{{isEdit ? '编辑赛事' : '新增赛事'}}</view>
  
  <view class="form-section">
    <!-- 赛事名称 -->
    <view class="form-item">
      <view class="field-label">
        <text class="required">*</text>赛事名称
      </view>
      <input class="dialog-input" placeholder="请输入赛事名称" value="{{tournament.name}}" data-key="name" bindinput="onInput" />
    </view>

    <!-- 所属赛季 -->
    <view class="form-item">
      <view class="field-label">
        <text class="required">*</text>所属赛季
      </view>
      <picker mode="selector" range="{{seasonOptions}}" range-key="label" value="{{seasonIndex}}" bindchange="onPickSeason">
        <view class="dialog-input picker-input">
          <text class="picker-text">{{seasonOptions.length > 0 ? seasonOptions[seasonIndex].label : '选择所属赛季'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 日期选择 -->
    <view class="form-row">
      <view class="form-item flex-1">
        <view class="field-label">
          <text class="required">*</text>开始日期
        </view>
        <picker mode="date" value="{{tournament.startDate}}" start="2000-01-01" end="2100-12-31" bindchange="onPickStart">
          <view class="dialog-input picker-input">
            <text class="picker-text">{{tournament.startDate || '选择日期'}}</text>
            <text class="picker-arrow">📅</text>
          </view>
        </picker>
      </view>
      <view class="form-item flex-1">
        <view class="field-label">
          <text class="required">*</text>结束日期
        </view>
        <picker mode="date" value="{{tournament.endDate}}" start="2000-01-01" end="2100-12-31" bindchange="onPickEnd">
          <view class="dialog-input picker-input">
            <text class="picker-text">{{tournament.endDate || '选择日期'}}</text>
            <text class="picker-arrow">📅</text>
          </view>
        </picker>
      </view>
    </view>

    <!-- 场地名称 -->
    <view class="form-item">
      <view class="field-label">
        <text class="required">*</text>场地名称
      </view>
      <input class="dialog-input" placeholder="请输入场地名称" value="{{tournament.location}}" data-key="location" bindinput="onInput" />
    </view>

    <!-- 类型 -->
    <view class="form-item">
      <view class="field-label">
        <text class="required">*</text>赛事类型
      </view>
      <picker mode="selector" range="{{typeOptions}}" value="{{typeIndex}}" bindchange="onPickType">
        <view class="dialog-input picker-input">
          <text class="picker-text">{{tournament.type || '选择类型'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 描述 -->
    <view class="form-item">
      <view class="field-label">赛事描述</view>
      <textarea class="dialog-textarea" placeholder="请输入赛事描述（选填）" value="{{tournament.description}}" data-key="description" bindinput="onInput" />
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="dialog-actions">
    <button class="dialog-btn cancel" bindtap="onCancel">取消</button>
    <button class="dialog-btn primary" bindtap="onSubmit">{{isEdit ? '保存修改' : '确认新增'}}</button>
  </view>
</view>
