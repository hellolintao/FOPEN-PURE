<view class="wizard">
  <view class="step-bar">
    <view class="step {{step >= 1 ? 'active' : ''}}">
      <text class="step-num">01</text>
      <text class="step-name">基本信息</text>
    </view>
    <view class="step-rule"></view>
    <view class="step {{step >= 2 ? 'active' : ''}}">
      <text class="step-num">02</text>
      <text class="step-name">球员 · 球场</text>
    </view>
    <view class="step-rule"></view>
    <view class="step {{step >= 3 ? 'active' : ''}}">
      <text class="step-num">03</text>
      <text class="step-name">排程</text>
    </view>
  </view>

  <view wx:if="{{step === 1}}" class="step-body">
    <view class="field">
      <text class="label">赛事名称 *</text>
      <input class="input" bindinput="onFieldChange" data-k="name" value="{{form.name}}" placeholder="如：5月例赛" />
    </view>
    <view class="field">
      <text class="label">地点 *</text>
      <input class="input" bindinput="onFieldChange" data-k="location" value="{{form.location}}" />
    </view>
    <view class="field">
      <text class="label">比赛日期 *</text>
      <picker mode="date" bindchange="onFieldChange" data-k="startDate" value="{{form.startDate}}">
        <view class="picker-value">
          <text class="num">{{form.startDate || '选择日期'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>
    <view class="field">
      <text class="label">赛制 *</text>
      <view class="chip-row">
        <text class="chip {{form.format === 'knockout' ? 'active' : ''}}" bindtap="onChipTap" data-k="format" data-v="knockout">单淘汰</text>
        <text class="chip {{form.format === 'regular' ? 'active' : ''}}" bindtap="onChipTap" data-k="format" data-v="regular">常规赛</text>
      </view>
    </view>
    <view class="field">
      <text class="label">类别 *</text>
      <view class="chip-row">
        <text class="chip {{form.type === 'singles' ? 'active' : ''}}" bindtap="onChipTap" data-k="type" data-v="singles">单打</text>
        <text class="chip {{form.type === 'doubles' ? 'active' : ''}}" bindtap="onChipTap" data-k="type" data-v="doubles">双打</text>
        <text class="chip {{form.type === 'mixed' ? 'active' : ''}} {{form.format === 'knockout' ? 'disabled' : ''}}" bindtap="onChipTap" data-k="type" data-v="mixed">混合</text>
      </view>
    </view>
    <view wx:if="{{form.format === 'knockout'}}" class="field">
      <text class="label">最大参赛人数</text>
      <input class="input" type="number" bindinput="onFieldChange" data-k="maxPlayers" value="{{form.maxPlayers}}" />
    </view>

    <view class="field field-points">
      <view class="points-head">
        <text class="label label-strong">{{form.format === 'knockout' ? '积分 · 按名次' : '积分 · 按胜负'}}</text>
        <text class="history-pill tap-scale" bindtap="onUseHistory">使用历史</text>
      </view>
      <view wx:if="{{form.format === 'knockout'}}" class="points-grid">
        <view class="points-row"><text class="points-label">冠军</text><input class="num-input num" type="number" bindinput="onFieldChange" data-k="pointsRules.placement.champion" value="{{pointsRules.placement.champion}}" /></view>
        <view class="points-row"><text class="points-label">亚军</text><input class="num-input num" type="number" bindinput="onFieldChange" data-k="pointsRules.placement.runnerUp" value="{{pointsRules.placement.runnerUp}}" /></view>
        <view class="points-row"><text class="points-label">四强</text><input class="num-input num" type="number" bindinput="onFieldChange" data-k="pointsRules.placement.semifinal" value="{{pointsRules.placement.semifinal}}" /></view>
        <view class="points-row"><text class="points-label">八强</text><input class="num-input num" type="number" bindinput="onFieldChange" data-k="pointsRules.placement.quarterfinal" value="{{pointsRules.placement.quarterfinal}}" /></view>
        <view class="points-row"><text class="points-label">参赛</text><input class="num-input num" type="number" bindinput="onFieldChange" data-k="pointsRules.placement.participation" value="{{pointsRules.placement.participation}}" /></view>
      </view>
      <view wx:else class="points-grid">
        <view class="points-row"><text class="points-label">胜场</text><input class="num-input num" type="number" bindinput="onFieldChange" data-k="pointsRules.winLoss.win" value="{{pointsRules.winLoss.win}}" /></view>
        <view class="points-row"><text class="points-label">负场</text><input class="num-input num" type="number" bindinput="onFieldChange" data-k="pointsRules.winLoss.loss" value="{{pointsRules.winLoss.loss}}" /></view>
      </view>
    </view>

    <view class="field">
      <text class="label">描述</text>
      <textarea class="textarea-2" bindinput="onFieldChange" data-k="description" value="{{form.description}}" placeholder="（选填）" />
    </view>
  </view>

  <view wx:if="{{step === 2}}" class="step-body">
    <view class="card registration-card">
      <view class="card-head">
        <view class="card-title-row">
          <text class="card-title">报名设置</text>
          <text wx:if="{{registrationPublished}}" class="title-pill">报名中</text>
        </view>
      </view>
      <view class="field compact-field">
        <text class="label">报名截止 *</text>
        <picker mode="date" bindchange="onRegistrationDeadlineDateChange" value="{{registrationDeadlineDate}}" disabled="{{scheduleStarted}}">
          <view class="picker-value">
            <text class="num">{{registrationDeadlineDisplay || '选择日期时间'}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
      <text wx:if="{{scheduleStarted}}" class="field-hint">已开始排程，如需重新开放报名请先清空草稿</text>
    </view>
    <view class="card">
      <view class="card-head">
        <view class="card-title-row">
          <text class="card-title">球员</text>
          <text class="title-pill num">{{form.format === 'knockout' ? selectedPlayers.length + '/' + form.maxPlayers : '已选 ' + selectedPlayers.length}}</text>
        </view>
        <view class="head-action tap-scale" bindtap="onAddPlayer">+ 添加球员</view>
      </view>
      <view wx:if="{{selectedPlayers.length === 0}}" class="empty">尚未选择球员</view>
      <view wx:else class="player-tags">
        <view wx:for="{{selectedPlayers}}" wx:key="playerId" class="player-tag">
          <text class="tag-name">{{item.playerName}}<text wx:if="{{form.type === 'doubles' && item.partnerName}}"> / {{item.partnerName}}</text></text>
          <view class="tag-x" catchtap="onRemovePlayer" data-id="{{item.playerId}}">
            <text>×</text>
          </view>
        </view>
      </view>
    </view>
    <view class="card">
      <view class="card-head">
        <view class="card-title-row">
          <text class="card-title">球场与时间</text>
        </view>
        <view class="head-action tap-scale" bindtap="onAddCourt">+ 添加球场</view>
      </view>
      <court-grid
        value="{{ { slotMinutes: 20, courts: schedulePlanCourts } }}"
        tournament-date="{{form.startDate}}"
        available-courts="{{availableCourts}}"
        bindchange="onCourtsChange"
      />
    </view>
  </view>

  <view wx:if="{{step === 3}}" class="step-body">
    <schedule-board
      tournament="{{form}}"
      registrations="{{selectedPlayers}}"
      schedule-plan="{{ { courts: schedulePlanCourts } }}"
      matches="{{matches}}"
      queues="{{queues}}"
      free-plays="{{freePlays}}"
      members="{{members}}"
      bindchange="onScheduleChange"
      bindregenerate="onRegenerate"
      bindclear="onClearSchedule"
    />
  </view>

  <view wx:if="{{step === 1}}" class="footer">
    <view class="back tap-scale" bindtap="onBack">{{step === 1 ? '取消' : '上一步'}}</view>
    <view class="next tap-scale" bindtap="onNext">下一步</view>
  </view>
  <view wx:elif="{{step === 2 && !registrationPublished && !scheduleStarted}}" class="footer footer-three">
    <view class="back tap-scale" bindtap="onBack">上一步</view>
    <view class="next secondary tap-scale" bindtap="onNext">下一步排程</view>
    <view class="next tap-scale" bindtap="onPublishRegistration">发布并分享到微信</view>
  </view>
  <view wx:elif="{{step === 2 && !registrationPublished && scheduleStarted}}" class="footer">
    <view class="back tap-scale" bindtap="onBack">上一步</view>
    <view class="next tap-scale" bindtap="onNext">下一步排程</view>
  </view>
  <view wx:elif="{{step === 2 && registrationPublished}}" class="footer">
    <view class="back tap-scale" bindtap="onManageRegistration">管理报名</view>
    <button open-type="share" class="next tap-scale">分享到微信</button>
  </view>
  <view wx:elif="{{step === 3}}" class="footer">
    <view class="back tap-scale" bindtap="onSaveScheduleDraft">保存草稿</view>
    <view class="next tap-scale" bindtap="onPublishSchedule">发布赛程</view>
  </view>

  <player-picker-sheet
    show="{{picker.show}}"
    title="{{picker.title}}"
    members="{{picker.members}}"
    required-count="{{picker.requiredCount}}"
    max-count="{{picker.maxCount}}"
    exclude-ids="{{picker.excludeIds}}"
    bindconfirm="onPickerConfirm"
    bindcancel="onPickerCancel"
  />
</view>
