<view class="page">
  <view class="topbar">
    <text class="text-label">第 {{currentStep}}/{{totalSteps}} 步</text>
    <text class="text-h2">{{stepTitles[currentStep - 1]}}</text>
  </view>

  <!-- Step 1: 基本信息 -->
  <view wx:if="{{currentStep === 1}}" class="step-body">
    <view class="form-row">
      <text class="text-label">赛事名称</text>
      <input class="form-input" placeholder="例：2026春季公开赛" value="{{tournament.name}}" bindinput="onInputName" />
    </view>

    <view class="form-row">
      <text class="text-label">所属赛季</text>
      <picker mode="selector" range="{{seasonOptions}}" range-key="label" value="{{seasonIndex}}" bindchange="onPickSeason">
        <view class="form-input picker-row">
          <text>{{seasonOptions.length > 0 ? seasonOptions[seasonIndex].label : '选择所属赛季'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="form-row form-row-2col">
      <view class="form-col">
        <text class="text-label">开始日期</text>
        <picker mode="date" value="{{tournament.startDate}}" start="2000-01-01" end="2100-12-31" bindchange="onPickStart">
          <view class="form-input">{{tournament.startDate || '选择日期'}}</view>
        </picker>
      </view>
      <view class="form-col">
        <text class="text-label">结束日期</text>
        <picker mode="date" value="{{tournament.endDate}}" start="2000-01-01" end="2100-12-31" bindchange="onPickEnd">
          <view class="form-input">{{tournament.endDate || '选择日期'}}</view>
        </picker>
      </view>
    </view>

    <view class="form-row form-row-2col">
      <view class="form-col">
        <text class="text-label">赛事类型</text>
        <picker mode="selector" range="{{typeOptions}}" range-key="label" value="{{typeIndex}}" bindchange="onPickType">
          <view class="form-input picker-row">
            <text>{{typeOptions[typeIndex].label}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
      <view class="form-col">
        <text class="text-label">赛制</text>
        <picker mode="selector" range="{{formatOptions}}" range-key="label" value="{{formatIndex}}" bindchange="onPickFormat">
          <view class="form-input picker-row">
            <text>{{formatOptions[formatIndex].label}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
    </view>

    <view class="form-row">
      <text class="text-label">地点（可选）</text>
      <input class="form-input" placeholder="例：上海网球中心" value="{{tournament.location}}" bindinput="onInputLocation" />
    </view>

    <view class="form-row">
      <text class="text-label">描述（可选）</text>
      <textarea class="form-textarea" placeholder="赛事简介" value="{{tournament.description}}" bindinput="onInputDescription" />
    </view>
  </view>

  <!-- Step 2: 场地时段 -->
  <view wx:if="{{currentStep === 2}}" class="step-body">
    <court-grid
      initial-grid="{{tournament.courtTimeGrid}}"
      match-date="{{tournament.startDate}}"
      bind:change="onGridChange"
    />
  </view>

  <!-- Step 3: 积分规则 -->
  <view wx:if="{{currentStep === 3}}" class="step-body">
    <view class="form-row form-row-2col">
      <view class="form-col">
        <text class="text-label">胜利积分</text>
        <input class="form-input" type="number" value="{{tournament.pointsRules.win}}" data-field="win" bindinput="onPointsInput" />
      </view>
      <view class="form-col">
        <text class="text-label">失败积分</text>
        <input class="form-input" type="number" value="{{tournament.pointsRules.loss}}" data-field="loss" bindinput="onPointsInput" />
      </view>
    </view>
    <view class="form-row">
      <text class="text-label">弃权积分</text>
      <input class="form-input" type="number" value="{{tournament.pointsRules.walkover}}" data-field="walkover" bindinput="onPointsInput" />
    </view>

    <view wx:if="{{tournament.format === 'knockout'}}" class="form-row">
      <text class="text-label">轮次奖励积分</text>
      <view class="bonus-row">
        <text class="bonus-label">第1轮</text>
        <input class="form-input bonus-input" type="number" value="{{tournament.pointsRules.bonusByRound[1]}}" data-round="1" bindinput="onBonusInput" />
      </view>
      <view class="bonus-row">
        <text class="bonus-label">第2轮</text>
        <input class="form-input bonus-input" type="number" value="{{tournament.pointsRules.bonusByRound[2]}}" data-round="2" bindinput="onBonusInput" />
      </view>
      <view class="bonus-row">
        <text class="bonus-label">第3轮</text>
        <input class="form-input bonus-input" type="number" value="{{tournament.pointsRules.bonusByRound[3]}}" data-round="3" bindinput="onBonusInput" />
      </view>
      <view class="bonus-row">
        <text class="bonus-label">第4轮</text>
        <input class="form-input bonus-input" type="number" value="{{tournament.pointsRules.bonusByRound[4]}}" data-round="4" bindinput="onBonusInput" />
      </view>
      <view class="bonus-row">
        <text class="bonus-label">第5轮</text>
        <input class="form-input bonus-input" type="number" value="{{tournament.pointsRules.bonusByRound[5]}}" data-round="5" bindinput="onBonusInput" />
      </view>
    </view>
  </view>

  <!-- Step 4: 选手 -->
  <view wx:if="{{currentStep === 4}}" class="step-body">
    <text class="text-meta">已选 {{selectedPlayerIds.length}} 人</text>
    <view class="player-picker">
      <view
        wx:for="{{allMembers}}" wx:key="_id"
        class="player-pick-row {{selectedPlayerMap[item._id] ? 'on' : ''}}"
        data-id="{{item._id}}"
        bindtap="onTogglePlayer"
      >
        <image src="{{item.avatarUrl || '/images/icons/avatar.png'}}" class="avatar" />
        <text class="player-name">{{item.name}}</text>
        <view class="check">{{selectedPlayerMap[item._id] ? '✓' : ''}}</view>
      </view>
    </view>
  </view>

  <!-- Step 5: 确认 -->
  <view wx:if="{{currentStep === 5}}" class="step-body">
    <view class="summary-card">
      <text class="text-label">赛事</text>
      <text class="text-title">{{tournament.name}}</text>
      <text class="text-meta">{{tournament.type === 'singles' ? '单打' : '双打'}} · {{tournament.format === 'regular' ? '常规赛' : '淘汰赛'}}</text>
    </view>
    <view class="summary-card">
      <text class="text-label">时间</text>
      <text class="text-body">{{tournament.startDate}}{{tournament.endDate ? ' ~ ' + tournament.endDate : ''}}</text>
    </view>
    <view class="summary-card">
      <text class="text-label">场地与时段</text>
      <text class="text-body">{{tournament.courtTimeGrid.courts.length}} 个场地，{{tournament.courtTimeGrid.slots.length}} 个档点</text>
    </view>
    <view class="summary-card">
      <text class="text-label">选手</text>
      <text class="text-body">{{selectedPlayerIds.length}} 人</text>
    </view>
    <view class="summary-card">
      <text class="text-label">积分</text>
      <text class="text-body">胜 {{tournament.pointsRules.win}} / 负 {{tournament.pointsRules.loss}} / 弃权 {{tournament.pointsRules.walkover}}</text>
    </view>
  </view>

  <!-- 底栏 -->
  <view class="footer">
    <button class="cta-secondary footer-btn" bindtap="onPrevStep">{{currentStep === 1 ? '取消' : '上一步'}}</button>
    <button class="cta-primary footer-btn" bindtap="onNextStep">{{currentStep === totalSteps ? (isEdit ? '保存' : '提交') : '下一步'}}</button>
  </view>
</view>
