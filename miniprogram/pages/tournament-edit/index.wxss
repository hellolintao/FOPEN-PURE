.tournament-edit-container {
  background: #101017;
  min-height: 100vh;
  color: #fff;
  padding: 40rpx 0;
}
.tournament-edit-title {
  font-size: 40rpx;
  color: #7c3aed;
  text-align: center;
  margin-bottom: 48rpx;
}
.dialog-input {
  width: 80vw;
  max-width: 600rpx;
  background: #181828;
  border: none;
  border-radius: 12rpx;
  color: #fff;
  font-size: 28rpx;
  padding: 18rpx 20rpx;
  margin: 0 auto 24rpx auto;
  display: block;
}
.dialog-textarea {
  margin: 16rpx 0;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #23233a;
  color: #fff;
  font-size: 32rpx;
  border: none;
  min-height: 120rpx;
  resize: none;
}

.field-label {
  color: #bfaeff;
  font-size: 28rpx;
  margin-top: 24rpx;
  margin-bottom: 4rpx;
}
.dialog-actions {
  display: flex;
  justify-content: flex-end;
  gap: 32rpx;
  margin: 0 40rpx;
}
.dialog-btn.primary {
  background: linear-gradient(90deg, #7c3aed 0%, #a78bfa 100%);
  color: #fff;
  border: none;
  border-radius: 16rpx;
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  font-weight: 500;
}
