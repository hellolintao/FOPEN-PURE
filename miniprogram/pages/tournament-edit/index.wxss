.page {
  min-height: 100vh;
  padding: var(--space-5) var(--space-5) 200rpx;
  background: var(--color-bg-1, #fff);
}

.topbar {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-bottom: var(--space-5);
}

.step-body {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.form-row {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.form-row-2col {
  flex-direction: row;
  gap: var(--space-3);
}

.form-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.form-input {
  background: var(--color-bg-2);
  border-radius: var(--radius-md);
  padding: var(--space-4);
  font-size: var(--font-body-size);
  border: 1rpx solid var(--color-border);
  min-height: 36rpx;
}

.form-textarea {
  background: var(--color-bg-2);
  border-radius: var(--radius-md);
  padding: var(--space-4);
  font-size: var(--font-body-size);
  border: 1rpx solid var(--color-border);
  min-height: 160rpx;
  width: 100%;
  box-sizing: border-box;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-arrow {
  color: var(--color-muted);
  margin-left: var(--space-2);
}

.bonus-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-top: var(--space-2);
}

.bonus-label {
  width: 110rpx;
  color: var(--color-muted);
  font-size: var(--font-label-size);
}

.bonus-input {
  flex: 1;
}

.player-picker {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-top: var(--space-3);
}

.player-pick-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
  background: #fff;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
}

.player-pick-row.on {
  background: var(--color-lime-soft);
  border-color: var(--color-lime);
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--color-bg-3);
}

.player-name {
  flex: 1;
  font-weight: 600;
}

.check {
  color: var(--color-ink);
  font-weight: 700;
}

.summary-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  padding: var(--space-4);
  background: var(--color-bg-2);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: var(--space-3);
  padding: var(--space-4);
  background: #fff;
  border-top: 1rpx solid var(--color-border);
}

.footer-btn {
  flex: 1;
}
