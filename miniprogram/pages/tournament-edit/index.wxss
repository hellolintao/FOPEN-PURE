/* 容器 */
.tournament-edit-container {
  background: #f7f7f7;
  min-height: 100vh;
  color: #333333;
  padding: 40rpx 0 180rpx 0;
  display: flex;
  flex-direction: column;
}

/* 页面标题 */
.page-title {
  font-size: 44rpx;
  color: #333333;
  text-align: center;
  margin-bottom: 40rpx;
  font-weight: 600;
}

/* 步骤指示器 */
.steps-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
  margin-bottom: 48rpx;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.step-number {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #e0e0e0;
  border: 2rpx solid #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  color: #999999;
  transition: all 0.3s ease;
}

.step-item.active .step-number {
  background: #333333;
  border-color: #333333;
  color: #fff;
}

.step-item.completed .step-number {
  background: #333333;
  border-color: #333333;
  color: #fff;
}

.step-label {
  font-size: 24rpx;
  color: #999999;
  transition: color 0.3s ease;
}

.step-item.active .step-label {
  color: #333333;
  font-weight: 500;
}

.step-line {
  flex: 1;
  height: 3rpx;
  background: #e0e0e0;
  margin: 0 24rpx;
  margin-top: 36rpx;
  transition: background 0.3s ease;
}

.step-line.active {
  background: #333333;
}

/* 步骤内容 */
.step-content {
  flex: 1;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateX(20rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* 表单区域 */
.form-section {
  padding: 0 40rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.flex-1 {
  flex: 1;
}

.field-label {
  color: #333333;
  font-size: 28rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  font-weight: 500;
}

.required {
  color: #999999;
  margin-right: 4rpx;
  font-size: 32rpx;
  font-weight: 500;
}

/* 输入框样式 */
.dialog-input {
  width: 100%;
  background: #ffffff;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  color: #333333;
  font-size: 28rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

.picker-input {
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
}

.picker-text {
  flex: 1;
}

.picker-arrow {
  font-size: 32rpx;
  color: #999999;
  margin-left: 16rpx;
}

/* 文本域样式 */
.dialog-textarea {
  width: 100%;
  padding: 24rpx 28rpx;
  border-radius: 8rpx;
  background: #ffffff;
  border: 1rpx solid #e0e0e0;
  color: #333333;
  font-size: 28rpx;
  min-height: 180rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

/* 奖励积分区域 */
.bonus-section {
  margin-top: 40rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid #e0e0e0;
}

.section-title {
  font-size: 32rpx;
  color: #333333;
  margin-bottom: 32rpx;
  font-weight: 500;
  padding-left: 12rpx;
  border-left: 4rpx solid #333333;
}

/* 底部按钮区域 */
.dialog-actions {
  display: flex;
  gap: 16rpx;
  padding: 40rpx;
  padding-bottom: 60rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #f7f7f7;
  z-index: 999;
}

.dialog-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.dialog-btn.cancel {
  background: #f5f5f5;
  color: #333333;
}

.dialog-btn.cancel:active {
  background: #e8e8e8;
}

.dialog-btn.prev {
  background: #f5f5f5;
  color: #666666;
}

.dialog-btn.prev:active {
  background: #e8e8e8;
}

.dialog-btn.primary {
  background: #333333;
  color: #fff;
}

.dialog-btn.primary:active {
  opacity: 0.8;
}

.dialog-btn.submit {
  background: #333333;
  color: #fff;
}

.dialog-btn.submit:active {
  opacity: 0.8;
}

.dialog-btn.delete {
  background: #f5f5f5;
  color: #999999;
}

.dialog-btn.delete:active {
  background: #e8e8e8;
}
