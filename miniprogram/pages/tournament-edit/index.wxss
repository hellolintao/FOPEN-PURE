.tournament-edit-container {
  background: linear-gradient(180deg, #101017 0%, #0d0d14 100%);
  min-height: 100vh;
  color: #fff;
  padding: 40rpx 0;
  display: flex;
  flex-direction: column;
}

.tournament-edit-title {
  font-size: 44rpx;
  color: #7c3aed;
  text-align: center;
  margin-bottom: 48rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 12rpx rgba(124,58,237,0.3);
}

/* 表单区域 */
.form-section {
  padding: 0 40rpx;
  flex: 1;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.flex-1 {
  flex: 1;
}

.field-label {
  color: #bfaeff;
  font-size: 28rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  font-weight: 500;
}

.required {
  color: #ff5c5c;
  margin-right: 4rpx;
  font-size: 32rpx;
  font-weight: bold;
}

/* 输入框样式 */
.dialog-input {
  width: 100%;
  background: linear-gradient(135deg, #1a1a2e 0%, #16162a 100%);
  border: 2rpx solid rgba(124,58,237,0.15);
  border-radius: 16rpx;
  color: #fff;
  font-size: 28rpx;
  padding: 24rpx 28rpx;
  transition: border-color 0.3s, box-shadow 0.3s, transform 0.2s;
  box-sizing: border-box;
}

.dialog-input:focus {
  border-color: #7c3aed;
  box-shadow: 0 0 20rpx rgba(124,58,237,0.2);
}

.picker-input {
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
}

.picker-text {
  flex: 1;
}

.picker-arrow {
  font-size: 32rpx;
  color: #7c3aed;
  margin-left: 16rpx;
  opacity: 0.7;
}

/* 文本域样式 */
.dialog-textarea {
  width: 100%;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #1a1a2e 0%, #16162a 100%);
  border: 2rpx solid rgba(124,58,237,0.15);
  color: #fff;
  font-size: 28rpx;
  min-height: 180rpx;
  line-height: 1.6;
  box-sizing: border-box;
  transition: border-color 0.3s, box-shadow 0.3s;
}

.dialog-textarea:focus {
  border-color: #7c3aed;
  box-shadow: 0 0 20rpx rgba(124,58,237,0.2);
}

/* 底部按钮区域 */
.dialog-actions {
  display: flex;
  gap: 24rpx;
  padding: 40rpx;
  padding-bottom: 60rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(180deg, transparent 0%, #101017 20%, #0d0d14 100%);
  backdrop-filter: blur(20rpx);
  z-index: 999;
}

.dialog-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.dialog-btn.cancel {
  background: rgba(255, 255, 255, 0.08);
  color: #aaa;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.dialog-btn.cancel:active {
  background: rgba(255, 255, 255, 0.12);
  transform: scale(0.98);
}

.dialog-btn.delete {
  background: linear-gradient(135deg, #e54545 0%, #ff6b6b 100%);
  color: #fff;
  box-shadow: 0 8rpx 32rpx rgba(229,69,69,0.4);
}

.dialog-btn.delete:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 16rpx rgba(229,69,69,0.3);
}

.dialog-btn.primary {
  background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%);
  color: #fff;
  box-shadow: 0 8rpx 32rpx rgba(124,58,237,0.4);
}

.dialog-btn.primary:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 16rpx rgba(124,58,237,0.3);
}
