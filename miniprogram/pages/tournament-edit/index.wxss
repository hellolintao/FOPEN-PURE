.wizard { display: flex; flex-direction: column; gap: var(--space-3, 16rpx); padding: var(--space-3, 16rpx) var(--space-3, 16rpx) 160rpx; }
.step-bar { display: flex; justify-content: space-between; padding: var(--space-2, 12rpx) 0; }
.step { color: var(--color-text-muted, #6b7280); font-size: 26rpx; }
.step.active { color: var(--color-primary, #2563eb); font-weight: 600; }
.step-body { display: flex; flex-direction: column; gap: var(--space-3, 16rpx); }
.card { background: var(--color-bg-soft, #f3f4f6); padding: var(--space-3, 16rpx); border-radius: var(--radius-lg, 24rpx); }
.card-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-2, 12rpx); }
.card-title { font-weight: 600; }
.field { display: flex; flex-direction: column; gap: var(--space-1, 8rpx); padding: var(--space-2, 12rpx) 0; }
.label { font-size: 26rpx; color: var(--color-text-muted, #6b7280); }
.input, .textarea, .input-inline { background: #fff; padding: 16rpx; border-radius: 12rpx; font-size: 28rpx; }
.textarea { min-height: 160rpx; }
.input-inline { flex: 0 0 200rpx; text-align: right; }
.picker-value { background: #fff; padding: 16rpx; border-radius: 12rpx; }
.chip-row { display: flex; gap: var(--space-2, 12rpx); }
.chip { padding: 12rpx 24rpx; border-radius: 999rpx; background: #fff; border: 1rpx solid var(--color-border, #e5e7eb); font-size: 28rpx; }
.chip.active { background: var(--color-primary, #2563eb); color: #fff; border-color: var(--color-primary, #2563eb); }
.chips { display: flex; flex-wrap: wrap; gap: var(--space-2, 12rpx); margin: var(--space-2, 12rpx) 0; }
.chip .x { margin-left: 8rpx; color: var(--color-danger, #dc2626); padding: 0 8rpx; }
.row { display: flex; justify-content: space-between; align-items: center; padding: var(--space-2, 12rpx) 0; }
.empty { color: var(--color-text-muted, #6b7280); padding: var(--space-2, 12rpx) 0; }
.footer { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; padding: var(--space-3, 16rpx); display: flex; gap: var(--space-2, 12rpx); border-top: 1rpx solid var(--color-border, #e5e7eb); box-sizing: border-box; }
.footer .back { flex: 1; }
.footer .next { flex: 2; background: var(--color-primary, #2563eb); color: #fff; }
