.wizard {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  padding: var(--space-5) var(--space-5) 200rpx;
  background: var(--color-bg);
  min-height: 100vh;
}

/* ============================================================
 * STEP BAR (numbered ink ridge)
 * ============================================================ */
.step-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-3) 0;
  border-bottom: 2rpx solid var(--color-ink);
  margin-bottom: var(--space-4);
  flex-wrap: wrap;
  gap: var(--space-2);
}

.step {
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0.08em;
  color: var(--color-muted-2);
  text-transform: uppercase;
  padding: 8rpx 0;
}

.step.active {
  color: var(--color-ink);
  font-weight: 900;
}

.step-body {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

/* ============================================================
 * CARD
 * ============================================================ */
.card {
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-md);
  padding: var(--space-5);
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: var(--space-3);
  border-bottom: 1rpx solid var(--color-border);
  margin-bottom: var(--space-4);
}

.card-title {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--color-ink);
  letter-spacing: 0.02em;
}

/* ============================================================
 * FIELD
 * ============================================================ */
.field {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  padding: var(--space-3) 0;
}

.label {
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-muted);
}

.input,
.textarea,
.input-inline {
  background: var(--color-bg-3);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-ink);
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  width: 100%;
}

.textarea { min-height: 168rpx; }

.input-inline {
  flex: 0 0 200rpx;
  text-align: right;
  padding: 16rpx 18rpx;
  font-family: var(--font-family-num);
}

.picker-value {
  background: var(--color-bg-3);
  padding: 22rpx 24rpx;
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-ink);
}

/* ============================================================
 * CHIP ROW
 * ============================================================ */
.chip-row {
  display: flex;
  gap: var(--space-2);
  flex-wrap: wrap;
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 28rpx;
  border-radius: var(--radius-pill);
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 0.02em;
  color: var(--color-ink);
}

.chip.active {
  background: var(--color-ink);
  color: var(--color-bg);
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin: var(--space-3) 0;
}

.chip .x {
  margin-left: 10rpx;
  color: var(--color-danger);
  font-weight: 900;
  padding: 0 6rpx;
}

/* ============================================================
 * ROW
 * ============================================================ */
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-3) 0;
  border-bottom: 1rpx solid var(--color-border);
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-ink);
}

.row:last-child { border-bottom: 0; }

.empty {
  color: var(--color-muted);
  padding: var(--space-4) 0;
  text-align: center;
  font-size: var(--font-body-size);
}

/* ============================================================
 * FOOTER
 * ============================================================ */
.footer {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: var(--color-bg);
  border-top: 2rpx solid var(--color-ink);
  padding: var(--space-3) var(--space-5) calc(var(--space-3) + env(safe-area-inset-bottom));
  display: flex;
  gap: var(--space-3);
  z-index: 10;
}

.footer .back,
.footer .next {
  margin: 0;
  height: 88rpx;
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 0.04em;
  display: flex;
  align-items: center;
  justify-content: center;
}

.footer .back::after,
.footer .next::after {
  border: none;
}

.footer .back {
  flex: 1;
  background: var(--color-bg);
  color: var(--color-ink);
  border: 2rpx solid var(--color-ink);
}

.footer .next {
  flex: 2;
  background: var(--color-ink);
  color: var(--color-bg);
}

.footer .back:active,
.footer .next:active {
  transform: scale(0.98);
}
