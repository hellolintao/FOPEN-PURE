.settle-page {
  padding: var(--space-5) var(--space-5) 160rpx;
  background: var(--color-bg);
  min-height: 100vh;
}

/* ============================================================
 * HEAD
 * ============================================================ */
.settle-head {
  margin-bottom: var(--space-7);
}

.head-tapes {
  margin-bottom: var(--space-4);
}

.head-titles {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
  margin-bottom: var(--space-3);
}

.head-title-zh {
  font-size: 72rpx;
  font-weight: 900;
  color: var(--color-ink);
  line-height: 0.95;
  letter-spacing: -0.01em;
}

.head-title-en {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--color-muted-2);
  letter-spacing: 0.08em;
}

.head-tournament {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-ink-3);
  letter-spacing: 0.02em;
  margin-bottom: var(--space-4);
}

.head-meta {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
  padding: var(--space-4) 0;
  border-top: 2rpx solid var(--color-ink);
  border-bottom: 2rpx solid var(--color-ink);
}

.head-meta-block {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.head-meta-label {
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.16em;
  color: var(--color-muted);
  text-transform: uppercase;
}

.head-meta-val {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--color-ink);
  letter-spacing: 0.01em;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.bonus-row {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  margin-top: var(--space-4);
}

.bonus-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.bonus-tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 14rpx;
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-sm);
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 0.04em;
  color: var(--color-ink);
}

/* ============================================================
 * EMPTY
 * ============================================================ */
.settle-empty {
  padding: var(--space-9) 0;
  text-align: center;
}

/* ============================================================
 * MATCH CARD
 * ============================================================ */
.match-card {
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-md);
  margin-bottom: var(--space-5);
  overflow: hidden;
  box-shadow: 6rpx 6rpx 0 var(--color-ink);
}

.match-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-3) var(--space-5);
  background: var(--color-ink);
  color: var(--color-bg);
}

.match-top-left,
.match-top-right {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
}

.match-date {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-muted-2);
  letter-spacing: 0.04em;
}

.match-score {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--color-bg);
  letter-spacing: -0.02em;
}

.match-duration {
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.16em;
  color: var(--color-muted-2);
  padding: 4rpx 10rpx;
  border: 1rpx solid var(--color-muted-2);
  border-radius: var(--radius-sm);
}

.match-body {
  display: flex;
  flex-direction: column;
}

/* ============================================================
 * SIDE
 * ============================================================ */
.settle-side {
  padding: var(--space-5);
}

.settle-side-win {
  background: var(--color-lime);
}

.settle-side-loss {
  background: var(--color-bg);
}

.side-head {
  margin-bottom: var(--space-3);
}

.side-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-4);
  margin-bottom: var(--space-2);
}

.side-name {
  flex: 1;
  font-size: 40rpx;
  font-weight: 900;
  color: var(--color-ink);
  letter-spacing: -0.01em;
  line-height: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.side-points {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  flex-shrink: 0;
}

.side-points-num {
  font-size: 72rpx;
  font-weight: 900;
  color: var(--color-ink);
  letter-spacing: -0.04em;
  line-height: 0.9;
}

.side-points-label {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: var(--color-ink-3);
  text-transform: uppercase;
}

.side-points-muted .side-points-num {
  font-size: 48rpx;
  color: var(--color-ink-3);
}
.side-points-muted .side-points-label {
  color: var(--color-muted);
}

.side-detail {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--color-ink-3);
  letter-spacing: 0.02em;
}

.settle-side-loss .side-detail {
  color: var(--color-muted);
}

/* ============================================================
 * DIVIDER
 * ============================================================ */
.match-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-2) 0;
  background: var(--color-ink);
  position: relative;
}

.match-divider-text {
  font-size: 26rpx;
  font-weight: 900;
  letter-spacing: 0.2em;
  color: var(--color-lime);
}
