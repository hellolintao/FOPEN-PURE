<view class="member-manage-container">
  <view class="member-title">会员管理</view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrapper">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索会员姓名或手机号"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        confirm-type="search"
        bindconfirm="onSearch"
      />
      <view class="clear-btn" wx:if="{{searchKeyword}}" bindtap="onClearSearch">✕</view>
    </view>
  </view>

  <!-- 筛选栏 -->
  <view class="filter-bar">
    <view class="filter-item {{filterStatus === '' ? 'active' : ''}}" bindtap="onFilterStatus" data-status="">
      全部
    </view>
    <view class="filter-item {{filterStatus === 'active' ? 'active' : ''}}" bindtap="onFilterStatus" data-status="active">
      活跃
    </view>
    <view class="filter-item {{filterStatus === 'inactive' ? 'active' : ''}}" bindtap="onFilterStatus" data-status="inactive">
      不活跃
    </view>
  </view>

  <!-- 会员列表 -->
  <view class="member-list">
    <view wx:if="{{memberList.length === 0 && !loading}}" class="empty-state">
      <text class="empty-icon">👤</text>
      <text class="empty-text">暂无会员数据</text>
    </view>

    <block wx:for="{{memberList}}" wx:key="_id">
      <view class="member-item" bindtap="onEditMember" data-member="{{item}}">
        <view class="member-avatar" catchtap="onAvatarTap" data-url="{{item.avatarUrl}}">
          <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" class="avatar-img" mode="aspectFill" />
          <text wx:else class="avatar-placeholder">{{item.name.charAt(0) || '会'}}</text>
        </view>
        <view class="member-info">
          <view class="member-name">{{item.name || '未命名'}}</view>
          <view class="member-phone">{{item.phone || '未填写手机号'}}</view>
          <view class="member-meta">
            <text class="join-time">加入时间: {{item.formattedTime}}</text>
          </view>
        </view>
        <view class="member-status {{item.status === 'active' ? 'active' : 'inactive'}}">
          {{item.status === 'active' ? '活跃' : '不活跃'}}
        </view>
      </view>
    </block>
  </view>

  <!-- 加载状态 -->
  <view class="load-more" wx:if="{{memberList.length > 0}}">
    <view wx:if="{{loading}}" class="loading">
      <text class="loading-text">加载中...</text>
    </view>
    <view wx:elif="{{noMore}}" class="no-more">
      <text class="no-more-text">没有更多了</text>
    </view>
  </view>
</view>
