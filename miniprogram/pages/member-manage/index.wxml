<view class="mm-page">

  <!-- HEAD -->
  <view class="mm-head anim-stage-rise">
    <view class="head-tapes">
      <text class="tape tape-stamped">ADMIN · 会员</text>
    </view>
    <view class="head-titles">
      <text class="head-title-zh">会员管理</text>
      <text class="head-title-en num">ROSTER</text>
    </view>
  </view>

  <!-- SEARCH -->
  <view class="search-bar anim-stage-rise anim-delay-1">
    <input
      class="search-input"
      placeholder="搜索会员昵称"
      placeholder-class="search-placeholder"
      value="{{searchKeyword}}"
      bindinput="onSearchInput"
      confirm-type="search"
      bindconfirm="onSearch"
    />
    <view wx:if="{{searchKeyword}}" class="clear-btn tap-scale" bindtap="onClearSearch">
      <text class="num">×</text>
    </view>
  </view>

  <!-- FILTER -->
  <view class="filter-bar anim-stage-rise anim-delay-2">
    <view class="filter-item {{filterStatus === '' ? 'active' : ''}} tap-scale" bindtap="onFilterStatus" data-status="">全部</view>
    <view class="filter-item {{filterStatus === 'active' ? 'active' : ''}} tap-scale" bindtap="onFilterStatus" data-status="active">活跃</view>
    <view class="filter-item {{filterStatus === 'inactive' ? 'active' : ''}} tap-scale" bindtap="onFilterStatus" data-status="inactive">不活跃</view>
  </view>

  <!-- LIST -->
  <view class="member-list anim-stage-rise anim-delay-3">

    <view wx:if="{{memberList.length === 0 && !loading}}" class="empty-state">
      <text class="tape">暂无会员数据</text>
    </view>

    <view wx:for="{{memberList}}" wx:key="_id" class="member-item tap-scale" bindtap="onEditMember" data-member="{{item}}">
      <view class="member-avatar" catchtap="onAvatarTap" data-url="{{item.avatarLoadFailed ? '' : item.avatarUrl}}">
        <image wx:if="{{item.avatarUrl && !item.avatarLoadFailed}}" src="{{item.avatarUrl}}" class="avatar-img" mode="aspectFill" binderror="onAvatarError" data-id="{{item._id}}" />
        <text wx:else class="avatar-placeholder">{{item.name.charAt(0) || '会'}}</text>
      </view>
      <view class="member-info">
        <view class="member-title-row">
          <text class="member-name">{{item.name || '未命名'}}</text>
          <text wx:if="{{item.claimLabel}}" class="claim-badge claim-{{item.claimClass}}">{{item.claimLabel}}</text>
        </view>
        <text class="member-meta num">JOINED · {{item.formattedTime}}</text>
      </view>
      <text class="member-status status-{{item.status || 'inactive'}}">{{item.status === 'active' ? '活跃' : '不活跃'}}</text>
    </view>

  </view>

  <!-- LOAD MORE -->
  <view class="load-more" wx:if="{{memberList.length > 0}}">
    <view wx:if="{{loading}}" class="load-state">加载中…</view>
    <view wx:elif="{{noMore}}" class="load-state">— 没有更多了 —</view>
  </view>
</view>
