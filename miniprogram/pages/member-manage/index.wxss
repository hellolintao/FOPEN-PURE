.member-manage-container {
  background: linear-gradient(180deg, #101017 0%, #0d0d14 100%);
  min-height: 100vh;
  padding: 40rpx 0;
  padding-bottom: 20rpx;
}

.member-title {
  font-size: 44rpx;
  color: #7c3aed;
  text-align: center;
  margin-bottom: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 12rpx rgba(124,58,237,0.3);
}

/* 搜索栏 */
.search-bar {
  padding: 0 40rpx 24rpx 40rpx;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #1a1a2e 0%, #16162a 100%);
  border: 2rpx solid rgba(124,58,237,0.15);
  border-radius: 32rpx;
  padding: 16rpx 24rpx;
  transition: border-color 0.3s;
}

.search-input-wrapper:focus-within {
  border-color: #7c3aed;
  box-shadow: 0 0 20rpx rgba(124,58,237,0.2);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  opacity: 0.7;
}

.search-input {
  flex: 1;
  color: #fff;
  font-size: 28rpx;
}

.clear-btn {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  color: #aaa;
  font-size: 24rpx;
  margin-left: 16rpx;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  gap: 16rpx;
  padding: 0 40rpx 32rpx 40rpx;
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: linear-gradient(135deg, #1a1a2e 0%, #16162a 100%);
  border-radius: 16rpx;
  color: #aaa;
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.3s ease;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
}

.filter-item.active {
  background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(124,58,237,0.3);
}

/* 会员列表 */
.member-list {
  padding: 0 32rpx;
}

.member-item {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #1a1a2e 0%, #16162a 100%);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(124,58,237,0.1), inset 0 1rpx 0 rgba(255,255,255,0.05);
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s;
  border: 2rpx solid transparent;
}

.member-item:active {
  transform: scale(0.98);
  border-color: rgba(124,58,237,0.5);
  box-shadow: 0 4rpx 20rpx rgba(124,58,237,0.2);
}

.member-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #222;
  border: 3rpx solid #7c3aed;
  margin-right: 24rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(124,58,237,0.2);
  transition: transform 0.2s ease;
}

.member-avatar:active {
  transform: scale(0.9);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 48rpx;
  color: #7c3aed;
  font-weight: bold;
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-name {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-phone {
  font-size: 26rpx;
  color: #aaa;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-meta {
  font-size: 24rpx;
  color: #888;
}

.join-time {
  display: block;
}

.member-status {
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.member-status.active {
  background: linear-gradient(135deg, #22c55e 0%, #4ade80 100%);
  color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(34,197,94,0.3);
}

.member-status.inactive {
  background: rgba(255, 255, 255, 0.1);
  color: #aaa;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  opacity: 0.3;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #aaa;
}

/* 加载更多 */
.load-more {
  padding: 32rpx 0;
  text-align: center;
}

.loading-text, .no-more-text {
  font-size: 26rpx;
  color: #888;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.no-more {
  color: #666;
}
