.mm-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: var(--space-5) var(--space-5) 120rpx;
}

/* ============================================================
 * HEAD
 * ============================================================ */
.mm-head {
  margin-bottom: var(--space-5);
}

.head-tapes {
  margin-bottom: var(--space-4);
}

.head-titles {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
}

.head-title-zh {
  font-size: 64rpx;
  font-weight: 900;
  color: var(--color-ink);
  line-height: 0.95;
  letter-spacing: -0.01em;
}

.head-title-en {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--color-muted-2);
  letter-spacing: 0.08em;
}

/* ============================================================
 * SEARCH
 * ============================================================ */
.search-bar {
  display: flex;
  align-items: center;
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-pill);
  padding: var(--space-2) var(--space-5);
  margin-bottom: var(--space-3);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-ink);
  letter-spacing: 0.01em;
  height: 56rpx;
  line-height: 56rpx;
}

.search-placeholder {
  color: var(--color-muted-2);
  font-weight: 600;
}

.clear-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-ink);
  color: var(--color-bg);
  border-radius: 50%;
  margin-left: var(--space-3);
  font-size: 28rpx;
  font-weight: 900;
}

/* ============================================================
 * FILTER
 * ============================================================ */
.filter-bar {
  display: flex;
  gap: var(--space-2);
  margin-bottom: var(--space-5);
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-pill);
  color: var(--color-ink);
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.filter-item.active {
  background: var(--color-ink);
  color: var(--color-bg);
}

/* ============================================================
 * LIST
 * ============================================================ */
.member-list {
  display: flex;
  flex-direction: column;
}

.empty-state {
  padding: var(--space-9) 0;
  text-align: center;
}

.member-item {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  padding: var(--space-4) var(--space-3);
  border-bottom: 1rpx solid var(--color-border);
}

.member-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--color-bg-3);
  border: 2rpx solid var(--color-ink);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--color-ink);
}

.member-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.member-name {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--color-ink);
  letter-spacing: 0.01em;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.member-phone {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-muted);
  letter-spacing: 0.04em;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.member-meta {
  font-size: 18rpx;
  font-weight: 800;
  color: var(--color-muted-2);
  letter-spacing: 0.12em;
}

.member-status {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: var(--radius-sm);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.member-status.status-active { background: var(--color-lime); color: var(--color-ink); }
.member-status.status-inactive { background: var(--color-bg-3); color: var(--color-muted); }

.load-more {
  padding: var(--space-5) 0;
  text-align: center;
}

.load-state {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: var(--color-muted);
  text-transform: uppercase;
}
