.loading { text-align: center; padding: 80rpx; color: var(--color-text-muted, #6b7280); }
.brackets { padding: var(--space-3, 16rpx); display: flex; flex-direction: column; gap: var(--space-3, 16rpx); }
.head { display: flex; justify-content: space-between; align-items: center; }
.title { font-weight: 600; font-size: 32rpx; }
.text-meta { color: var(--color-text-muted, #6b7280); font-size: 24rpx; }
.empty { text-align: center; padding: var(--space-3, 16rpx); }
.court-block { background: var(--color-bg-soft, #f3f4f6); padding: var(--space-3, 16rpx); border-radius: var(--radius-lg, 24rpx); }
.court-head { display: flex; justify-content: space-between; margin-bottom: var(--space-2, 12rpx); }
.court-title { font-weight: 600; }
.court-time { color: var(--color-text-muted, #6b7280); }
.match-row { display: flex; align-items: center; gap: var(--space-2, 12rpx); padding: var(--space-2, 12rpx) 0; border-bottom: 1rpx dashed var(--color-border, #e5e7eb); }
.match-row.freeplay { background: rgba(0,0,0,0.02); padding-left: 8rpx; padding-right: 8rpx; border-radius: 8rpx; }
.match-row.gray { opacity: 0.5; }
.player { flex: 1; padding: 4rpx 8rpx; background: #fff; border-radius: 6rpx; font-size: 28rpx; }
.vs { color: var(--color-text-muted, #9ca3af); }
.status-chip { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 12rpx; }
.status-pending { background: #fef3c7; color: #92400e; }
.status-submitted { background: #dbeafe; color: #1e40af; }
.status-confirmed { background: #d1fae5; color: #065f46; }
.status-disputed { background: #fee2e2; color: #991b1b; }
.later-block { background: var(--color-bg-soft, #f3f4f6); padding: var(--space-3, 16rpx); border-radius: var(--radius-lg, 24rpx); }
.later-title { font-weight: 600; display: block; margin-bottom: var(--space-2, 12rpx); }
