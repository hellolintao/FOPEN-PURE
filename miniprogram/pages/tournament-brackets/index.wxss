.brackets-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 自动排程入口 */
.scheduler-bar {
  margin: 20rpx 30rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.scheduler-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.scheduler-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.scheduler-sub {
  font-size: 22rpx;
  color: #999;
}

.scheduler-sub.warn {
  color: #fa8c16;
}

.scheduler-btn {
  padding: 18rpx 36rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

.scheduler-btn.disabled {
  opacity: 0.6;
}

/* 未排程警告条 */
.warn-banner {
  margin: 20rpx 30rpx;
  padding: 24rpx;
  background: #fff7e6;
  border: 1rpx solid #fa8c16;
  border-radius: 16rpx;
}

.warn-banner-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #fa8c16;
  display: block;
  margin-bottom: 12rpx;
}

.unsched-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.unsched-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5e0c5;
}

.unsched-meta {
  font-size: 22rpx;
  color: #999;
  min-width: 80rpx;
}

.unsched-text {
  flex: 1;
  font-size: 24rpx;
  color: #333;
  padding: 0 16rpx;
}

.unsched-btn {
  padding: 10rpx 20rpx;
  background: #fff;
  border: 1rpx solid #fa8c16;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #fa8c16;
}

.warn-banner-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999;
}

/* 每场比赛的排程信息 */
.match-schedule {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
  padding: 6rpx 12rpx;
  background: #eef4ff;
  border-radius: 8rpx;
}

.match-schedule.unscheduled {
  background: #fff1f0;
}

.schedule-time {
  font-size: 22rpx;
  color: #1890ff;
  font-weight: 500;
}

.schedule-divider {
  font-size: 22rpx;
  color: #ccc;
}

.schedule-court {
  font-size: 22rpx;
  color: #555;
}

.schedule-text {
  font-size: 22rpx;
  color: #ff4d4f;
}

/* 参赛人员区域 */
.participants-section {
  margin: 20rpx 30rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.section-count {
  font-size: 24rpx;
  color: #999;
  margin-left: 16rpx;
}

.section-status {
  font-size: 24rpx;
  color: #999;
  margin-left: 16rpx;
}

.section-status.saved {
  color: #52c41a;
}

.section-status.modified {
  color: #fa8c16;
}

.manage-btn {
  font-size: 24rpx;
  color: #667eea;
  background: none;
}

.manage-btn::after {
  border: 1rpx solid #667eea;
  border-radius: 8rpx;
}

.participants-list {
  padding: 10rpx 0;
}

.participants-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding: 10rpx 0;
}

.participant-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.participant-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  text-align: center;
}

.participant-item.team {
  background: linear-gradient(135deg, #f8f9ff 0%, #f5f5fa 100%);
}

.participant-card.team {
  background: linear-gradient(135deg, #f8f9ff 0%, #f5f5fa 100%);
}

.participant-badge {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.participant-card .participant-badge {
  margin-right: 0;
  margin-bottom: 12rpx;
}

.participant-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.participant-card .participant-name {
  flex: none;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.team-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.participant-card .team-info {
  flex: none;
  width: 100%;
}

.team-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.team-members {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.member-name {
  font-size: 24rpx;
  color: #666;
}

.member-divider {
  font-size: 20rpx;
  color: #ddd;
  display: none;
}

.participant-status {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.participant-status.confirmed {
  background: #e6f7e6;
  color: #52c41a;
}

.participant-status.registered {
  background: #fff7e6;
  color: #fa8c16;
}

.participant-status.withdrew {
  background: #f5f5f5;
  color: #999;
}

/* 对位区域 */
.brackets-section {
  margin: 20rpx 30rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
}

.matchups-list {
  padding: 10rpx 0;
}

.matchup-item {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding: 24rpx 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.matchup-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.matchup-player {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 10rpx 0;
}

.matchup-player.left {
  justify-content: flex-end;
  padding-right: 20rpx;
}

.matchup-player.right {
  justify-content: flex-start;
  padding-left: 20rpx;
}

.player-name {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
}

.player-name.placeholder {
  color: #ccc;
  font-style: italic;
}

.matchup-divider {
  width: 34rpx;
  height: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: 700;
  margin: 0 10rpx;
}

.matchup-delete {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 10rpx;
}

.delete-icon {
  font-size: 36rpx;
  color: #ff4d4f;
  font-weight: bold;
  line-height: 1;
}

.btn-group {
  display: flex;
  gap: 20rpx;
}
.add-matchup-btn {
  margin-top: 20rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
  flex: 1;
}
.random-btn {
  margin-top: 20rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
  flex: 1;
}

.save-btn {
  margin-top: 16rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
  flex: 1;
}

.add-round-btn {
  flex: 1;
  max-width: 300rpx;
  margin: 0;
  padding: 24rpx;
  background: linear-gradient(135deg, #1a78c4 0%, #0d9c9e 100%);
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

/* 操作按钮区域 */
.action-btns {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin: 30rpx;
}

.delete-btn {
  flex: 1;
  max-width: 300rpx;
  padding: 24rpx;
  background: #fff;
  border: 1rpx solid #ff4d4f;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: 500;
}

.delete-btn:active {
  background: #fff1f0;
}