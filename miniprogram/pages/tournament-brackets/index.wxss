.bracket-page {
  padding: var(--space-5) var(--space-5) 160rpx;
  background: var(--color-bg);
  min-height: 100vh;
}

.state-loading {
  padding: var(--space-7) 0;
}

/* ============================================================
 * HEAD
 * ============================================================ */
.bracket-head {
  margin-bottom: var(--space-6);
}

.head-tapes {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.head-title {
  font-size: 60rpx;
  font-weight: 900;
  color: var(--color-ink);
  line-height: 1;
  letter-spacing: -0.01em;
  display: block;
  margin-bottom: var(--space-4);
}

.head-sub {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
}

.head-sub-text {
  font-size: var(--font-meta-size);
  color: var(--color-muted);
  font-weight: 600;
  letter-spacing: 0.04em;
}

.head-action {
  font-size: 24rpx;
  padding: 16rpx 28rpx;
}

/* ============================================================
 * EMPTY
 * ============================================================ */
.bracket-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-8) 0;
  text-align: center;
}

.bracket-empty-hint {
  font-size: var(--font-body-size);
  color: var(--color-muted);
}

.bracket-empty.compact {
  padding: var(--space-6) 0;
}

/* ============================================================
 * GROUP KNOCKOUT
 * ============================================================ */
.gk-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: var(--space-5);
}

.gk-tab {
  height: 56rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  font-weight: 900;
  color: var(--color-ink);
  background: var(--color-bg);
  box-sizing: border-box;
}

.gk-tab.active {
  color: var(--color-bg);
  background: var(--color-ink);
}

.gk-panel,
.gk-group-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.gk-group-card,
.gk-round {
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-sm);
  background: var(--color-bg);
  padding: var(--space-4);
  box-sizing: border-box;
}

.gk-group-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-3);
  padding-bottom: var(--space-3);
  border-bottom: 2rpx solid var(--color-ink);
}

.gk-group-title {
  font-size: 32rpx;
  line-height: 1.2;
  font-weight: 900;
  color: var(--color-ink);
}

.gk-group-meta {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 800;
  color: var(--color-muted);
}

.gk-slot {
  display: grid;
  grid-template-columns: 48rpx minmax(0, 1fr);
  align-items: center;
  gap: var(--space-3);
  min-height: 72rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.gk-slot:last-child {
  border-bottom: 0;
}

.slot-no {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  background: var(--color-ink);
  color: var(--color-bg);
  font-size: 20rpx;
  font-weight: 900;
}

.slot-player {
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.gk-match {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 56rpx minmax(0, 1fr);
  align-items: center;
  gap: var(--space-3);
  min-height: 76rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.gk-match:last-child {
  border-bottom: 0;
}

.gk-player-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.gk-player-wrap.right {
  justify-content: flex-end;
}

.gk-player {
  min-width: 0;
  font-size: 27rpx;
  font-weight: 800;
  color: var(--color-ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.gk-player.right {
  text-align: right;
}

.gk-source {
  flex-shrink: 0;
  padding: 4rpx 8rpx;
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-sm);
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1;
  color: var(--color-ink);
}

.gk-vs {
  text-align: center;
  font-size: 20rpx;
  font-weight: 900;
  color: var(--color-muted-2);
}

.gk-match.is-bye .gk-player {
  color: var(--color-muted-2);
}

.gk-errors {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: var(--space-3);
  border: 2rpx solid var(--color-danger);
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-danger);
  background: var(--color-bg);
}

.gk-action {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 var(--space-4);
  border-radius: var(--radius-sm);
  background: var(--color-ink);
  color: var(--color-bg);
  font-size: 28rpx;
  font-weight: 900;
  text-align: center;
  box-sizing: border-box;
}

/* ============================================================
 * ROUND SECTION
 * ============================================================ */
.round-section {
  margin-bottom: var(--space-7);
}

.round-banner {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-5);
}

.round-banner-sub {
  font-size: var(--font-meta-size);
  font-weight: 700;
  color: var(--color-ink-3);
  letter-spacing: 0.06em;
}

/* ============================================================
 * COURT BLOCK
 * ============================================================ */
.court-block {
  margin-bottom: var(--space-6);
}

.court-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: var(--space-3);
  border-bottom: 2rpx solid var(--color-ink);
  margin-bottom: var(--space-2);
}

.court-name {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--color-ink);
  letter-spacing: -0.01em;
}

.court-meta {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 0.14em;
  color: var(--color-muted);
  text-transform: uppercase;
}

.court-empty {
  padding: var(--space-5) 0;
  text-align: center;
  font-size: var(--font-body-size);
  color: var(--color-muted);
}

/* ============================================================
 * MATCH LIST
 * ============================================================ */
.match-list {
  display: flex;
  flex-direction: column;
}

.match-list.muted {
  opacity: 0.78;
}

.match-row {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-4) var(--space-2);
  position: relative;
}

.match-row::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: var(--color-border);
}

.match-row:last-child::before {
  background: transparent;
}

.match-players {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  min-width: 0;
}

.player-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-ink);
  letter-spacing: 0.02em;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.vs {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 0.18em;
  color: var(--color-muted-2);
}

.match-status {
  display: flex;
  align-items: center;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: var(--radius-sm);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.status-tag-pending { background: var(--color-bg-3); color: var(--color-ink-3); }
.status-tag-submitted { background: var(--color-ink); color: var(--color-bg); }
.status-tag-confirmed { background: var(--color-lime); color: var(--color-ink); }
.status-tag-disputed { background: var(--color-danger); color: var(--color-bg); }
.status-tag-bye { background: transparent; color: var(--color-muted-2); border: 2rpx solid var(--color-border); }

.match-row.is-bye .player-name { color: var(--color-muted-2); }

.match-row.is-freeplay {
  background: var(--color-bg-3);
}
.match-row.is-freeplay::before { background: transparent; }

.freeplay-label {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-ink-3);
  letter-spacing: 0.04em;
}

.freeplay-count {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--color-ink);
}

/* ============================================================
 * LATER (round 2+) - reduced visual weight
 * ============================================================ */
.round-section.later {
  padding-top: var(--space-6);
  border-top: 2rpx solid var(--color-ink);
}

.later-block {
  margin-bottom: var(--space-6);
}

.later-block .match-row {
  opacity: 0.85;
}
