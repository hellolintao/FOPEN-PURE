.brackets-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 参赛人员区域 */
.participants-section {
  margin: 20rpx 30rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.section-count {
  font-size: 24rpx;
  color: #999;
}

.participants-list {
  padding: 10rpx 0;
}

.participant-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.participant-item.team {
  background: linear-gradient(135deg, #f8f9ff 0%, #f5f5fa 100%);
}

.participant-badge {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.participant-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.team-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.team-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.team-members {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.member-name {
  font-size: 24rpx;
  color: #666;
}

.member-divider {
  font-size: 20rpx;
  color: #ddd;
}

.participant-status {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.participant-status.confirmed {
  background: #e6f7e6;
  color: #52c41a;
}

.participant-status.registered {
  background: #fff7e6;
  color: #fa8c16;
}

.participant-status.withdrew {
  background: #f5f5f5;
  color: #999;
}
