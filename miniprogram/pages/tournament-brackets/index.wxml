<view wx:if="{{loading}}" class="loading">加载中...</view>

<view wx:elif="{{tournament}}" class="brackets">
  <view class="head">
    <text class="title">{{tournament.name}} · 首轮排程</text>
    <button
      wx:if="{{tournament.status === 'draft' || tournament.status === 'upcoming'}}"
      size="mini"
      bindtap="onEditSchedule">
      编辑排程
    </button>
  </view>

  <view wx:if="{{decoratedCourts.length === 0}}" class="empty text-meta">尚未配置排程</view>

  <view wx:for="{{decoratedCourts}}" wx:for-item="court" wx:key="courtId" class="court-block">
    <view class="court-head">
      <text class="court-title">{{court.name}}</text>
      <text class="court-time text-meta">{{court.slotCount}} 个时段</text>
    </view>

    <view wx:if="{{court.matches.length === 0 && court.freePlays.length === 0}}" class="empty text-meta">无比赛</view>

    <view wx:for="{{court.matches}}" wx:for-item="m" wx:key="matchId" class="match-row">
      <text class="player">{{m.__player1Name}}</text>
      <text class="vs">VS</text>
      <text class="player">{{m.__player2Name}}</text>
      <text class="status-chip status-{{m.resultStatus}}">{{m.bye ? '轮空' : m.resultStatus}}</text>
    </view>

    <view wx:for="{{court.freePlays}}" wx:for-item="fp" wx:key="_id" class="match-row freeplay">
      <text>自由拉球</text>
      <text class="text-meta">{{fp.playerIds.length}} 人</text>
    </view>
  </view>

  <view wx:for="{{laterRounds}}" wx:for-item="b" wx:key="round" class="later-block">
    <text class="later-title">第 {{b.round}} 轮（待半决/决赛安排）</text>
    <view wx:for="{{b.matches}}" wx:for-item="m" wx:key="matchId" class="match-row gray">
      <text class="player">{{m.__player1Name}}</text>
      <text class="vs">VS</text>
      <text class="player">{{m.__player2Name}}</text>
    </view>
  </view>
</view>
