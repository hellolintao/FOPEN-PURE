var TWO = function(n) {
  n = n < 10 ? ('0' + n) : ('' + n);
  return n;
};

var formatScheduleTime = function(value) {
  if (!value) return '';
  var s = '';
  if (typeof value === 'string') s = value;
  else if (typeof value === 'number') s = '' + value;
  else if (value && value.toJSON) s = value.toJSON();
  else return '';

  var idx = s.indexOf('T');
  if (idx < 0) return s;
  var datePart = s.substring(0, idx);
  var timePart = s.substring(idx + 1);

  var dp = datePart.split('-');
  if (dp.length < 3) return s;
  var month = dp[1];
  var day = dp[2];

  var tp = timePart.split(':');
  if (tp.length < 2) return month + '-' + day;
  var hour = tp[0];
  var minute = tp[1];

  return month + '-' + day + ' ' + hour + ':' + minute;
};

var courtName = function(courtId, courts) {
  if (!courtId) return '';
  if (!courts || !courts.length) return courtId;
  for (var i = 0; i < courts.length; i++) {
    if (courts[i].courtId === courtId) return courts[i].name || courtId;
  }
  return courtId;
};

var statusLabel = function(status, isBye) {
  if (isBye) return '轮空';
  if (status === 'pending') return '待打';
  if (status === 'submitted') return '已交';
  if (status === 'confirmed') return '已确';
  if (status === 'disputed') return '争议';
  return status || '';
};

var roundLabel = function(round, totalRounds) {
  var n = +round || 0;
  if (totalRounds && n === totalRounds) return '决赛';
  if (totalRounds && n === totalRounds - 1) return '半决赛';
  if (totalRounds && n === totalRounds - 2) return '四分之一决赛';
  return '第 ' + n + ' 轮';
};

var pad2 = function(n) {
  var v = +n || 0;
  return v < 10 ? ('0' + v) : ('' + v);
};

module.exports = {
  formatScheduleTime: formatScheduleTime,
  courtName: courtName,
  statusLabel: statusLabel,
  roundLabel: roundLabel,
  pad2: pad2
};
