.score-entry-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

/* 赛事头部 */
.tournament-header {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 积分规则 */
.points-rules {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.points-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.points-grid {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.point-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #f5f5f5;
  padding: 12rpx;
  border-radius: 8rpx;
}

.point-label {
  font-size: 20rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.point-value {
  font-size: 24rpx;
  font-weight: bold;
}

.point-value.win {
  color: #52c41a;
}

.point-value.loss {
  color: #ff4d4f;
}

.point-value.walkover {
  color: #faad14;
}

.bonus-section {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 12rpx;
}

.bonus-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.bonus-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #f0f3ff;
  padding: 10rpx 14rpx;
  border-radius: 6rpx;
  min-width: 80rpx;
  transition: all 0.3s ease;
}

.bonus-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.3);
  transform: scale(1.05);
}

.bonus-item.active .bonus-label {
  color: #fff;
}

.bonus-item.active .bonus-value {
  color: #fff;
}

.bonus-label {
  font-size: 18rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.bonus-value {
  font-size: 22rpx;
  font-weight: bold;
  color: #667eea;
}

/* 提交按钮区域 */
.submit-section {
  padding: 40rpx 20rpx 60rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
}

.submit-btn::after {
  border: none;
}

.tournament-name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.tournament-info {
  display: block;
  font-size: 26rpx;
  color: #999;
}

/* 比赛列表 */
.matches-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 比赛卡片 */
.match-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 比赛头部 */
.match-header {
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.match-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

/* 比赛内容 */
.match-body {
  padding-top: 20rpx;
}

/* 表单项 */
.form-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  width: 160rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a1a;
  padding: 16rpx 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

/* 选手名字 */
.player-names {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  margin-top: 20rpx;
}

.player-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.player-name.left {
  text-align: left;
}

.player-name.right {
  text-align: right;
}

/* 比分控制 */
.score-control {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
  margin-top: 20rpx;
  background: #fafafa;
  border-radius: 12rpx;
  padding: 30rpx 40rpx;
}

.score-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.score-button {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
}

.score-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #1a1a1a;
  min-width: 60rpx;
  text-align: center;
}

.vs-divider {
  font-size: 24rpx;
  font-weight: bold;
  color: #999;
  font-style: italic;
}
