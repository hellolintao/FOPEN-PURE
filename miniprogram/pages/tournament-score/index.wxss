.score-page {
  padding: var(--space-3, 24rpx);
  padding-bottom: 200rpx;
}
.head .title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.head .title {
  font-size: 36rpx;
  font-weight: 600;
}
.format-chip {
  padding: 4rpx 14rpx;
  background: var(--color-bg-3);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}
.progress {
  display: flex;
  align-items: center;
  gap: var(--space-2, 16rpx);
  margin-top: var(--space-2, 16rpx);
}
.progress-bar {
  flex: 1;
  height: 12rpx;
  background: var(--color-bg-3);
  border-radius: 6rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: var(--color-success);
  border-radius: 6rpx;
  transition: width 200ms ease;
}
.progress-label {
  font-size: 24rpx;
  color: var(--color-muted);
}
.rules-hint {
  margin-top: var(--space-2, 16rpx);
  font-size: 24rpx;
}
.empty-state {
  padding: 200rpx 0;
  text-align: center;
  color: var(--color-muted);
}
.round-group {
  margin-top: var(--space-3, 24rpx);
  animation: fade-up 220ms var(--ease-out) both;
}
.round-title {
  font-weight: 600;
  font-size: 28rpx;
  display: block;
  margin-bottom: var(--space-1, 8rpx);
}
.sticky-bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--space-3, 24rpx);
  background: #fff;
  border-top: 1rpx solid var(--color-border, #eee);
  z-index: 10;
}
.confirm-all {
  width: 100%;
  transition: transform 120ms var(--ease-out), opacity 120ms var(--ease-out);
}
.confirm-all:active {
  transform: scale(0.98);
}
