<view class="score-page">
  <view wx:if="{{tournament}}" class="head">
    <view class="title-row">
      <text class="title">{{tournament.name}}</text>
      <text class="format-chip">{{tournament.format === 'knockout' ? '单淘汰' : '常规赛'}}</text>
    </view>
    <view class="progress">
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{totalCount > 0 ? (confirmedCount * 100 / totalCount) : 0}}%"></view>
      </view>
      <text class="progress-label">已确认 {{confirmedCount}} / {{totalCount}}</text>
    </view>
    <view class="rules-hint text-meta">4 局制 · 3:3 抢七（如 7-5） · 4:0 / 4:1 / 4:2 直接结束</view>
  </view>

  <skeleton-loader wx:if="{{loading && rowsByRound.length === 0}}" rows="{{4}}" />

  <view wx:if="{{!loading && empty}}" class="empty-state">
    <text>暂无比赛</text>
  </view>

  <view wx:for="{{rowsByRound}}" wx:for-item="g" wx:key="round" class="round-group">
    <text class="round-title">第 {{g.round}} 轮</text>
    <view wx:for="{{g.matches}}" wx:for-item="m" wx:key="_id" id="row-{{m.sourceMatchId}}">
      <score-row
        match="{{m}}"
        is-admin="{{isAdmin}}"
        bindsubmit="onSubmit"
        bindreconfirm="onReconfirm"
        binddraftchange="onDraftChange"
      />
    </view>
  </view>

  <view wx:if="{{totalCount > 0}}" class="sticky-bottom">
    <button class="confirm-all" bindtap="onConfirmAll" disabled="{{bottomDisabled}}" type="primary">
      {{bottomLabel}}（{{bottomCount}} 场）
    </button>
  </view>
</view>
