/* ========== 容器 ========== */
.tournament-manage-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0f0f1a 0%, #1a1a2e 50%, #0d0d14 100%);
  position: relative;
  overflow: hidden;
}

/* ========== 顶部装饰 ========== */
.header-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  overflow: hidden;
  z-index: 0;
}

.decoration-circle {
  position: absolute;
  border-radius: 50%;
  filter: blur(80rpx);
  opacity: 0.4;
  animation: float 6s ease-in-out infinite;
}

.circle-1 {
  width: 400rpx;
  height: 400rpx;
  background: #7c3aed;
  top: -200rpx;
  right: -100rpx;
  animation-delay: 0s;
}

.circle-2 {
  width: 300rpx;
  height: 300rpx;
  background: #ec4899;
  top: -100rpx;
  left: -100rpx;
  animation-delay: 2s;
}

.circle-3 {
  width: 200rpx;
  height: 200rpx;
  background: #06b6d4;
  top: 50rpx;
  right: 50rpx;
  animation-delay: 4s;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-30rpx) scale(1.05);
  }
}

/* ========== 标题区域 ========== */
.header-section {
  position: relative;
  z-index: 1;
  padding: 60rpx 40rpx 30rpx 40rpx;
}

.title-container {
  text-align: center;
  margin-bottom: 30rpx;
}

.tournament-title {
  font-size: 52rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #a78bfa 0%, #7c3aed 50%, #c084fc 100%);
  background-clip: text;
  -webkit-background-clip: text;
  color: transparent;
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 20rpx rgba(124, 58, 237, 0.3);
}

.title-underline {
  width: 120rpx;
  height: 6rpx;
  background: linear-gradient(90deg, transparent, #7c3aed, transparent);
  margin: 16rpx auto 0;
  border-radius: 3rpx;
}

/* ========== 统计信息 ========== */
.stats-container {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 40rpx;
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 24rpx 40rpx;
  margin: 0 40rpx 30rpx 40rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #fff 0%, #a78bfa 100%);
  background-clip: text;
  -webkit-background-clip: text;
  color: transparent;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}

.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.2), transparent);
}

/* ========== 列表区域 ========== */
.tournament-list {
  height: calc(100vh - 480rpx);
  padding: 0 24rpx 140rpx 24rpx;
}

/* ========== 卡片 ========== */
.tournament-card {
  position: relative;
  margin-bottom: 24rpx;
  background: rgba(26, 26, 46, 0.6);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.tournament-card:active {
  transform: scale(0.98);
}

.card-accent {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
}

.card-accent.upcoming {
  background: linear-gradient(180deg, #22c55e, #4ade80);
  box-shadow: 0 0 20rpx rgba(34, 197, 94, 0.5);
}

.card-accent.ongoing {
  background: linear-gradient(180deg, #7c3aed, #a78bfa);
  box-shadow: 0 0 20rpx rgba(124, 58, 237, 0.5);
}

.card-accent.completed {
  background: linear-gradient(180deg, #e54545, #ff6b6b);
  box-shadow: 0 0 20rpx rgba(229, 69, 69, 0.5);
}

.card-content {
  padding: 28rpx 28rpx 28rpx 34rpx;
}

/* ========== 卡片头部 ========== */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  flex: 1;
  margin-right: 16rpx;
}

.status-badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  white-space: nowrap;
}

.status-badge.upcoming {
  background: linear-gradient(135deg, rgba(34, 197, 94, 0.2), rgba(74, 222, 128, 0.15));
  color: #4ade80;
  border: 1rpx solid rgba(34, 197, 94, 0.3);
}

.status-badge.ongoing {
  background: linear-gradient(135deg, rgba(124, 58, 237, 0.2), rgba(167, 139, 250, 0.15));
  color: #a78bfa;
  border: 1rpx solid rgba(124, 58, 237, 0.3);
}

.status-badge.completed {
  background: linear-gradient(135deg, rgba(229, 69, 69, 0.2), rgba(255, 107, 107, 0.15));
  color: #ff6b6b;
  border: 1rpx solid rgba(229, 69, 69, 0.3);
}

/* ========== 元信息 ========== */
.card-meta {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.meta-icon {
  font-size: 28rpx;
}

.meta-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* ========== 标签 ========== */
.card-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tag {
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-type {
  background: linear-gradient(135deg, rgba(6, 182, 212, 0.15), rgba(34, 211, 238, 0.1));
  color: #22d3ee;
  border: 1rpx solid rgba(6, 182, 212, 0.25);
}

.tag-format {
  background: linear-gradient(135deg, rgba(251, 146, 60, 0.15), rgba(253, 186, 116, 0.1));
  color: #fb923c;
  border: 1rpx solid rgba(251, 146, 60, 0.25);
}

/* ========== 描述 ========== */
.card-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1.6;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

/* ========== 时间轴 ========== */
.status-timeline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 8rpx;
}

.timeline-item {
  display: flex;
  align-items: center;
  position: relative;
  flex: 1;
  white-space: nowrap;
}

.timeline-item:last-child {
  flex: 0;
}

.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.timeline-item.active .timeline-dot {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid;
  box-shadow: 0 0 12rpx currentColor;
}

.timeline-item.active.upcoming .timeline-dot {
  background: #22c55e;
  border-color: #22c55e;
  color: #22c55e;
}

.timeline-item.active:not(.completed) .timeline-dot {
  background: #7c3aed;
  border-color: #7c3aed;
  color: #7c3aed;
}

.timeline-item.active.completed .timeline-dot {
  background: #e54545;
  border-color: #e54545;
  color: #e54545;
}

.timeline-item.completed .timeline-dot {
  background: #22c55e;
  border-color: #4ade80;
  opacity: 0.6;
}

.timeline-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-left: 10rpx;
  transition: all 0.3s ease;
  white-space: nowrap;
}

.timeline-item.active .timeline-text {
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
  font-size: 22rpx;
}

.timeline-line {
  flex: 1;
  height: 3rpx;
  background: rgba(255, 255, 255, 0.1);
  margin: 0 6rpx;
  border-radius: 2rpx;
  transition: all 0.3s ease;
}

.timeline-item.completed + .timeline-item .timeline-line {
  background: linear-gradient(90deg, #22c55e, rgba(34, 197, 94, 0.3));
}

/* ========== 浮动按钮 ========== */
.fab-container {
  position: fixed;
  bottom: 60rpx;
  right: 40rpx;
  z-index: 100;
}

.fab-shadow {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100%;
  background: linear-gradient(135deg, #7c3aed, #a78bfa);
  filter: blur(20rpx);
  opacity: 0.6;
  border-radius: 50%;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    opacity: 0.6;
  }
  50% {
    transform: scale(1.1);
    opacity: 0.4;
  }
}

.fab-button {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 50%, #c084fc 100%);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(124, 58, 237, 0.5);
  transition: transform 0.3s ease;
}

.fab-button:active {
  transform: scale(0.9);
}

.fab-icon {
  font-size: 64rpx;
  color: #fff;
  line-height: 1;
  font-weight: 200;
}
