.tm-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: var(--space-5) var(--space-5) 200rpx;
}

/* ============================================================
 * HEAD
 * ============================================================ */
.tm-head {
  margin-bottom: var(--space-6);
}

.head-tapes {
  margin-bottom: var(--space-4);
}

.head-titles {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
}

.head-title-zh {
  font-size: 64rpx;
  font-weight: 900;
  color: var(--color-ink);
  line-height: 0.95;
  letter-spacing: -0.01em;
}

.head-title-en {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--color-muted-2);
  letter-spacing: 0.08em;
}

/* ============================================================
 * SECTION
 * ============================================================ */
.tm-section {
  margin-bottom: var(--space-6);
}

.section-head {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.section-count {
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: var(--color-muted);
  margin-left: auto;
  text-transform: uppercase;
}

/* ============================================================
 * DRAFT
 * ============================================================ */
.draft-list {
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-md);
  background: var(--color-bg);
  overflow: hidden;
}

.draft-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-4) var(--space-5);
  border-bottom: 1rpx solid var(--color-border);
}

.draft-row:last-child { border-bottom: 0; }

.draft-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.draft-name {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-ink);
  letter-spacing: 0.01em;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.draft-meta {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-muted);
  letter-spacing: 0.04em;
}

.draft-arrow {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--color-ink);
}

/* ============================================================
 * QUEUE
 * ============================================================ */
.queue-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.queue-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-4) var(--space-5);
  background: var(--color-lime);
  border-radius: var(--radius-md);
  box-shadow: 4rpx 4rpx 0 var(--color-ink);
}

.queue-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.queue-name {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-ink);
  letter-spacing: 0.01em;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.queue-meta {
  font-size: 22rpx;
  font-weight: 800;
  color: var(--color-ink-3);
  letter-spacing: 0.04em;
}

.queue-arrow {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--color-ink);
}

/* ============================================================
 * TOURNAMENT LIST
 * ============================================================ */
.tournament-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.tournament-card {
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.tc-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding: var(--space-4) var(--space-5);
  background: var(--color-ink);
  color: var(--color-bg);
}

.tc-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: -0.01em;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tc-status {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: var(--radius-sm);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.tc-status.status-upcoming { background: var(--color-bg-3); color: var(--color-ink); }
.tc-status.status-ongoing,
.tc-status.status-live { background: var(--color-lime); color: var(--color-ink); }
.tc-status.status-completed { background: var(--color-bg); color: var(--color-muted); }

.tc-body {
  padding: var(--space-4) var(--space-5);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.tc-row {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
}

.tc-label {
  flex-shrink: 0;
  width: 116rpx;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-muted);
}

.tc-val {
  flex: 1;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-ink);
  letter-spacing: 0.01em;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tc-desc {
  margin-top: var(--space-2);
  font-size: 22rpx;
  color: var(--color-muted);
  line-height: 1.5;
}

.tc-actions {
  display: flex;
  gap: 0;
  border-top: 1rpx solid var(--color-border);
}

.tc-action {
  flex: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-4) 0;
  background: var(--color-bg);
  font-size: 26rpx;
  font-weight: 800;
  letter-spacing: 0.04em;
  color: var(--color-ink);
}

.tc-action + .tc-action {
  border-left: 1rpx solid var(--color-border);
}

.tc-action-primary {
  background: var(--color-ink);
  color: var(--color-bg);
}

.tc-action:active { background: var(--color-bg-3); }
.tc-action-primary:active { background: var(--color-ink-2); }

/* ============================================================
 * FAB
 * ============================================================ */
.fab {
  position: fixed;
  right: var(--space-5);
  bottom: calc(var(--space-7) + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: 24rpx 32rpx;
  background: var(--color-ink);
  color: var(--color-bg);
  border-radius: var(--radius-pill);
  box-shadow: 6rpx 6rpx 0 var(--color-lime);
  font-size: 28rpx;
  font-weight: 900;
  letter-spacing: 0.04em;
  z-index: 50;
}

.fab-plus {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--color-lime);
}

.fab-text {
  font-weight: 900;
}
