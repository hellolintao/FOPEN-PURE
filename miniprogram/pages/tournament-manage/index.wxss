/* ========== 容器 ========== */
.tournament-manage-container {
  min-height: 100vh;
  background: #f7f7f7;
  position: relative;
}

/* ========== 列表区域 ========== */
.tournament-manage-container {
  padding: 0 24rpx 140rpx 24rpx;
}

/* ========== 卡片 ========== */
.tournament-card {
  position: relative;
  margin-bottom: 24rpx;
  background: #ffffff;
  border-radius: 8rpx;
  overflow: hidden;
  transition: all 0.3s ease;
}

.tournament-card:active {
  transform: scale(0.98);
}

.card-accent {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
}

.card-accent.upcoming {
  background: #333333;
}

.card-accent.ongoing {
  background: #333333;
}

.card-accent.completed {
  background: #999999;
}

.card-content {
  padding: 28rpx 28rpx 28rpx 34rpx;
}

/* ========== 卡片头部 ========== */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
  flex: 1;
  margin-right: 16rpx;
}

.status-badge {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 400;
  white-space: nowrap;
}

.status-badge.upcoming {
  background: #f5f5f5;
  color: #666666;
}

.status-badge.ongoing {
  background: #333333;
  color: #ffffff;
}

.status-badge.completed {
  background: #f5f5f5;
  color: #999999;
}

/* ========== 元信息 ========== */
.card-meta {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #999999;
}

/* ========== 标签 ========== */
.card-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tag {
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 400;
}

.tag-type {
  background: #f5f5f5;
  color: #666666;
}

.tag-format {
  background: #f5f5f5;
  color: #666666;
}

/* ========== 描述 ========== */
.card-desc {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* ========== 时间轴 ========== */
.status-timeline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 8rpx;
}

.timeline-item {
  display: flex;
  align-items: center;
  position: relative;
  flex: 1;
  white-space: nowrap;
}

.timeline-item:last-child {
  flex: 0;
}

.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #e0e0e0;
  border: 2rpx solid #e0e0e0;
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.timeline-item.active .timeline-dot {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid;
  box-shadow: 0 0 12rpx currentColor;
}

.timeline-item.active.upcoming .timeline-dot {
  background: #333333;
  border-color: #333333;
  color: #333333;
}

.timeline-item.active:not(.completed) .timeline-dot {
  background: #333333;
  border-color: #333333;
  color: #333333;
}

.timeline-item.active.completed .timeline-dot {
  background: #333333;
  border-color: #333333;
  color: #333333;
}

.timeline-item.completed .timeline-dot {
  background: #333333;
  border-color: #999999;
  opacity: 0.6;
}

.timeline-text {
  font-size: 20rpx;
  color: #cccccc;
  margin-left: 10rpx;
  transition: all 0.3s ease;
  white-space: nowrap;
}

.timeline-item.active .timeline-text {
  color: #333333;
  font-weight: 500;
  font-size: 22rpx;
}

.timeline-line {
  flex: 1;
  height: 3rpx;
  background: #e0e0e0;
  margin: 0 6rpx;
  border-radius: 2rpx;
  transition: all 0.3s ease;
}

.timeline-item.completed + .timeline-item .timeline-line {
  background: #333333;
}

.fab-button {
  margin: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: #333333;
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 400;
}

/* ========== 操作按钮 ========== */
.card-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  color: #333333;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 0;
  margin: 0;
}

.action-btn::after {
  border: none;
}