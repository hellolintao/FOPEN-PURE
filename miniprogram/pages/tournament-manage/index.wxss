.status-btn-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
  width: 100%;
  box-sizing: border-box;
}
.status-btn {
  flex: 1 1 0;
  min-width: 0;
  padding: 0 8rpx;
  height: 44rpx;
  line-height: 44rpx;
  font-size: 24rpx;
  border-radius: 12rpx;
  border: none;
  font-weight: 500;
  background: linear-gradient(135deg, #1a1a2e 0%, #16162a 100%);
  color: #aaa;
  transition: background 0.2s, color 0.2s, transform 0.2s, box-shadow 0.2s;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
}
.status-btn.active[data-status="upcoming"], .status-btn.active.upcoming {
  background: linear-gradient(135deg, #22c55e 0%, #4ade80 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(34,197,94,0.3);
}
.status-btn.active[data-status="ongoing"], .status-btn.active.ongoing {
  background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(124,58,237,0.3);
}
.status-btn.active[data-status="completed"], .status-btn.active.completed {
  background: linear-gradient(135deg, #e54545 0%, #ff5c5c 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(229,69,69,0.3);
}
.btn-actions-row {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  margin-top: 8rpx;
  justify-content: flex-start;
  width: auto;
}
.btn-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}
.mini-btn {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  font-size: 18rpx;
  border: none;
  font-weight: 500;
  padding: 0;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}
.edit-btn {
  background: #7c3aed;
  color: #FFFFFF;
}
.delete-btn {
  background: #e54545;
  color: #FFFFFF;
}
.tournament-manage-container {
  background: linear-gradient(180deg, #101017 0%, #0d0d14 100%);
  min-height: 100vh;
  color: #FFFFFF;
  padding: 40rpx 0;
}
.tournament-title {
  font-size: 44rpx;
  color: #7c3aed;
  text-align: center;
  margin-bottom: 48rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 12rpx rgba(124,58,237,0.3);
}
.tournament-item {
  background: linear-gradient(135deg, #1a1a2e 0%, #16162a 100%);
  border-radius: 20rpx;
  margin: 0 40rpx 32rpx 40rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(124,58,237,0.12), inset 0 1rpx 0 rgba(255,255,255,0.05);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.tournament-info {
  margin-bottom: 18rpx;
}
.tournament-name {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: bold;
  margin-bottom: 12rpx;
}
.tournament-meta {
  color: #aaa;
  font-size: 26rpx;
  display: flex;
  gap: 32rpx;
  margin-bottom: 6rpx;
}
.tournament-desc {
  color: #aaa;
  font-size: 26rpx;
  margin-top: 8rpx;
}
.tournament-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}
.tournament-btn {
  background: #222;
  color: #FFFFFF;
  border: none;
  border-radius: 16rpx;
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  font-weight: 500;
  transition: background 0.2s, transform 0.2s;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
}
.tournament-btn:active {
  transform: scale(0.95);
}
.status-radio-row {
  display: flex;
  gap: 32rpx;
  align-items: center;
  margin-bottom: 8rpx;
}
.radio-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.radio-label {
  font-size: 26rpx;
  color: #FFFFFF;
}
.btn-actions-row {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  margin-top: 8rpx;
  width: 100%;
  justify-content: flex-end;
  box-sizing: border-box;
}
.mini-btn {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  font-size: 18rpx;
  border: none;
  font-weight: 500;
  padding: 0;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}
.edit-btn {
  background: #7c3aed;
  color: #FFFFFF;
}
.delete-btn {
  background: #e54545;
  color: #FFFFFF;
}
.tournament-btn.delete {
  background: linear-gradient(135deg, #e54545 0%, #ff5c5c 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(229,69,69,0.3);
}
.add-btn-bar {
  margin: 48rpx 0 0 0;
  text-align: center;
}
.add-btn {
  background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 32rpx;
  padding: 0 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 32rpx rgba(124,58,237,0.4);
  transition: transform 0.2s, box-shadow 0.2s;
}
.add-btn:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 16rpx rgba(124,58,237,0.3);
}
.dialog-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dialog {
  background: linear-gradient(135deg, #1a1a2e 0%, #16162a 100%);
  border-radius: 24rpx;
  padding: 48rpx 32rpx 32rpx 32rpx;
  width: 80vw;
  max-width: 600rpx;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.5);
}
.dialog-title {
  font-size: 32rpx;
  color: #7c3aed;
  margin-bottom: 32rpx;
  text-align: center;
}
.dialog-input {
  width: 100%;
  background: #181828;
  border: none;
  border-radius: 12rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 24rpx;
}
.dialog-actions {
  display: flex;
  justify-content: flex-end;
  gap: 32rpx;
}
.dialog-btn {
  background: #222;
  color: #FFFFFF;
  border: none;
  border-radius: 16rpx;
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  font-weight: 500;
}
.dialog-btn.primary {
  background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(124,58,237,0.3);
}
