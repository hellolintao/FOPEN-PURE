<view class="tournament-manage-container">
  <button class="fab-button" bindtap="onAddTournament">
      添加赛事
    </button>

  <!-- 我的草稿 -->
  <view wx:if="{{drafts.length > 0}}" class="drafts-block">
    <text class="block-title">我的草稿</text>
    <view wx:for="{{drafts}}" wx:key="_id" class="draft-row" bindtap="onResumeDraft" data-id="{{item._id}}">
      <text class="draft-name">{{item.name || '未命名'}}</text>
      <text class="text-meta">{{item.startDate || '—'}}</text>
    </view>
  </view>

  <!-- 待确认比分（admin） -->
  <view wx:if="{{isAdmin && submittedQueue.length > 0}}" class="queue-block">
    <text class="block-title">待确认比分</text>
    <view wx:for="{{submittedQueue}}" wx:key="tournamentId" class="queue-row" bindtap="onOpenScore" data-id="{{item.tournamentId}}">
      <view class="queue-info">
        <text class="queue-name">{{item.tournamentName}}</text>
        <text class="text-meta">{{item.submittedCount}} 场待确认</text>
      </view>
      <text class="queue-arrow">›</text>
    </view>
  </view>

  <block wx:for="{{tournamentList}}" wx:key="_id">
    <view class="tournament-card" bindtap="onEditTournament" data-id="{{item._id}}">
      <!-- 卡片左侧装饰条 -->
      <view class="card-accent {{item.status === 'upcoming' ? 'upcoming' : item.status === 'ongoing' ? 'ongoing' : 'completed'}}"></view>

      <!-- 卡片内容 -->
      <view class="card-content">
        <!-- 标题和状态 -->
        <view class="card-header">
          <view class="card-name">{{item.name}}</view>
          <!-- <view class="status-badge {{item.status === 'upcoming' ? 'upcoming' : item.status === 'ongoing' ? 'ongoing' : 'completed'}}">
            {{item.status === 'upcoming' ? '待开始' : item.status === 'ongoing' ? '进行中' : '已结束'}}
          </view> -->
        </view>

        <!-- 元信息 -->
        <view class="card-meta">
          <view class="meta-item">
            <text class="meta-icon">🏆</text>
            <text class="meta-text">{{item.seasonName || '未设置赛季'}}</text>
          </view>
          <view class="meta-item">
            <text class="meta-icon">📅</text>
            <text class="meta-text">{{item.startDate}}</text>
          </view>
        </view>

        <!-- 类型标签 -->
        <view class="card-tags">
          <view class="tag tag-type">{{item.type === 'doubles' ? '双打' : '单打'}}</view>
          <view class="tag tag-format">{{item.format === 'knockout' ? '淘汰赛' : '常规赛'}}</view>
        </view>

        <!-- 描述 -->
        <view class="card-desc" wx:if="{{item.description}}">{{item.description}}</view>

        <!-- 操作按钮 -->
        <view class="card-actions" catchtap="onStopPropagation">
          <button class="action-btn" catchtap="onAddPlayer" data-id="{{item._id}}" data-type="{{item.type}}">参赛人员</button>
          <button class="action-btn" catchtap="onViewBrackets" data-id="{{item._id}}" data-type="{{item.type}}">对位表</button>
        </view>
      </view>
    </view>
  </block>

</view>
