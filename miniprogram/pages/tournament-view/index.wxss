.tournament-view-container {
  min-height: 100vh;
  background: var(--color-bg);
  padding: var(--space-5) var(--space-5) 160rpx;
}

.loading {
  padding: var(--space-9) 0;
  text-align: center;
  color: var(--color-muted);
  font-size: var(--font-body-size);
}

.content-wrapper {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

/* ============================================================
 * SECTION CARD
 * ============================================================ */
.section-card {
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-md);
  padding: var(--space-5);
}

.section-title,
.section-title-with-action {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0.16em;
  color: var(--color-ink);
  text-transform: uppercase;
  padding-bottom: var(--space-3);
  border-bottom: 2rpx solid var(--color-ink);
  margin-bottom: var(--space-4);
  justify-content: space-between;
}

.section-subtitle {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-muted);
  margin: var(--space-3) 0 var(--space-2);
}

.detail-btn {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  background: var(--color-ink);
  color: var(--color-bg);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 0.08em;
}

/* ============================================================
 * INFO ITEM
 * ============================================================ */
.info-item {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: var(--space-3);
  padding: var(--space-3) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.info-item:last-child { border-bottom: 0; }

.info-label {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-muted);
}

.info-value {
  flex: 1;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-ink);
  text-align: right;
  letter-spacing: 0.01em;
}

/* ============================================================
 * EMPTY
 * ============================================================ */
.empty-tip {
  padding: var(--space-6) 0;
  text-align: center;
  color: var(--color-muted);
  font-size: var(--font-body-size);
}

/* ============================================================
 * PLAYER LIST
 * ============================================================ */
.player-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-2);
}

.player-item {
  padding: var(--space-3);
  background: var(--color-bg-3);
  border-radius: var(--radius-sm);
}

.team-info { margin-bottom: 4rpx; }

.team-name {
  font-size: 22rpx;
  font-weight: 800;
  color: var(--color-ink);
  letter-spacing: 0.02em;
}

.player-info {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-2);
}

.player-name {
  flex: 1;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.player-seed {
  flex-shrink: 0;
  font-family: var(--font-family-num);
  font-size: 22rpx;
  font-weight: 900;
  color: var(--color-ink);
  padding: 2rpx 8rpx;
  background: var(--color-lime);
  border-radius: var(--radius-sm);
}

/* ============================================================
 * COURTS / SCHEDULE
 * ============================================================ */
.courts-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.court-block {
  background: var(--color-bg-3);
  border-radius: var(--radius-sm);
  padding: var(--space-3) var(--space-4);
}

.court-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: var(--space-2);
  border-bottom: 1rpx solid var(--color-border);
  margin-bottom: var(--space-2);
}

.court-title {
  font-size: 26rpx;
  font-weight: 900;
  color: var(--color-ink);
  letter-spacing: 0.02em;
}

.court-meta {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--color-muted);
}

.court-empty {
  padding: var(--space-3) 0;
  text-align: center;
  color: var(--color-muted);
  font-size: 22rpx;
}

.court-match-row {
  display: grid;
  grid-template-columns: 1fr auto 1fr auto;
  align-items: center;
  gap: var(--space-2);
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.court-match-row:last-child { border-bottom: 0; }

.court-player {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.court-vs {
  font-family: var(--font-family-num);
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 0.16em;
  color: var(--color-muted-2);
}

.court-freeplay {
  grid-template-columns: 1fr auto;
}

.court-chip {
  display: inline-flex;
  align-items: center;
  height: 30rpx;
  padding: 0 10rpx;
  border-radius: var(--radius-sm);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.court-chip.chip-pending { background: var(--color-bg); color: var(--color-muted); }
.court-chip.chip-submitted { background: var(--color-ink); color: var(--color-bg); }
.court-chip.chip-confirmed { background: var(--color-lime); color: var(--color-ink); }
.court-chip.chip-disputed { background: var(--color-danger); color: var(--color-bg); }

/* ============================================================
 * BRACKETS (later rounds)
 * ============================================================ */
.brackets-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.bracket-item {
  background: var(--color-bg-3);
  border-radius: var(--radius-sm);
  padding: var(--space-3) var(--space-4);
}

.bracket-header {
  padding-bottom: var(--space-2);
  border-bottom: 1rpx solid var(--color-border);
  margin-bottom: var(--space-2);
}

.bracket-title {
  font-size: 24rpx;
  font-weight: 900;
  color: var(--color-ink);
  letter-spacing: 0.04em;
}

.match-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.match-item {
  display: grid;
  grid-template-columns: 96rpx 1fr;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-2) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.match-item:last-child { border-bottom: 0; }

.match-position {
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-muted);
}

.position-text {
  font-family: var(--font-family-num);
}

.match-content {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: var(--space-2);
}

.match-player {
  min-width: 0;
}

.player-status {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  display: block;
}

.player-status.winner {
  color: var(--color-ink);
  font-weight: 900;
  background: var(--color-lime);
  padding: 4rpx 8rpx;
  border-radius: var(--radius-sm);
  display: inline-block;
}

.vs-text {
  font-family: var(--font-family-num);
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 0.16em;
  color: var(--color-muted-2);
}
