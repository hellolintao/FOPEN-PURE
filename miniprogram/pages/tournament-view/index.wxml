<view class="tournament-view-container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- 赛事详情内容 -->
  <view wx:else class="content-wrapper">
    <!-- 基本信息卡片 -->
    <view class="section-card">
      <view class="section-title">基本信息</view>

      <view class="info-item">
        <text class="info-label">赛事名称</text>
        <text class="info-value">{{tournament.name}}</text>
      </view>

      <view class="info-item">
        <text class="info-label">所属赛季</text>
        <text class="info-value">{{seasonName || '未设置'}}</text>
      </view>

      <view class="info-item">
        <text class="info-label">开始日期</text>
        <text class="info-value">{{tournament.startDate}}</text>
      </view>

      <!-- <view class="info-item">
        <text class="info-label">结束日期</text>
        <text class="info-value">{{tournament.endDate}}</text>
      </view>

      <view class="info-item">
        <text class="info-label">场地名称</text>
        <text class="info-value">{{tournament.location}}</text>
      </view> -->

      <view class="info-item">
        <text class="info-label">赛事类型</text>
        <text class="info-value">{{tournament.type === 'singles' ? '单打' : '双打'}}</text>
      </view>

      <view class="info-item" wx:if="{{tournament.description}}">
        <text class="info-label">赛事描述</text>
        <text class="info-value">{{tournament.description}}</text>
      </view>
    </view>

    <!-- 赛事配置卡片 -->
    <view class="section-card">
      <view class="section-title">赛事配置</view>

      <view class="info-item">
        <text class="info-label">最大参赛人数</text>
        <text class="info-value">{{tournamentDisplay.maxPlayers}}</text>
      </view>

      <view class="info-item">
        <text class="info-label">总轮数</text>
        <text class="info-value">{{tournamentDisplay.totalRounds}}</text>
      </view>

      <view class="info-item">
        <text class="info-label">每场比赛人数</text>
        <text class="info-value">{{tournamentDisplay.playersPerMatch}}</text>
      </view>

      <view class="info-item">
        <text class="info-label">赛制</text>
        <text class="info-value">{{tournamentDisplay.formatText}}</text>
      </view>

      <view class="info-item">
        <text class="info-label">当前轮次</text>
        <text class="info-value">第{{tournamentDisplay.currentRound}}轮</text>
      </view>
    </view>

    <!-- 积分规则卡片 -->
    <view class="section-card">
      <view class="section-title">积分规则</view>

      <view class="info-item" wx:if="{{tournamentDisplay.pointsMode !== 'placement'}}">
        <text class="info-label">胜利积分</text>
        <text class="info-value">{{tournamentDisplay.win || 0}}</text>
      </view>

      <view class="info-item" wx:if="{{tournamentDisplay.pointsMode !== 'placement'}}">
        <text class="info-label">失败积分</text>
        <text class="info-value">{{tournamentDisplay.loss || 0}}</text>
      </view>

      <view class="info-item" wx:if="{{tournamentDisplay.walkover !== undefined}}">
        <text class="info-label">弃权积分</text>
        <text class="info-value">{{tournamentDisplay.walkover || 0}}</text>
      </view>

      <view class="bonus-list" wx:if="{{tournamentDisplay.pointsMode === 'placement'}}">
        <view class="section-subtitle">名次积分</view>

        <view class="info-item" wx:for="{{tournamentDisplay.placementRows}}" wx:key="label">
          <text class="info-label">{{item.label}}</text>
          <text class="info-value">{{item.value}}</text>
        </view>
      </view>

      <view class="bonus-list" wx:if="{{tournamentDisplay.bonusRows.length > 0}}">
        <view class="section-subtitle">轮次奖励积分</view>

        <view class="info-item" wx:for="{{tournamentDisplay.bonusRows}}" wx:key="label">
          <text class="info-label">{{item.label}}</text>
          <text class="info-value">{{item.value}}</text>
        </view>
      </view>
    </view>

    <!-- 参赛人员卡片 -->
    <view class="section-card">
      <view class="section-title">参赛人员</view>

      <view wx:if="{{registrations.length === 0}}" class="empty-tip">
        <text>暂无参赛人员</text>
      </view>

      <view wx:else class="player-list">
        <view wx:for="{{registrations}}" wx:key="_id" class="player-item">
          <view wx:if="{{item.teamName}}" class="team-info">
            <text class="team-name">{{item.teamName}}</text>
          </view>
          <view class="player-info">
            <text class="player-name">{{item.playerName}} {{item.partnerName}}</text>
            <text class="player-seed" wx:if="{{item.seed}}">#{{item.seed}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 首轮排程卡片（按场地分组） -->
    <view class="section-card">
      <view class="section-title-with-action">
        <text class="section-title">首轮排程</text>
        <view class="detail-btn" bindtap="onViewRoundSettlement">
          <text>详情</text>
        </view>
      </view>

      <view wx:if="{{decoratedCourts.length === 0}}" class="empty-tip">
        <text>尚未配置排程</text>
      </view>

      <view wx:else class="courts-list">
        <view wx:for="{{decoratedCourts}}" wx:for-item="court" wx:key="courtId" class="court-block">
          <view class="court-head">
            <text class="court-title">{{court.name}}</text>
            <text class="court-meta">{{court.slotCount}} 个时段</text>
          </view>

          <view wx:if="{{court.matches.length === 0 && court.freePlays.length === 0}}" class="court-empty">
            <text>无比赛</text>
          </view>

          <view wx:for="{{court.matches}}" wx:for-item="m" wx:key="matchId" class="court-match-row">
            <text class="court-player">{{m.__player1Name}}</text>
            <text class="court-vs">VS</text>
            <text class="court-player">{{m.__player2Name}}</text>
            <text class="court-chip chip-{{m.resultStatus}}">{{m.bye ? '轮空' : m.resultStatus}}</text>
          </view>

          <view wx:for="{{court.freePlays}}" wx:for-item="fp" wx:key="_id" class="court-match-row court-freeplay">
            <text>自由拉球</text>
            <text class="court-meta">{{fp.playerIds.length}} 人</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 后续轮次（只读列表） -->
    <view class="section-card" wx:if="{{brackets.length > 1}}">
      <view class="section-title">后续轮次</view>
      <view class="brackets-list">
        <view wx:for="{{brackets}}" wx:key="_id" class="bracket-item" wx:if="{{item.round > 1}}">
          <view class="bracket-header">
            <text class="bracket-title">第{{item.round}}轮</text>
          </view>
          <view class="match-list">
            <view wx:for="{{item.matches}}" wx:for-item="match" wx:for-index="matchIndex" wx:key="matchId" class="match-item">
              <view class="match-position">
                <text class="position-text">第{{matchIndex + 1}}场</text>
              </view>
              <view class="match-content">
                <view class="match-player">
                  <text class="player-status {{match.winner === 1 ? 'winner' : ''}}">{{match.__player1Name}}</text>
                </view>
                <text class="vs-text">VS</text>
                <view class="match-player">
                  <text class="player-status {{match.winner === 2 ? 'winner' : ''}}">{{match.__player2Name}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
