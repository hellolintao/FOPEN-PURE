.season-manage-container {
  background: #101017;
  min-height: 100vh;
  color: #FFFFFF;
  padding: 40rpx 0;
}
.season-title {
  font-size: 40rpx;
  color: #7c3aed;
  text-align: center;
  margin-bottom: 48rpx;
}
.season-item {
  background: #181828;
  border-radius: 20rpx;
  margin: 0 40rpx 32rpx 40rpx;
  padding: 32rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 24rpx rgba(124,58,237,0.08);
}
.season-info {
  flex: 1;
}
.season-name {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: bold;
  margin-bottom: 12rpx;
}
.season-meta {
  color: #aaa;
  font-size: 26rpx;
  display: flex;
  gap: 32rpx;
}
.season-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-left: 32rpx;
}
.season-btn {
  background: #222;
  color: #FFFFFF;
  border: none;
  border-radius: 16rpx;
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  font-weight: 500;
  transition: background 0.2s;
}
.season-btn.delete {
  background: #e54545;
  color: #FFFFFF;
}
.season-btn.edit {
  background: linear-gradient(90deg, #7c3aed 0%, #a78bfa 100%);
  color: #FFFFFF;
}
.add-btn-bar {
  margin: 48rpx 0 0 0;
  text-align: center;
}
.add-btn {
  background: linear-gradient(90deg, #7c3aed 0%, #a78bfa 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 32rpx;
  padding: 0 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 24rpx rgba(124,58,237,0.08);
}
.dialog-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dialog {
  background: #22223a;
  border-radius: 24rpx;
  padding: 48rpx 32rpx 32rpx 32rpx;
  width: 80vw;
  max-width: 600rpx;
}
.dialog-title {
  font-size: 32rpx;
  color: #7c3aed;
  margin-bottom: 32rpx;
  text-align: center;
}
.dialog-input {
  width: 100%;
  background: #181828;
  border: none;
  border-radius: 12rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 24rpx;
}
.dialog-actions {
  display: flex;
  justify-content: flex-end;
  gap: 32rpx;
}
.dialog-btn {
  background: #222;
  color: #FFFFFF;
  border: none;
  border-radius: 16rpx;
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  font-weight: 500;
}
.dialog-btn.primary {
  background: linear-gradient(90deg, #7c3aed 0%, #a78bfa 100%);
  color: #FFFFFF;
}
