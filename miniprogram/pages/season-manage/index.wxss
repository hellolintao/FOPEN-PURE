.sm-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: var(--space-5) var(--space-5) 200rpx;
}

/* ============================================================
 * HEAD
 * ============================================================ */
.sm-head {
  margin-bottom: var(--space-6);
}

.head-tapes {
  margin-bottom: var(--space-4);
}

.head-titles {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
}

.head-title-zh {
  font-size: 64rpx;
  font-weight: 900;
  color: var(--color-ink);
  line-height: 0.95;
  letter-spacing: -0.01em;
}

.head-title-en {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--color-muted-2);
  letter-spacing: 0.08em;
}

/* ============================================================
 * LIST
 * ============================================================ */
.season-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  margin-bottom: var(--space-7);
}

.season-card {
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.season-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding: var(--space-4) var(--space-5);
  background: var(--color-ink);
  color: var(--color-bg);
}

.season-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: -0.01em;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.season-status {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: var(--radius-sm);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.season-status.status-live { background: var(--color-lime); color: var(--color-ink); }
.season-status.status-ended { background: var(--color-bg-3); color: var(--color-muted); }

.season-card-body {
  padding: var(--space-4) var(--space-5);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.season-row {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
}

.season-row-label {
  width: 88rpx;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.16em;
  color: var(--color-muted);
  text-transform: uppercase;
}

.season-row-val {
  flex: 1;
  font-size: 26rpx;
  font-weight: 800;
  color: var(--color-ink);
}

.season-card-actions {
  display: flex;
  gap: var(--space-2);
  padding: var(--space-3) var(--space-5);
  border-top: 1rpx solid var(--color-border);
  background: var(--color-bg-3);
  justify-content: flex-end;
}

.season-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.season-btn-ghost {
  background: var(--color-bg);
  color: var(--color-danger);
  border: 1rpx solid var(--color-danger);
}

.season-btn-primary {
  background: var(--color-ink);
  color: var(--color-bg);
}

/* ============================================================
 * ADD BTN
 * ============================================================ */
.add-btn-bar {
  margin-top: var(--space-5);
}

.add-btn {
  width: 100%;
  padding: var(--space-5) 0;
  font-size: 30rpx;
  font-weight: 800;
}

/* ============================================================
 * DIALOG
 * ============================================================ */
.dialog-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(11, 12, 9, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog {
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-lg);
  padding: var(--space-6);
  width: 84vw;
  max-width: 640rpx;
  box-shadow: 8rpx 8rpx 0 var(--color-ink);
}

.dialog-head {
  margin-bottom: var(--space-4);
}

.dialog-title {
  display: block;
  font-size: 40rpx;
  font-weight: 900;
  color: var(--color-ink);
  letter-spacing: -0.01em;
  margin-bottom: var(--space-5);
}

.dialog-input {
  width: 100%;
  background: var(--color-bg-3);
  border-radius: var(--radius-sm);
  color: var(--color-ink);
  font-size: 28rpx;
  font-weight: 700;
  padding: 0 24rpx;
  min-height: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin-bottom: var(--space-3);
  box-sizing: border-box;
}

.dialog-input.picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  line-height: 1;
}

.dialog-placeholder {
  color: var(--color-muted-2);
  font-weight: 600;
}

.picker-val {
  color: var(--color-ink);
  font-weight: 800;
}

.picker-arrow {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--color-ink);
}

.dialog-actions {
  display: flex;
  gap: var(--space-3);
  margin-top: var(--space-4);
}

.dialog-btn {
  flex: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx 0;
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.dialog-btn-ghost {
  background: var(--color-bg);
  color: var(--color-ink);
  border: 2rpx solid var(--color-ink);
}

.dialog-btn-primary {
  background: var(--color-ink);
  color: var(--color-bg);
}
