.season-manage-container {
  background: #f7f7f7;
  min-height: 100vh;
  color: #333333;
  padding: 40rpx 0;
}
.season-title {
  font-size: 44rpx;
  color: #333333;
  text-align: center;
  margin-bottom: 48rpx;
  font-weight: 600;
}
.season-item {
  background: #ffffff;
  border-radius: 8rpx;
  margin: 0 40rpx 0 40rpx;
  padding: 32rpx 24rpx;
  display: flex;
  align-items: center;
}
.season-info {
  flex: 1;
}
.season-name {
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 12rpx;
}
.season-meta {
  color: #999999;
  font-size: 26rpx;
  display: flex;
  gap: 32rpx;
}
.season-actions-row {
  background: #ffffff;
  margin: 0 40rpx 32rpx 40rpx;
  padding: 16rpx 24rpx;
  border-radius: 0 0 8rpx 8rpx;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  margin-top: -16rpx;
}
.season-btn {
  background: #f5f5f5;
  color: #666666;
  border: none;
  border-radius: 8rpx;
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  font-weight: 400;
  transition: all 0.2s;
}
.season-btn.delete {
  color: #999999;
}
.season-btn.delete:active {
  background: #e8e8e8;
  color: #333333;
}
.season-btn.edit {
  background: #333333;
  color: #ffffff;
}
.season-btn.edit:active {
  opacity: 0.8;
}
.add-btn-bar {
  margin: 48rpx 40rpx 0 40rpx;
}
.add-btn {
  background: #333333;
  color: #ffffff;
  border: none;
  border-radius: 8rpx;
  padding: 24rpx;
  width: 100%;
  font-size: 28rpx;
  font-weight: 500;
}
.add-btn:active {
  opacity: 0.8;
}
.dialog-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dialog {
  background: #ffffff;
  border-radius: 8rpx;
  padding: 48rpx 32rpx 32rpx 32rpx;
  width: 80vw;
  max-width: 600rpx;
}
.dialog-title {
  font-size: 32rpx;
  color: #333333;
  margin-bottom: 32rpx;
  text-align: center;
  font-weight: 500;
}
.dialog-input {
  width: 100%;
  background: #f5f5f5;
  border: none;
  border-radius: 8rpx;
  color: #333333;
  font-size: 28rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 24rpx;
}

.dialog-input.picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
}

.dialog-input.picker:active {
  background: #e8e8e8;
}

.dialog-input.picker .placeholder {
  color: #999999;
}

.picker-arrow {
  font-size: 36rpx;
  color: #999999;
  margin-left: 16rpx;
}
.dialog-actions {
  display: flex;
  justify-content: flex-end;
  gap: 32rpx;
}
.dialog-btn {
  background: #f5f5f5;
  color: #333333;
  border: none;
  border-radius: 8rpx;
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  font-weight: 400;
}
.dialog-btn.primary {
  background: #333333;
  color: #ffffff;
}
