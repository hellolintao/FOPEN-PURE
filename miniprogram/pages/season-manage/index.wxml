<view class="sm-page">

  <!-- HEAD -->
  <view class="sm-head anim-stage-rise">
    <view class="head-tapes">
      <text class="tape tape-stamped">ADMIN · 赛季</text>
    </view>
    <view class="head-titles">
      <text class="head-title-zh">赛季管理</text>
      <text class="head-title-en num">SEASONS</text>
    </view>
  </view>

  <!-- LIST -->
  <view class="season-list">
    <view wx:for="{{seasonList}}" wx:key="_id" class="season-card anim-stage-rise">
      <view class="season-card-top">
        <text class="season-name">{{item.name}}</text>
        <text class="season-status status-{{item.status === 'active' ? 'live' : 'ended'}}">{{item.status === 'active' ? 'LIVE' : 'ENDED'}}</text>
      </view>
      <view class="season-card-body">
        <view class="season-row">
          <text class="season-row-label">START</text>
          <text class="season-row-val num">{{item.startDate}}</text>
        </view>
        <view class="season-row">
          <text class="season-row-label">END</text>
          <text class="season-row-val num">{{item.endDate}}</text>
        </view>
      </view>
      <view class="season-card-actions">
        <view class="season-btn season-btn-ghost tap-scale" bindtap="onDeleteSeason" data-id="{{item._id}}">删除</view>
        <view wx:if="{{item.status === 'active'}}" class="season-btn season-btn-primary tap-scale" bindtap="onEditSeason" data-id="{{item._id}}">编辑</view>
      </view>
    </view>
  </view>

  <!-- ADD BTN -->
  <view class="add-btn-bar">
    <view class="cta-lime add-btn tap-scale" bindtap="onAddSeason">
      <text>+ 新增赛季</text>
    </view>
  </view>

  <!-- ADD DIALOG -->
  <view wx:if="{{showAddDialog}}" class="dialog-mask" bindtap="onCancelAdd">
    <view class="dialog" catchtap="">
      <view class="dialog-head">
        <text class="tape tape-stamped">NEW SEASON</text>
      </view>
      <text class="dialog-title">新增赛季</text>
      <input class="dialog-input" placeholder="赛季名称" placeholder-class="dialog-placeholder" value="{{newSeason.name}}" bindinput="onInputName" />
      <picker mode="date" value="{{newSeason.startDate}}" bindchange="onPickStartDate">
        <view class="dialog-input picker">
          <text class="{{newSeason.startDate ? 'picker-val num' : 'dialog-placeholder'}}">{{newSeason.startDate || '选择开始日期'}}</text>
          <text class="picker-arrow num">→</text>
        </view>
      </picker>
      <picker mode="date" value="{{newSeason.endDate}}" bindchange="onPickEndDate">
        <view class="dialog-input picker">
          <text class="{{newSeason.endDate ? 'picker-val num' : 'dialog-placeholder'}}">{{newSeason.endDate || '选择结束日期'}}</text>
          <text class="picker-arrow num">→</text>
        </view>
      </picker>
      <view class="dialog-actions">
        <view class="dialog-btn dialog-btn-ghost tap-scale" bindtap="onCancelAdd">取消</view>
        <view class="dialog-btn dialog-btn-primary tap-scale" bindtap="onConfirmAdd">确定</view>
      </view>
    </view>
  </view>

  <!-- EDIT DIALOG -->
  <view wx:if="{{showEditDialog}}" class="dialog-mask" bindtap="onCancelEdit">
    <view class="dialog" catchtap="">
      <view class="dialog-head">
        <text class="tape tape-lime tape-stamped-lime">EDIT SEASON</text>
      </view>
      <text class="dialog-title">编辑赛季</text>
      <input class="dialog-input" placeholder="赛季名称" placeholder-class="dialog-placeholder" value="{{editSeason.name}}" bindinput="onEditInputName" />
      <picker mode="date" value="{{editSeason.startDate}}" bindchange="onEditPickStartDate">
        <view class="dialog-input picker">
          <text class="{{editSeason.startDate ? 'picker-val num' : 'dialog-placeholder'}}">{{editSeason.startDate || '选择开始日期'}}</text>
          <text class="picker-arrow num">→</text>
        </view>
      </picker>
      <picker mode="date" value="{{editSeason.endDate}}" bindchange="onEditPickEndDate">
        <view class="dialog-input picker">
          <text class="{{editSeason.endDate ? 'picker-val num' : 'dialog-placeholder'}}">{{editSeason.endDate || '选择结束日期'}}</text>
          <text class="picker-arrow num">→</text>
        </view>
      </picker>
      <view class="dialog-actions">
        <view class="dialog-btn dialog-btn-ghost tap-scale" bindtap="onCancelEdit">取消</view>
        <view class="dialog-btn dialog-btn-primary tap-scale" bindtap="onConfirmEdit">保存</view>
      </view>
    </view>
  </view>
</view>
