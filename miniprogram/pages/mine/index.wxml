<view class="mine-page">
  <view wx:if="{{isLogin}}">
    <view class="card-hero">
      <image class="big-avatar" src="{{userInfo.avatarUrl || '/images/icons/usercenter.png'}}" mode="aspectFill" />
      <text class="text-h2">{{userInfo.name}}</text>
      <text class="text-meta">{{totalPoints}} 分</text>
    </view>

    <view class="actions">
      <button class="cta-secondary full-width" bindtap="onEditProfile">编辑资料</button>
      <button class="cta-secondary full-width" bindtap="onMyMatch">我的比赛</button>
      <button class="cta-secondary full-width" bindtap="onSetting">设置</button>
    </view>
  </view>

  <view wx:else class="empty-state">
    <text class="text-h2">加入俱乐部</text>
    <text class="text-meta">登录后查看个人资料</text>
    <button class="cta-primary" style="margin-top: var(--space-5);" bindtap="onLogin">登录 / 注册</button>
  </view>
</view>
