<view class="mine-container">
  <!-- 用户信息 -->
  <view class="user-info">
    <image
      class="avatar"
      src="{{userInfo.avatarUrl || 'https://mmbiz.qpic.cn/mmbiz/icTdbqWNOwNRna42FI242Lcia07jQodd2FJGIYQfG0LAJGFxM4FbnQP6yfMxBgJ0F3YRqJCsl1PaL2XUIPcnYgicQ/132'}}"
      mode="aspectFill"
    />
    <view class="user-detail">
      <text class="user-name">{{userInfo.name || '未登录'}}</text>
      <text class="user-status">{{isLogin ? '已登录' : '未登录'}}</text>
    </view>
  </view>

  <!-- 登录按钮 -->
  <view wx:if="{{!isLogin}}" class="login-btn" bindtap="onLogin">
    <text class="login-icon">🔐</text>
    <text>微信一键登录</text>
  </view>

  <!-- 统计数据 -->
  <view wx:if="{{isLogin}}" class="stats-row">
    <view class="stat-item">
      <text class="stat-value">0</text>
      <text class="stat-label">我的比赛</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">0</text>
      <text class="stat-label">参与场次</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">0</text>
      <text class="stat-label">获得排名</text>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="menu-list">
    <view class="menu-item" bindtap="onMyMatch">
      <view class="menu-left">
        <view class="menu-icon my-match-icon">🏆</view>
        <view class="menu-text">
          <text class="menu-title">我的比赛</text>
          <text class="menu-desc">查看参与的赛事</text>
        </view>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="onEditProfile">
      <view class="menu-left">
        <view class="menu-icon edit-icon">✏️</view>
        <view class="menu-text">
          <text class="menu-title">编辑资料</text>
          <text class="menu-desc">完善个人信息</text>
        </view>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="onSetting">
      <view class="menu-left">
        <view class="menu-icon setting-icon">⚙️</view>
        <view class="menu-text">
          <text class="menu-title">设置</text>
          <text class="menu-desc">偏好和系统设置</text>
        </view>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 管理入口 -->
  <view wx:if="{{isAdmin}}" class="manage-btn" bindtap="onManage">
    <text class="manage-icon">🎯</text>
    <text>进入管理后台</text>
  </view>
</view>
