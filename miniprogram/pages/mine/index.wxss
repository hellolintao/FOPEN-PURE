.mine-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: var(--space-5) var(--space-5) 160rpx;
}

/* ============================================================
 * HERO
 * ============================================================ */
.mine-hero {
  background: var(--color-ink);
  border-radius: var(--radius-xl);
  padding: var(--space-7) var(--space-6);
  margin-bottom: var(--space-6);
  color: var(--color-bg);
  position: relative;
  overflow: hidden;
}

.mine-hero-tapes {
  margin-bottom: var(--space-5);
}

.mine-hero-tapes .tape {
  background: var(--color-bg);
  color: var(--color-ink);
}

.mine-hero-row {
  display: flex;
  align-items: center;
  gap: var(--space-5);
}

.mine-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--color-bg-2);
  border: 4rpx solid var(--color-lime);
  flex-shrink: 0;
}

.mine-hero-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  min-width: 0;
}

.mine-name {
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: -0.01em;
  color: var(--color-bg);
  line-height: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mine-points-row {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
}

.mine-points-num {
  font-size: 56rpx;
  font-weight: 900;
  color: var(--color-lime);
  line-height: 0.9;
  letter-spacing: -0.04em;
}

.mine-points-label {
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-muted-2);
}

/* ============================================================
 * ACTIONS
 * ============================================================ */
.mine-actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.action-tile {
  position: relative;
  display: flex;
  align-items: center;
  gap: var(--space-4);
  padding: var(--space-5) var(--space-6);
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-md);
}

.action-num {
  font-size: 24rpx;
  font-weight: 900;
  color: var(--color-muted);
  letter-spacing: 0.04em;
  min-width: 56rpx;
}

.action-text {
  flex: 1;
  font-size: 32rpx;
  font-weight: 900;
  color: var(--color-ink);
  letter-spacing: 0.02em;
}

.action-arrow {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--color-ink);
  line-height: 1;
}

/* ============================================================
 * ANON
 * ============================================================ */
.mine-anon {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: var(--space-9) var(--space-3);
  gap: var(--space-4);
}

.anon-tapes {
  margin-bottom: var(--space-4);
}

.anon-headline {
  font-size: 80rpx;
  font-weight: 900;
  color: var(--color-ink);
  line-height: 0.95;
  letter-spacing: -0.02em;
}

.anon-sub {
  font-size: var(--font-body-size);
  color: var(--color-muted);
  letter-spacing: 0.02em;
  line-height: 1.5;
}

.anon-cta {
  margin-top: var(--space-5);
  width: 100%;
  padding: var(--space-5) 0;
  font-size: 32rpx;
}
