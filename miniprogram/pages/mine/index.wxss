.mine-container {
	background: linear-gradient(180deg, #101017 0%, #0d0d14 100%);
	min-height: 100vh;
	color: #FFFFFF;
	padding: 40rpx 0;
}
.user-info-center {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	margin-top: 48rpx;
	margin-bottom: 32rpx;
}
.avatar {
	width: 140rpx;
	height: 140rpx;
	border-radius: 50%;
	background: linear-gradient(135deg, #1a1a2e 0%, #16162a 100%);
	border: 4rpx solid #7c3aed;
	margin-bottom: 18rpx;
	box-shadow: 0 0 30rpx rgba(124,58,237,0.3);
}
.user-name {
	font-size: 38rpx;
	font-weight: bold;
	color: #FFFFFF;
	margin-bottom: 10rpx;
}
.login-btn {
	background: linear-gradient(90deg, #7c3aed 0%, #a78bfa 100%);
	color: #FFFFFF;
	border: none;
	border-radius: 32rpx;
	padding: 0 48rpx;
	height: 64rpx;
	line-height: 64rpx;
	font-size: 28rpx;
	font-weight: 500;
	margin-top: 18rpx;
}
.mine-card {
	background: linear-gradient(135deg, #1a1a2e 0%, #16162a 100%);
	border-radius: 24rpx;
	margin: 0 40rpx 32rpx 40rpx;
	padding: 32rpx 0;
	display: flex;
	justify-content: space-around;
	box-shadow: 0 8rpx 32rpx rgba(124,58,237,0.15), inset 0 1rpx 0 rgba(255,255,255,0.05);
}
.mine-btn {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	background: none;
	color: #FFFFFF;
	border: none;
	border-radius: 20rpx;
	font-size: 28rpx;
	font-weight: 500;
	padding: 0 24rpx;
	height: 100rpx;
	min-width: 160rpx;
	transition: background 0.2s;
}
.mine-btn:active {
	background: rgba(124,58,237,0.08);
}
.btn-icon {
	width: 48rpx;
	height: 48rpx;
	margin-bottom: 8rpx;
}
.edit-profile-text {
	color: #7c3aed;
	font-size: 26rpx;
	text-align: center;
	margin: 48rpx 0 0 0;
	letter-spacing: 1rpx;
	opacity: 0.85;
}
