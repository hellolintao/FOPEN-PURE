.mine-page {
  padding: var(--space-5);
  padding-bottom: 160rpx;
}
.mine-page .card-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--color-bg-2);
  border-radius: var(--radius-lg);
  padding: var(--space-6);
  margin-bottom: var(--space-5);
}
.mine-page .big-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid var(--color-lime);
  margin-bottom: var(--space-4);
}
.actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}
.full-width {
  width: 100%;
}
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-10) var(--space-5);
  text-align: center;
}
