.mine-container {
  background: linear-gradient(180deg, #101017 0%, #0d0d14 100%);
  min-height: 100vh;
  padding: 0;
  box-sizing: border-box;
}

/* 用户信息 */
.user-info {
  display: flex;
  align-items: center;
  padding: 60rpx 40rpx;
  gap: 24rpx;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(124,58,237,0.5);
  background: linear-gradient(135deg, #1a1a2e 0%, #16162a 100%);
}

.user-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-name {
  font-size: 42rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}

.user-status {
  font-size: 26rpx;
  color: #bfaeff;
}

/* 登录按钮 */
.login-btn {
  margin: 0 40rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%);
  border-radius: 24rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 32rpx rgba(124,58,237,0.4);
}

.login-icon {
  font-size: 36rpx;
}

/* 统计数据 */
.stats-row {
  margin: 0 40rpx 32rpx;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, rgba(124,58,237,0.15) 0%, rgba(167,139,250,0.1) 100%);
  border: 1rpx solid rgba(124,58,237,0.2);
  border-radius: 24rpx;
  padding: 40rpx 24rpx;
  backdrop-filter: blur(20rpx);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(124,58,237,0.2);
}

/* 功能列表 */
.menu-list {
  margin: 0 40rpx 32rpx;
  background: linear-gradient(135deg, #1a1a2e 0%, #16162a 100%);
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid rgba(124,58,237,0.1);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
}

.menu-item:not(:last-child) {
  border-bottom: 1rpx solid rgba(124,58,237,0.1);
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
}

.menu-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.my-match-icon {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.edit-icon {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.setting-icon {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.menu-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.menu-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  display: block;
}

.menu-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  display: block;
}

.menu-arrow {
  font-size: 48rpx;
  color: #7c3aed;
  opacity: 0.5;
}

/* 管理入口 */
.manage-btn {
  margin: 0 40rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #1a1a2e 0%, #16162a 100%);
  border: 2rpx solid rgba(124,58,237,0.3);
  border-radius: 24rpx;
  color: #7c3aed;
  font-size: 30rpx;
  font-weight: 600;
}

.manage-icon {
  font-size: 36rpx;
}
