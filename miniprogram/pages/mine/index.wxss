.mine-container {
  background: #f7f7f7;
  min-height: 100vh;
  padding: 0;
  box-sizing: border-box;
}

/* 用户信息 */
.user-info {
  display: flex;
  align-items: center;
  padding: 60rpx 40rpx;
  gap: 24rpx;
  background: #ffffff;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 2rpx solid #e5e5e5;
  background: #f7f7f7;
}

.user-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 500;
  color: #333333;
}

.user-status {
  font-size: 24rpx;
  color: #999999;
}

/* 登录按钮 */
.login-btn {
  margin: 20rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: #333333;
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 400;
}

/* 统计数据 */
.stats-row {
  margin: 20rpx 40rpx;
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 8rpx;
  padding: 32rpx 24rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 500;
  color: #333333;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
}

.stat-divider {
  width: 1rpx;
  height: 50rpx;
  background: #e5e5e5;
}

/* 功能列表 */
.menu-list {
  margin: 20rpx 40rpx;
  background: #ffffff;
  border-radius: 8rpx;
  padding: 0 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #e5e5e5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-title {
  font-size: 30rpx;
  font-weight: 400;
  color: #333333;
}

.menu-arrow {
  font-size: 40rpx;
  color: #cccccc;
}

/* 管理入口 */
.manage-btn {
  margin: 20rpx 40rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: #333333;
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 400;
}
