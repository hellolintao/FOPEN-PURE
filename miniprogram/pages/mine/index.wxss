.mine-container {
  background: linear-gradient(180deg, #0f0f1a 0%, #1a1a2e 50%, #0d0d14 100%);
  min-height: 100vh;
  padding: 0;
  position: relative;
  overflow: hidden;
}

/* 背景装饰 */
.mine-container::before {
  content: '';
  position: absolute;
  top: -200rpx;
  right: -200rpx;
  width: 600rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(124, 58, 237, 0.15) 0%, transparent 70%);
  border-radius: 50%;
  z-index: 0;
}

.mine-container::after {
  content: '';
  position: absolute;
  bottom: -100rpx;
  left: -100rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(167, 139, 250, 0.1) 0%, transparent 70%);
  border-radius: 50%;
  z-index: 0;
}

/* 用户卡片 */
.user-card {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  padding: 60rpx 40rpx 40rpx 40rpx;
  margin-bottom: 24rpx;
}

.user-avatar-wrapper {
  position: relative;
  margin-right: 32rpx;
}

.user-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(124, 58, 237, 0.5);
  background: linear-gradient(135deg, #1a1a2e 0%, #16162a 100%);
  box-shadow: 0 8rpx 32rpx rgba(124, 58, 237, 0.3);
}

.avatar-glow {
  position: absolute;
  top: -10rpx;
  left: -10rpx;
  right: -10rpx;
  bottom: -10rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(124, 58, 237, 0.2);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    opacity: 0.5;
  }
  50% {
    transform: scale(1.1);
    opacity: 0.2;
  }
}

.user-details {
  flex: 1;
}

.user-name {
  font-size: 42rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 8rpx rgba(124, 58, 237, 0.3);
}

.user-status {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #22c55e 0%, #4ade80 100%);
  margin-right: 8rpx;
  box-shadow: 0 0 12rpx rgba(34, 197, 94, 0.5);
}

/* 登录区域 */
.login-section {
  position: relative;
  z-index: 1;
  padding: 0 40rpx;
  margin-bottom: 32rpx;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%);
  border: none;
  border-radius: 24rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 32rpx rgba(124, 58, 237, 0.4);
  transition: all 0.3s ease;
}

.login-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(124, 58, 237, 0.3);
}

.login-btn .btn-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

/* 统计卡片 */
.stats-card {
  position: relative;
  z-index: 1;
  background: linear-gradient(135deg, rgba(124, 58, 237, 0.15) 0%, rgba(167, 139, 250, 0.1) 100%);
  border: 1rpx solid rgba(124, 58, 237, 0.2);
  border-radius: 24rpx;
  margin: 0 40rpx 32rpx 40rpx;
  padding: 40rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  backdrop-filter: blur(20rpx);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(124, 58, 237, 0.2);
}

/* 菜单区域 */
.menu-section {
  position: relative;
  z-index: 1;
  padding: 0 40rpx;
  margin-bottom: 32rpx;
}

.menu-card {
  background: linear-gradient(135deg, #1a1a2e 0%, #16162a 100%);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(124, 58, 237, 0.1), inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  transition: background 0.2s ease;
  position: relative;
}

.menu-item:not(:last-child)::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 100rpx;
  right: 28rpx;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(124, 58, 237, 0.1) 0%, transparent 100%);
}

.menu-item:active {
  background: rgba(124, 58, 237, 0.08);
}

.menu-icon-wrapper {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(124, 58, 237, 0.2);
  flex-shrink: 0;
}

.menu-icon {
  font-size: 40rpx;
}

.menu-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.menu-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 4rpx;
}

.menu-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}

.menu-arrow {
  font-size: 40rpx;
  color: rgba(124, 58, 237, 0.5);
  margin-left: 16rpx;
}

/* 管理区域 */
.manage-section {
  position: relative;
  z-index: 1;
  padding: 0 40rpx 40rpx 40rpx;
}

.manage-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1a1a2e 0%, #16162a 100%);
  border: 2rpx solid rgba(124, 58, 237, 0.3);
  border-radius: 24rpx;
  color: #7c3aed;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(124, 58, 237, 0.1);
  transition: all 0.3s ease;
}

.manage-btn:active {
  background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%);
  color: #fff;
  border-color: transparent;
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 24rpx rgba(124, 58, 237, 0.3);
}

.manage-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}
