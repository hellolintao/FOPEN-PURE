<view class="home-page">

  <!-- HEAD -->
  <view class="home-head anim-stage-rise">
    <view class="head-tapes">
      <text class="tape tape-stamped">FOPEN TC · {{isAdmin ? 'ADMIN' : 'MEMBER'}}</text>
    </view>
    <view class="greeting-row">
      <image class="user-avatar" src="{{currentMember.avatarUrl || '/images/icons/usercenter.png'}}" mode="aspectFill" />
      <view class="greeting-info">
        <text class="hello-zh">你好，</text>
        <text class="hello-name">{{currentMember.name || '球友'}}</text>
      </view>
    </view>
  </view>

  <!-- HERO -->
  <view class="hero-block anim-stage-rise anim-delay-1">
    <view class="hero-bg-num num">26</view>
    <view class="hero-tapes-row">
      <text class="tape tape-lime tape-stamped-lime">SEASON · S{{seasonYear}}</text>
    </view>
    <view class="hero-headline">
      <text class="hero-line">PLAY.</text>
      <text class="hero-line">COMPETE.</text>
      <text class="hero-line">IMPROVE.</text>
    </view>
    <view class="hero-foot">
      <text class="hero-foot-zh">FOPEN 网球俱乐部</text>
      <text class="hero-foot-en num">/ TENNIS CLUB</text>
    </view>
  </view>

  <!-- QUICK ACTIONS -->
  <view class="section anim-stage-rise anim-delay-2">
    <view class="section-head">
      <text class="tape">QUICK ACTIONS</text>
    </view>
    <view class="quick-grid">
      <view class="quick-tile tap-scale" bindtap="onQuickAction" data-action="match">
        <text class="quick-num num">01</text>
        <text class="quick-text">赛事</text>
        <text class="quick-arrow num">→</text>
      </view>
      <view class="quick-tile tap-scale" bindtap="onQuickAction" data-action="rank">
        <text class="quick-num num">02</text>
        <text class="quick-text">排行</text>
        <text class="quick-arrow num">→</text>
      </view>
      <view class="quick-tile tap-scale" bindtap="onQuickAction" data-action="my-match">
        <text class="quick-num num">03</text>
        <text class="quick-text">我的比赛</text>
        <text class="quick-arrow num">→</text>
      </view>
      <view wx:if="{{isAdmin}}" class="quick-tile quick-tile-admin tap-scale" bindtap="onQuickAction" data-action="create">
        <text class="quick-num num">+</text>
        <text class="quick-text">创建赛事</text>
        <text class="quick-arrow num">→</text>
      </view>
    </view>
  </view>

  <!-- MY STATS -->
  <view class="section anim-stage-rise anim-delay-3">
    <view class="section-head">
      <text class="tape">MY STATS</text>
      <text class="section-meta num">S{{seasonYear}}</text>
    </view>
    <skeleton-loader wx:if="{{loadingStats}}" rows="{{2}}" />
    <view wx:else class="stats-row">
      <view class="my-stat my-stat-paper">
        <text class="my-stat-num num">{{myStats.matches}}</text>
        <text class="my-stat-label">MATCHES</text>
      </view>
      <view class="my-stat my-stat-lime">
        <text class="my-stat-num num">{{myStats.wins}}</text>
        <text class="my-stat-label">WINS</text>
      </view>
      <view class="my-stat my-stat-ink">
        <text class="my-stat-num num">{{myStats.winRate}}<text class="my-stat-suffix">%</text></text>
        <text class="my-stat-label">WIN RATE</text>
      </view>
    </view>
  </view>

</view>
