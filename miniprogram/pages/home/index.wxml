<view class="home-page {{isPrideMonthSkinActive ? 'theme-pride-month' : ''}}">

  <!-- HEAD -->
  <view class="home-head anim-stage-rise">
    <view class="head-tapes">
      <text class="tape tape-stamped">FU OPEN · {{isAdmin ? 'ADMIN' : 'MEMBER'}}</text>
    </view>
    <view class="greeting-row">
      <image class="user-avatar" src="{{currentMember.avatarUrl || '/images/icons/default-avatar.png'}}" mode="aspectFill" />
      <view class="greeting-info">
        <text class="hello-zh">你好，</text>
        <text class="hello-name">{{currentMember.name || '球友'}}</text>
      </view>
    </view>
  </view>

  <!-- HERO -->
  <view class="hero-block anim-stage-rise anim-delay-1">
    <view wx:if="{{isPrideMonthSkinActive}}" class="hero-pride-waves pride-s-curve">
      <view class="pride-wave pride-wave-red"></view>
      <view class="pride-wave pride-wave-orange"></view>
      <view class="pride-wave pride-wave-yellow"></view>
      <view class="pride-wave pride-wave-green"></view>
      <view class="pride-wave pride-wave-blue"></view>
      <view class="pride-wave pride-wave-violet"></view>
    </view>
    <view class="hero-bg-num-stack">
      <view wx:if="{{isPrideMonthSkinActive}}" class="hero-bg-num-blur num">26</view>
      <view class="hero-bg-num num">26</view>
    </view>
    <text class="hero-credit">Created by BrainLe</text>
    <view class="hero-headline">
      <text class="hero-line">FU OPEN.</text>
      <text class="hero-line">2026.</text>
    </view>
    <text wx:if="{{isPrideMonthSkinActive}}" class="hero-pride-label">PRIDE MONTH</text>
    <view class="hero-foot">
      <text class="hero-foot-zh">FU OPEN 官方小程序</text>
      <text class="hero-foot-en">/ TENNIS CLUB SYSTEM</text>
    </view>
  </view>

  <!-- QUICK ACTIONS -->
  <view class="section anim-stage-rise anim-delay-2">
    <view class="section-head">
      <text class="tape">QUICK ACTIONS</text>
    </view>
    <view class="quick-grid">
      <view class="quick-tile tap-scale" bindtap="onQuickAction" data-action="match">
        <text class="quick-num num">01</text>
        <text class="quick-text">赛事</text>
        <text class="quick-arrow num">→</text>
      </view>
      <view class="quick-tile tap-scale" bindtap="onQuickAction" data-action="rank">
        <text class="quick-num num">02</text>
        <text class="quick-text">排行</text>
        <text class="quick-arrow num">→</text>
      </view>
      <view class="quick-tile tap-scale" bindtap="onQuickAction" data-action="my-match">
        <text class="quick-num num">03</text>
        <text class="quick-text">我的比赛</text>
        <text class="quick-arrow num">→</text>
      </view>
      <view wx:if="{{isAdmin}}" class="quick-tile quick-tile-admin tap-scale" bindtap="onQuickAction" data-action="create">
        <text class="quick-num num">+</text>
        <text class="quick-text">创建赛事</text>
        <text class="quick-arrow num">→</text>
      </view>
    </view>
  </view>

  <!-- MY STATS -->
  <view class="section anim-stage-rise anim-delay-3">
    <view class="section-head">
      <text class="tape">MY STATS</text>
      <text class="section-meta num">S{{seasonYear}}</text>
    </view>
    <skeleton-loader wx:if="{{loadingStats}}" rows="{{2}}" />
    <view wx:else class="home-stats-stack">
      <view class="home-stat-group">
        <view class="stat-mode-head">
          <text class="tape tape-lime tape-stamped-lime">SINGLES · 单打</text>
        </view>
        <view class="stats-row">
          <view class="my-stat my-stat-paper">
            <text class="my-stat-num num">{{myStats.singles.wins}}<text class="my-stat-denom">/{{myStats.singles.total}}</text></text>
            <text class="my-stat-label">胜场/总</text>
          </view>
          <view class="my-stat my-stat-lime">
            <text class="my-stat-num num">{{myStats.singles.winRateLabel}}</text>
            <text class="my-stat-label">胜率</text>
          </view>
          <view class="my-stat my-stat-ink">
            <text class="my-stat-num num">{{myStats.singles.totalPoints}}</text>
            <text class="my-stat-label">积分</text>
          </view>
        </view>
      </view>

      <view class="home-stat-group">
        <view class="stat-mode-head">
          <text class="tape tape-ghost">DOUBLES · 双打</text>
        </view>
        <view class="stats-row">
          <view class="my-stat my-stat-paper">
            <text class="my-stat-num num">{{myStats.doubles.wins}}<text class="my-stat-denom">/{{myStats.doubles.total}}</text></text>
            <text class="my-stat-label">胜场/总</text>
          </view>
          <view class="my-stat my-stat-paper-alt">
            <text class="my-stat-num num">{{myStats.doubles.winRateLabel}}</text>
            <text class="my-stat-label">胜率</text>
          </view>
          <view class="my-stat my-stat-paper-alt">
            <text class="my-stat-num num">{{myStats.doubles.totalPoints}}</text>
            <text class="my-stat-label">积分</text>
          </view>
        </view>
      </view>
    </view>
  </view>

</view>
