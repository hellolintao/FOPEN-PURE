.home-page {
  padding: var(--space-5) var(--space-5) 160rpx;
  background: var(--color-bg);
  min-height: 100vh;
}

/* ============================================================
 * HEAD · greeting
 * ============================================================ */
.home-head {
  margin-bottom: var(--space-5);
}

.head-tapes {
  margin-bottom: var(--space-4);
}

.greeting-row {
  display: flex;
  align-items: center;
  gap: var(--space-4);
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--color-bg-3);
  border: 2rpx solid var(--color-ink);
}

.greeting-info {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.hello-zh {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-ink-3);
  letter-spacing: 0.01em;
}

.hello-name {
  font-size: 44rpx;
  font-weight: 900;
  color: var(--color-ink);
  letter-spacing: -0.01em;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ============================================================
 * HERO
 * ============================================================ */
.hero-block {
  position: relative;
  background: var(--color-lime);
  border-radius: var(--radius-xl);
  padding: var(--space-6) var(--space-5) var(--space-5);
  margin-bottom: var(--space-6);
  overflow: hidden;
  isolation: isolate;
}

.hero-bg-num {
  position: absolute;
  right: -24rpx;
  bottom: -44rpx;
  font-size: 360rpx;
  font-weight: 900;
  line-height: 0.8;
  letter-spacing: 0;
  color: var(--color-ink);
  opacity: 0.08;
  pointer-events: none;
  z-index: 0;
}

.hero-bg-num-stack {
  position: absolute;
  right: -24rpx;
  bottom: -44rpx;
  width: 380rpx;
  height: 300rpx;
  pointer-events: none;
  z-index: 0;
}

.hero-bg-num-stack .hero-bg-num {
  right: 0;
  bottom: 0;
}

.hero-credit {
  position: relative;
  z-index: 1;
  display: block;
  margin-bottom: var(--space-3);
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: 0;
  color: var(--color-ink-3);
}

.hero-headline {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  margin-bottom: var(--space-5);
}

.hero-line {
  font-size: 76rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: 0;
  color: var(--color-ink);
}

.hero-foot {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: var(--space-3);
  padding-top: var(--space-3);
  border-top: 2rpx solid var(--color-ink);
}

.hero-foot-zh {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-ink);
  letter-spacing: 0;
}

.hero-foot-en {
  font-size: 22rpx;
  font-weight: 800;
  color: var(--color-ink-3);
  letter-spacing: 0;
}

.theme-pride-month .hero-block {
  min-height: 328rpx;
  background: #F51F3E;
  color: #FFF7F2;
  box-shadow: 0 12rpx 34rpx rgba(65, 25, 82, 0.16);
}

.hero-pride-waves {
  position: absolute;
  left: -176rpx;
  right: -176rpx;
  top: -78rpx;
  bottom: -106rpx;
  z-index: 0;
  pointer-events: none;
}

.hero-pride-waves .pride-wave {
  position: absolute;
  width: 124%;
  height: 138rpx;
  border-radius: 72% 28% 66% 34% / 58% 46% 62% 44%;
}

.hero-pride-waves .pride-wave-red {
  top: -26rpx;
  left: -48rpx;
  height: 154rpx;
  background: #F51F3E;
  transform: rotate(-5deg) translateX(78rpx);
}

.hero-pride-waves .pride-wave-orange {
  top: 34rpx;
  left: -22rpx;
  height: 168rpx;
  background: #FF8126;
  border-radius: 62% 38% 76% 24% / 48% 62% 42% 58%;
  transform: rotate(-7deg) translateX(52rpx);
}

.hero-pride-waves .pride-wave-yellow {
  top: 92rpx;
  left: -72rpx;
  height: 164rpx;
  background: #F6D84A;
  border-radius: 78% 22% 60% 40% / 54% 40% 64% 46%;
  transform: rotate(-10deg) translateX(-34rpx);
}

.hero-pride-waves .pride-wave-green {
  top: 176rpx;
  left: -112rpx;
  height: 148rpx;
  background: #52B95E;
  border-radius: 70% 30% 50% 50% / 62% 38% 56% 44%;
  transform: rotate(-14deg) translateX(-92rpx);
}

.hero-pride-waves .pride-wave-blue {
  top: 246rpx;
  left: -42rpx;
  height: 144rpx;
  background: #2369D8;
  border-radius: 48% 52% 70% 30% / 46% 60% 42% 58%;
  transform: rotate(-8deg) translateX(34rpx);
}

.hero-pride-waves .pride-wave-violet {
  top: 342rpx;
  left: 62rpx;
  height: 104rpx;
  background: #8F20CE;
  border-radius: 34% 66% 76% 24% / 42% 64% 40% 60%;
  transform: rotate(-4deg) translateX(124rpx);
}

.theme-pride-month .hero-block::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(98deg, rgba(255, 255, 255, 0.18) 0 1rpx, transparent 1rpx 58rpx),
    linear-gradient(180deg, rgba(255, 255, 255, 0.12), transparent 44%);
  opacity: 0.52;
  z-index: 1;
}

.theme-pride-month .hero-bg-num {
  right: 0;
  bottom: 0;
  color: rgba(255, 255, 255, 0.18);
  opacity: 1;
  -webkit-text-stroke: 3rpx rgba(255, 255, 255, 0.62);
  text-shadow: none;
  z-index: 2;
}

.theme-pride-month .hero-bg-num-stack {
  right: -12rpx;
  bottom: -38rpx;
  z-index: 2;
}

.hero-bg-num-blur {
  position: absolute;
  right: 0;
  bottom: 0;
  font-size: 360rpx;
  font-weight: 900;
  line-height: 0.8;
  letter-spacing: 0;
  color: rgba(255, 255, 255, 0.22);
  opacity: 0.74;
  filter: blur(18rpx);
  z-index: 1;
}

.theme-pride-month .hero-credit,
.theme-pride-month .hero-headline,
.theme-pride-month .hero-pride-label,
.theme-pride-month .hero-foot {
  position: relative;
  z-index: 3;
}

.theme-pride-month .hero-credit {
  color: #FFF8F0;
}

.theme-pride-month .hero-line {
  color: #FFF8F0;
  text-shadow: 0 2rpx 0 rgba(11, 12, 9, 0.08);
}

.hero-pride-label {
  display: block;
  margin: 0 0 var(--space-5);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: 0;
  color: #FFF8F0;
}

.theme-pride-month .hero-foot {
  border-top-color: rgba(255, 255, 255, 0.72);
}

.theme-pride-month .hero-foot-zh,
.theme-pride-month .hero-foot-en {
  color: #FFF8F0;
}

/* ============================================================
 * SECTION
 * ============================================================ */
.section {
  margin-bottom: var(--space-7);
}

.section-head {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.section-meta {
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: var(--color-muted);
  text-transform: uppercase;
  margin-left: auto;
}

/* ============================================================
 * QUICK ACTIONS
 * ============================================================ */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-3);
}

.quick-tile {
  position: relative;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-md);
  padding: var(--space-5);
  min-height: 168rpx;
  overflow: hidden;
}

.quick-tile:active {
  background: var(--color-bg-3);
}

.quick-num {
  font-size: 26rpx;
  font-weight: 900;
  color: var(--color-muted);
  letter-spacing: 0.04em;
  margin-bottom: var(--space-2);
}

.quick-text {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--color-ink);
  letter-spacing: 0.02em;
  line-height: 1;
}

.quick-arrow {
  position: absolute;
  right: var(--space-4);
  bottom: var(--space-4);
  font-size: 36rpx;
  font-weight: 900;
  color: var(--color-ink);
  line-height: 1;
}

.quick-tile-admin {
  background: var(--color-ink);
  border-color: var(--color-ink);
}
.quick-tile-admin .quick-num { color: var(--color-lime); }
.quick-tile-admin .quick-text { color: var(--color-bg); }
.quick-tile-admin .quick-arrow { color: var(--color-lime); }

/* ============================================================
 * MY STATS · big numbers, three-tile horizontal
 * ============================================================ */
.stats-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-3);
}

.home-stats-stack {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.home-stat-group {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.stat-mode-head {
  display: flex;
  align-items: center;
}

.my-stat {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  padding: var(--space-5) var(--space-4);
  border-radius: var(--radius-md);
  min-height: 200rpx;
  justify-content: space-between;
}

.my-stat-num {
  font-size: 72rpx;
  font-weight: 900;
  line-height: 0.9;
  letter-spacing: -0.04em;
  color: var(--color-ink);
}

.my-stat-denom {
  font-size: 30rpx;
  font-weight: 900;
  opacity: 0.72;
  letter-spacing: 0;
}

.my-stat-label {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-muted);
}

.my-stat-paper {
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
}

.my-stat-paper-alt {
  background: var(--color-bg-3);
}

.my-stat-lime {
  background: var(--color-lime);
}
.my-stat-lime .my-stat-num { color: var(--color-ink); }
.my-stat-lime .my-stat-label { color: var(--color-ink-3); }

.my-stat-ink {
  background: var(--color-ink);
}
.my-stat-ink .my-stat-num { color: var(--color-bg); }
.my-stat-ink .my-stat-label { color: var(--color-muted-2); }
