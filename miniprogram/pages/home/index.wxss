.home-page {
  padding: var(--space-5) var(--space-5) 160rpx;
  background: var(--color-bg);
  min-height: 100vh;
}

/* ============================================================
 * HEAD · greeting
 * ============================================================ */
.home-head {
  margin-bottom: var(--space-5);
}

.head-tapes {
  margin-bottom: var(--space-4);
}

.greeting-row {
  display: flex;
  align-items: center;
  gap: var(--space-4);
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--color-bg-3);
  border: 2rpx solid var(--color-ink);
}

.greeting-info {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.hello-zh {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-ink-3);
  letter-spacing: 0.01em;
}

.hello-name {
  font-size: 44rpx;
  font-weight: 900;
  color: var(--color-ink);
  letter-spacing: -0.01em;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ============================================================
 * HERO
 * ============================================================ */
.hero-block {
  position: relative;
  background: var(--color-lime);
  border-radius: var(--radius-xl);
  padding: var(--space-6) var(--space-5) var(--space-5);
  margin-bottom: var(--space-6);
  overflow: hidden;
  isolation: isolate;
}

.hero-bg-num {
  position: absolute;
  right: -24rpx;
  bottom: -44rpx;
  font-size: 360rpx;
  font-weight: 900;
  line-height: 0.8;
  letter-spacing: 0;
  color: var(--color-ink);
  opacity: 0.08;
  pointer-events: none;
  z-index: 0;
}

.hero-credit {
  position: relative;
  z-index: 1;
  display: block;
  margin-bottom: var(--space-3);
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: 0;
  color: var(--color-ink-3);
}

.hero-headline {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  margin-bottom: var(--space-5);
}

.hero-line {
  font-size: 76rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: 0;
  color: var(--color-ink);
}

.hero-foot {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: var(--space-3);
  padding-top: var(--space-3);
  border-top: 2rpx solid var(--color-ink);
}

.hero-foot-zh {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-ink);
  letter-spacing: 0;
}

.hero-foot-en {
  font-size: 22rpx;
  font-weight: 800;
  color: var(--color-ink-3);
  letter-spacing: 0;
}

/* ============================================================
 * SECTION
 * ============================================================ */
.section {
  margin-bottom: var(--space-7);
}

.section-head {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.section-meta {
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: var(--color-muted);
  text-transform: uppercase;
  margin-left: auto;
}

/* ============================================================
 * QUICK ACTIONS
 * ============================================================ */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-3);
}

.quick-tile {
  position: relative;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-md);
  padding: var(--space-5);
  min-height: 168rpx;
  overflow: hidden;
}

.quick-tile:active {
  background: var(--color-bg-3);
}

.quick-num {
  font-size: 26rpx;
  font-weight: 900;
  color: var(--color-muted);
  letter-spacing: 0.04em;
  margin-bottom: var(--space-2);
}

.quick-text {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--color-ink);
  letter-spacing: 0.02em;
  line-height: 1;
}

.quick-arrow {
  position: absolute;
  right: var(--space-4);
  bottom: var(--space-4);
  font-size: 36rpx;
  font-weight: 900;
  color: var(--color-ink);
  line-height: 1;
}

.quick-tile-admin {
  background: var(--color-ink);
  border-color: var(--color-ink);
}
.quick-tile-admin .quick-num { color: var(--color-lime); }
.quick-tile-admin .quick-text { color: var(--color-bg); }
.quick-tile-admin .quick-arrow { color: var(--color-lime); }

/* ============================================================
 * MY STATS · big numbers, three-tile horizontal
 * ============================================================ */
.stats-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-3);
}

.home-stats-stack {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.home-stat-group {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.stat-mode-head {
  display: flex;
  align-items: center;
}

.my-stat {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  padding: var(--space-5) var(--space-4);
  border-radius: var(--radius-md);
  min-height: 200rpx;
  justify-content: space-between;
}

.my-stat-num {
  font-size: 72rpx;
  font-weight: 900;
  line-height: 0.9;
  letter-spacing: -0.04em;
  color: var(--color-ink);
}

.my-stat-denom {
  font-size: 30rpx;
  font-weight: 900;
  opacity: 0.72;
  letter-spacing: 0;
}

.my-stat-label {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-muted);
}

.my-stat-paper {
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
}

.my-stat-paper-alt {
  background: var(--color-bg-3);
}

.my-stat-lime {
  background: var(--color-lime);
}
.my-stat-lime .my-stat-num { color: var(--color-ink); }
.my-stat-lime .my-stat-label { color: var(--color-ink-3); }

.my-stat-ink {
  background: var(--color-ink);
}
.my-stat-ink .my-stat-num { color: var(--color-bg); }
.my-stat-ink .my-stat-label { color: var(--color-muted-2); }
