.tab-page {
	padding: 80rpx 0;
	text-align: center;
	background: linear-gradient(180deg, #101017 0%, #0d0d14 100%);
	min-height: 100vh;
}
.tab-title {
	font-size: 44rpx;
	color: #7c3aed;
	margin-bottom: 20rpx;
	font-weight: 600;
	letter-spacing: 2rpx;
	text-shadow: 0 2rpx 12rpx rgba(124,58,237,0.3);
}
.tab-desc {
	color: #aaa;
	font-size: 28rpx;
}