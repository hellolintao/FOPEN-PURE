.tournament-add-players-doubles-container {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 40rpx;
}

/* ============================================================
 * TEAMS SECTION
 * ============================================================ */
.teams-section {
  padding: var(--space-4);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-4) var(--space-5);
  background: var(--color-ink);
  color: var(--color-bg);
  border-radius: var(--radius-md) var(--radius-md) 0 0;
}

.header-title {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 0.06em;
  color: var(--color-bg);
}

.title-icon {
  font-size: 28rpx;
}

.add-team-btn {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  margin: 0;
  background: var(--color-lime);
  color: var(--color-ink);
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 0.04em;
  border-radius: var(--radius-pill);
  padding: 10rpx 22rpx;
  border: none;
}

.add-team-btn::after { border: none; }

.add-icon,
.add-text {
  display: inline-block;
}

.add-icon {
  font-size: 28rpx;
  font-weight: 900;
}

.teams-list {
  border: 2rpx solid var(--color-ink);
  border-top: 0;
  border-radius: 0 0 var(--radius-md) var(--radius-md);
  background: var(--color-bg);
  max-height: 60vh;
}

.empty-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-7) var(--space-4);
}

.hint-icon {
  font-size: 56rpx;
  opacity: 0.4;
}

.hint-text {
  font-size: var(--font-body-size);
  font-weight: 800;
  color: var(--color-ink);
}

.hint-desc {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-muted);
}

/* ============================================================
 * TEAM ITEM
 * ============================================================ */
.team-item {
  background: var(--color-bg);
  padding: var(--space-4) var(--space-5);
  border-bottom: 1rpx solid var(--color-border);
}

.team-item:last-child { border-bottom: 0; }

.team-header {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-3);
}

.team-badge {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-ink);
  color: var(--color-lime);
  border-radius: 50%;
  font-family: var(--font-family-num);
  font-size: 24rpx;
  font-weight: 900;
}

.team-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 900;
  color: var(--color-ink);
  letter-spacing: -0.01em;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.team-players {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-bottom: var(--space-3);
  padding: var(--space-3) var(--space-4);
  background: var(--color-bg-3);
  border-radius: var(--radius-sm);
}

.player-info {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
}

.player-label {
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-muted);
  min-width: 72rpx;
}

.player-name {
  flex: 1;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.team-actions {
  display: flex;
  gap: var(--space-2);
  justify-content: flex-end;
}

.action-btn {
  margin: 0;
  padding: 12rpx 28rpx;
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 0.04em;
  border: 2rpx solid var(--color-ink);
  background: var(--color-bg);
  color: var(--color-ink);
}

.action-btn::after { border: none; }

.action-btn.edit {
  background: var(--color-ink);
  color: var(--color-bg);
}

.action-btn.delete {
  background: var(--color-bg);
  color: var(--color-danger);
  border-color: var(--color-danger);
}

/* ============================================================
 * MEMBER PICKER SECTION (lower half - if present)
 * ============================================================ */
.member-picker-section,
.member-list-section,
.player-section {
  padding: var(--space-4);
}

.search-bar {
  display: flex;
  align-items: center;
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-pill);
  padding: 4rpx var(--space-5);
  margin-bottom: var(--space-3);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-ink);
  height: 56rpx;
  line-height: 56rpx;
}

.clear-btn {
  width: 44rpx;
  height: 44rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--color-ink);
  color: var(--color-bg);
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 900;
  flex-shrink: 0;
}

.member-list {
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-md);
  background: var(--color-bg);
  overflow: hidden;
}

.member-item {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-4) var(--space-5);
  border-bottom: 1rpx solid var(--color-border);
}

.member-item:last-child { border-bottom: 0; }

.member-avatar-placeholder {
  width: 72rpx;
  height: 72rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-3);
  color: var(--color-ink);
  border: 2rpx solid var(--color-ink);
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 900;
}

.member-name-text,
.member-name {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-ink);
  letter-spacing: 0.01em;
}

.select-badge {
  width: 48rpx;
  height: 48rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 900;
  color: var(--color-ink);
  flex-shrink: 0;
}

.select-badge.selected {
  background: var(--color-ink);
  color: var(--color-bg);
}

/* ============================================================
 * FOOTER ACTIONS / SUBMIT
 * ============================================================ */
.footer-actions,
.bottom-action,
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: var(--space-3) var(--space-5) calc(var(--space-3) + env(safe-area-inset-bottom));
  background: var(--color-bg);
  border-top: 2rpx solid var(--color-ink);
  z-index: 10;
}

.submit-btn,
.confirm-btn,
.action-btn-primary {
  width: 100%;
  margin: 0;
  background: var(--color-lime) !important;
  color: var(--color-ink) !important;
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: 0.04em;
  padding: var(--space-5) 0;
  border-radius: var(--radius-pill) !important;
  border: 2rpx solid var(--color-ink);
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn::after,
.confirm-btn::after,
.action-btn-primary::after { border: none; }

.submit-btn[disabled],
.confirm-btn[disabled] {
  background: var(--color-bg-3) !important;
  color: var(--color-muted) !important;
  border-color: var(--color-border) !important;
}

/* ============================================================
 * DIALOG (team add/edit)
 * ============================================================ */
.dialog-mask {
  position: fixed;
  inset: 0;
  background: rgba(11, 12, 9, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog {
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-lg);
  padding: var(--space-6);
  width: 86vw;
  max-width: 680rpx;
  box-shadow: 8rpx 8rpx 0 var(--color-ink);
}

.dialog-title {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
  color: var(--color-ink);
  letter-spacing: -0.01em;
  margin-bottom: var(--space-5);
}

.dialog-input,
.input,
.form-input {
  width: 100%;
  background: var(--color-bg-3);
  border-radius: var(--radius-sm);
  color: var(--color-ink);
  font-size: 28rpx;
  font-weight: 700;
  padding: 22rpx 24rpx;
  margin-bottom: var(--space-3);
  box-sizing: border-box;
}

.dialog-actions {
  display: flex;
  gap: var(--space-3);
  margin-top: var(--space-4);
}

.dialog-btn {
  flex: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx 0;
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  font-weight: 800;
}

.dialog-btn.cancel {
  background: var(--color-bg);
  color: var(--color-ink);
  border: 2rpx solid var(--color-ink);
}

.dialog-btn.primary {
  background: var(--color-ink);
  color: var(--color-bg);
}
