.pd-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: var(--space-5) var(--space-5) 160rpx;
}

.pd-loading {
  padding: var(--space-7) 0;
}

/* ============================================================
 * HERO
 * ============================================================ */
.pd-hero {
  position: relative;
  background: var(--color-lime);
  border-radius: var(--radius-xl);
  padding: var(--space-6) var(--space-6) var(--space-6);
  margin-bottom: var(--space-7);
  overflow: hidden;
  isolation: isolate;
}

.pd-hero-tapes {
  position: relative;
  z-index: 1;
  margin-bottom: var(--space-5);
}

.pd-hero-main {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: var(--space-5);
}

.pd-avatar-wrap {
  flex-shrink: 0;
}

.pd-avatar {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  background: var(--color-bg);
  border: 4rpx solid var(--color-ink);
  box-shadow: 6rpx 6rpx 0 var(--color-ink);
}

.pd-hero-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.pd-name {
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: -0.01em;
  color: var(--color-ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.pd-rank-subtitle {
  display: block;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 0.04em;
  color: var(--color-ink-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.pd-style-pill {
  align-self: flex-start;
  max-width: 100%;
  padding: 8rpx 16rpx;
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-sm);
  background: var(--color-bg);
  color: var(--color-ink);
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.2;
  letter-spacing: 0.04em;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.pd-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.pd-meta-label {
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.16em;
  color: var(--color-ink-3);
  text-transform: uppercase;
}

.pd-meta-val {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--color-ink);
  letter-spacing: 0.02em;
}

/* ============================================================
 * SECTION
 * ============================================================ */
.pd-section {
  margin-bottom: var(--space-6);
}

.pd-section-head {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.pd-section-count {
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-muted);
  margin-left: auto;
}

.pd-tab-wrap {
  margin-bottom: var(--space-6);
}

/* ============================================================
 * ABOUT
 * ============================================================ */
.pd-about-text {
  display: block;
  font-size: var(--font-body-size);
  color: var(--color-ink);
  line-height: 1.6;
  padding: var(--space-4) var(--space-5);
  background: var(--color-bg-3);
  border-radius: var(--radius-md);
}

/* ============================================================
 * STATS
 * ============================================================ */
.pd-stats-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-3);
}

.pd-stat {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: var(--space-3);
  padding: var(--space-5) var(--space-4);
  border-radius: var(--radius-md);
  min-height: 196rpx;
}

.pd-stat-num {
  font-size: 80rpx;
  font-weight: 900;
  line-height: 0.9;
  letter-spacing: -0.04em;
  color: var(--color-ink);
}

.pd-stat-denom {
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: 0;
  opacity: 0.72;
}

.pd-stat-label {
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-muted);
}

.pd-stat-paper {
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
}

.pd-stat-paper-alt {
  background: var(--color-bg-3);
}

.pd-stat-lime {
  background: var(--color-lime);
}
.pd-stat-lime .pd-stat-num { color: var(--color-ink); }
.pd-stat-lime .pd-stat-label { color: var(--color-ink-3); }

.pd-stat-ink {
  background: var(--color-ink);
}
.pd-stat-ink .pd-stat-num { color: var(--color-bg); }
.pd-stat-ink .pd-stat-label { color: var(--color-muted-2); }

/* ============================================================
 * RANK CHART
 * ============================================================ */
.pd-chart-meta {
  display: block;
  margin-top: var(--space-3);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.4;
  letter-spacing: 0.12em;
  color: var(--color-muted);
}

/* ============================================================
 * H2H
 * ============================================================ */
.pd-h2h-expand {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 72rpx;
  margin-top: var(--space-3);
  padding: 0 var(--space-5);
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-md);
  background: var(--color-bg);
  color: var(--color-ink);
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: 0.08em;
}

.pd-h2h-expand::after {
  border: 0;
}

/* ============================================================
 * RECENT
 * ============================================================ */
.pd-recent-list {
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-md);
  background: var(--color-bg);
  overflow: hidden;
}

.pd-recent-row {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  padding: var(--space-4) var(--space-5);
  border-bottom: 1rpx solid var(--color-border);
}

.pd-recent-row--active {
  background: var(--color-bg-2);
}

.pd-recent-row:last-child {
  border-bottom: 0;
}

.pd-recent-top {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  min-width: 0;
}

.pd-recent-badge {
  flex-shrink: 0;
  max-width: 156rpx;
  padding: 4rpx 10rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg-3);
  color: var(--color-ink);
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.2;
  letter-spacing: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.pd-recent-badge.reg {
  background: var(--color-lime);
}

.pd-recent-tour {
  flex: 1;
  min-width: 0;
  color: var(--color-ink);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.25;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.pd-recent-date {
  flex-shrink: 0;
  max-width: 220rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.pd-recent-result {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  min-width: 0;
}

.pd-recent-result-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
}

.pd-recent-score {
  flex-shrink: 0;
  color: var(--color-ink);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.2;
  letter-spacing: 0;
}

.pd-recent-opp {
  flex: 1;
  min-width: 0;
  color: var(--color-ink-3);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.25;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.pd-recent-points {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 72rpx;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: var(--radius-sm);
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: 0;
}

.pd-recent-points.win {
  background: var(--color-lime);
  color: var(--color-ink);
}

.pd-recent-points.loss {
  background: var(--color-ink);
  color: var(--color-bg);
}

.pd-recent-empty {
  padding: var(--space-7) 0;
  text-align: center;
  color: var(--color-muted);
  font-size: var(--font-body-size);
  background: var(--color-bg-3);
  border-radius: var(--radius-md);
}

/* ============================================================
 * EMPTY
 * ============================================================ */
.pd-empty {
  padding: var(--space-9) 0;
  text-align: center;
}
