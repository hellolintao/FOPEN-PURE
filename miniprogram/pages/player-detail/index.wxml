<view class="pd-page">

  <view wx:if="{{loading}}" class="pd-loading">
    <skeleton-loader rows="{{6}}" />
  </view>

  <block wx:elif="{{player}}">

    <!-- HERO -->
    <view class="pd-hero anim-stage-rise">
      <view class="pd-hero-tapes">
        <text class="tape tape-stamped">PLAYER · 球员档案</text>
      </view>
      <view class="pd-hero-main">
        <view class="pd-avatar-wrap">
          <image class="pd-avatar" src="{{player.avatarUrl || '/images/icons/default-avatar.png'}}" mode="aspectFill" />
        </view>
        <view class="pd-hero-info">
          <text class="pd-name">{{player.name}}</text>
          <text class="pd-rank-subtitle">{{rankSubtitle}}</text>
          <text class="pd-style-pill">{{playStyleLabel}}</text>
        </view>
      </view>
    </view>

    <!-- TABS -->
    <view class="pd-tab-wrap anim-stage-rise anim-delay-2">
      <chip-tab
        value="{{activeTab}}"
        options="{{playerTabOptions}}"
        bindchange="onTabChange"
      />
    </view>

    <!-- ACTIVE STATS -->
    <view wx:if="{{stats}}" class="pd-section anim-stage-rise anim-delay-3">
      <view class="pd-section-head">
        <text class="tape {{activeTab === 'singles' ? 'tape-lime tape-stamped-lime' : 'tape-ghost'}}">{{activeTapeLabel}}</text>
      </view>
      <view class="pd-stats-row">
        <view class="pd-stat pd-stat-paper">
          <text class="pd-stat-num num">{{activeStats.winCount}}<text class="pd-stat-denom">/{{activeStats.winCount + activeStats.lossCount}}</text></text>
          <text class="pd-stat-label">胜场/总</text>
        </view>
        <view class="pd-stat {{activeTab === 'singles' ? 'pd-stat-lime' : 'pd-stat-paper-alt'}}">
          <text class="pd-stat-num num">{{activePct}}</text>
          <text class="pd-stat-label">胜率</text>
        </view>
        <view class="pd-stat {{activeTab === 'singles' ? 'pd-stat-ink' : 'pd-stat-paper-alt'}}">
          <text class="pd-stat-num num">{{activeStats.totalPoints}}</text>
          <text class="pd-stat-label">积分</text>
        </view>
      </view>
    </view>

    <!-- ACTIVE RANK CHART -->
    <view class="pd-section anim-stage-rise anim-delay-4">
      <view class="pd-section-head">
        <text class="tape {{activeTab === 'singles' ? 'tape-lime tape-stamped-lime' : 'tape-ghost'}}">排名走势 · {{activeTypeLabel}} · 12周</text>
      </view>
      <rank-chart data="{{activeRankHistory}}" />
      <text wx:if="{{activeRankHistory.length >= 2}}" class="pd-chart-meta">越靠上名次越好 · {{activeRankHistory.length}} 周</text>
    </view>

    <!-- ACTIVE H2H -->
    <view class="pd-section anim-stage-rise anim-delay-5">
      <view class="pd-section-head">
        <text class="tape {{activeTab === 'singles' ? 'tape-lime tape-stamped-lime' : 'tape-ghost'}}">交手记录 · H2H · {{activeTypeLabel}}</text>
        <text wx:if="{{activeH2H.length}}" class="pd-section-count num">{{activeH2H.length}}</text>
      </view>
      <view wx:if="{{activeH2H.length > 0}}" class="pd-recent-list">
        <h2h-row
          wx:for="{{activeH2HVisible}}"
          wx:key="memberId"
          player-id="{{item.memberId}}"
          name="{{item.name}}"
          avatar-url="{{item.avatarUrl}}"
          wins="{{item.wins}}"
          losses="{{item.losses}}"
          bind:tap="onH2HTap"
        />
      </view>
      <view wx:else class="pd-recent-empty">
        <text>暂无{{activeTypeLabel}}交手记录</text>
      </view>
      <button
        wx:if="{{activeH2H.length > h2hDefaultVisible && !activeH2HExpanded}}"
        class="pd-h2h-expand"
        data-type="{{activeTab}}"
        bindtap="toggleH2HExpanded"
      >展开全部 {{activeH2H.length}} 人 →</button>
    </view>

    <!-- RECENT -->
    <view class="pd-section anim-stage-rise anim-delay-6">
      <view class="pd-section-head">
        <text class="tape">最近比赛 · {{activeTypeLabel}} · RECENT</text>
        <text wx:if="{{activeRecent.length}}" class="pd-section-count num">{{activeRecent.length}}</text>
      </view>
      <view wx:if="{{activeRecent.length > 0}}" class="pd-recent-list">
        <view wx:for="{{activeRecent}}" wx:key="_id" class="pd-recent-row" data-tournamentid="{{item.tournamentId}}" data-matchid="{{item.matchId || item.sourceMatchId || item._id}}" bindtap="onRecentTap" hover-class="pd-recent-row--active" hover-stay-time="80">
          <view class="pd-recent-top">
            <text class="pd-recent-badge {{item.tournamentFormat === 'regular' ? 'reg' : ''}}">{{item.tournamentFormat === 'regular' ? '常规赛' : (item.roundLabel || ('R' + item.round))}}</text>
            <text class="pd-recent-tour">{{item.tournamentName || '赛事'}}</text>
            <text class="pd-recent-date num">{{item.confirmedAt || item.createTime}}</text>
          </view>
          <view class="pd-recent-result">
            <view class="pd-recent-result-left">
              <text class="pd-recent-score num">{{item.score || '比分未录入'}}</text>
              <text class="pd-recent-opp">vs {{item.opponentName || '对手'}}</text>
            </view>
            <text class="pd-recent-points {{item.won ? 'win' : 'loss'}} num">+{{item.pointsAwarded}}</text>
          </view>
        </view>
      </view>
      <view wx:else class="pd-recent-empty">
        <text>暂无{{activeTypeLabel}}近期比赛</text>
      </view>
    </view>

  </block>

  <view wx:else class="pd-empty">
    <text class="tape">球员信息不存在</text>
  </view>
</view>
