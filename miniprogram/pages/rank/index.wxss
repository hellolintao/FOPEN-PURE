.rank-page {
  padding: var(--space-5) var(--space-5) 160rpx;
  background: var(--color-bg);
  min-height: 100vh;
}

/* ============================================================
 * HEAD
 * ============================================================ */
.page-head {
  margin-bottom: var(--space-6);
}

.head-meta {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  margin-bottom: var(--space-5);
}

.head-meta-text {
  font-size: var(--font-meta-size);
  color: var(--color-muted);
  font-weight: 600;
  letter-spacing: 0.04em;
}

.head-title {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.head-title-zh {
  font-size: 72rpx;
  font-weight: 900;
  line-height: 0.95;
  color: var(--color-ink);
  letter-spacing: -0.01em;
}

.head-title-en {
  font-family: var(--font-family-num);
  font-size: 36rpx;
  font-weight: 900;
  letter-spacing: 0.08em;
  color: var(--color-muted-2);
  line-height: 1;
}

/* ============================================================
 * TABS
 * ============================================================ */
.tab-wrap {
  margin-bottom: var(--space-6);
}

/* ============================================================
 * WEEKLY STAR HERO
 * ============================================================ */
.star-card {
  background: var(--color-ink);
  color: var(--color-bg);
  border-radius: var(--radius-lg);
  padding: var(--space-5) var(--space-6);
  margin-bottom: var(--space-6);
  position: relative;
  cursor: pointer;
}

.star-tape-wrap {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.star-range {
  font-size: var(--font-meta-size);
  color: var(--color-muted-2);
  font-weight: 600;
  letter-spacing: 0.04em;
}

.star-body {
  display: flex;
  align-items: center;
  gap: var(--space-4);
}

.star-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--color-bg-3);
  border: 2rpx solid var(--color-lime);
}

.star-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.star-name {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--color-bg);
  letter-spacing: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.star-subtitle {
  font-size: var(--font-meta-size);
  font-weight: 600;
  color: var(--color-muted-2);
  letter-spacing: 0;
}

.star-cta-arrow {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-lime);
  line-height: 1;
}

/* ============================================================
 * LIST
 * ============================================================ */
.list-head {
  display: grid;
  grid-template-columns: 64rpx 1fr 80rpx 80rpx 80rpx;
  gap: 12rpx;
  padding: 0 24rpx var(--space-3);
  margin-top: var(--space-6);
  align-items: baseline;
  border-bottom: 2rpx solid var(--color-ink);
  margin-bottom: var(--space-2);
}

.list-col {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 0;
  text-transform: uppercase;
  color: var(--color-ink);
}

.list-col-winrate,
.list-col-pts,
.list-col-trend {
  text-align: right;
}

.rank-list {
  display: flex;
  flex-direction: column;
}

/* ============================================================
 * EMPTY
 * ============================================================ */
.rank-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-4);
  padding: var(--space-9) 0;
  text-align: center;
}

.rank-empty-hint {
  font-size: var(--font-body-size);
  color: var(--color-muted);
  max-width: 480rpx;
  line-height: 1.5;
}
