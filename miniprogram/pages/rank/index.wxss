.rank-container {
  background: #f5f5f5;
  min-height: 100vh;
  padding: 24rpx;
}

.rank-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 200rpx;
  color: #999;
  font-size: 28rpx;
}

.rank-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.rank-number {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-right: 16rpx;
}

/* 前三名特殊样式 */
.rank-item:nth-child(1) .rank-number {
  background: #ffd700;
  color: #fff;
  border-radius: 50%;
}

.rank-item:nth-child(2) .rank-number {
  background: #c0c0c0;
  color: #fff;
  border-radius: 50%;
}

.rank-item:nth-child(3) .rank-number {
  background: #cd7f32;
  color: #fff;
  border-radius: 50%;
}

.rank-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f0f0f0;
  margin-right: 20rpx;
}

.rank-info {
  flex: 1;
  min-width: 0;
}

.rank-name {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-stats {
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.stat-item {
  color: #666;
}

.stat-item.win {
  color: #52c41a;
}

.stat-item.loss {
  color: #ff4d4f;
}

.stat-divider {
  color: #ddd;
  margin: 0 8rpx;
}

.rank-points {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 20rpx;
}

.points-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.points-label {
  font-size: 22rpx;
  color: #999;
}
