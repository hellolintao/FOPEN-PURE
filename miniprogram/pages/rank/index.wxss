.rank-container {
	background: #FFFFFF;
	min-height: 100vh;
	padding: 40rpx 0;
}
.rank-empty {
	color: #999;
	text-align: center;
	margin-top: 80rpx;
}
.rank-item {
	display: flex;
	align-items: center;
	background: #FFFFFF;
	border-radius: 16rpx;
	margin: 20rpx 32rpx;
	padding: 24rpx 20rpx;
	border: 2rpx solid #f0f0f0;
}
.rank-avatar {
	width: 80rpx;
	height: 80rpx;
	border-radius: 50%;
	background: #f0f0f0;
	border: 2rpx solid #e0e0e0;
}
.rank-info {
	flex: 1;
	margin-left: 28rpx;
}
.rank-name {
	font-size: 32rpx;
	color: #000000;
	font-weight: bold;
}
.rank-points {
	margin-top: 8rpx;
	color: #666;
	font-size: 26rpx;
}

