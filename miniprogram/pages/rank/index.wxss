.rank-container {
	padding: 40rpx 0;
}
.rank-empty {
	color: #aaa;
	text-align: center;
	margin-top: 80rpx;
}
.rank-item {
	display: flex;
	align-items: center;
	background: #1a1a2e;
	border-radius: 16rpx;
	margin: 20rpx 32rpx;
	padding: 24rpx 20rpx;
}
.rank-avatar {
	width: 80rpx;
	height: 80rpx;
	border-radius: 50%;
	background: #333;
	border: 2rpx solid #555;
}
.rank-info {
	flex: 1;
	margin-left: 28rpx;
}
.rank-name {
	font-size: 32rpx;
	color: #FFFFFF;
	font-weight: bold;
}
.rank-points {
	margin-top: 8rpx;
	color: #aaa;
	font-size: 26rpx;
}

