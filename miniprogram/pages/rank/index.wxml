<view class="rank-container">
  <view wx:if="{{rankList.length === 0}}" class="rank-empty">
    <text>暂无数据</text>
  </view>

  <view class="rank-list">
    <view class="rank-item" wx:for="{{rankList}}" wx:key="_id">
      <!-- 排名序号 -->
      <view class="rank-number">{{index + 1}}</view>

      <!-- 头像 -->
      <image class="rank-avatar" src="{{item.avatarUrl}}"></image>

      <!-- 用户信息 -->
      <view class="rank-info">
        <view class="rank-name">{{item.name}}</view>
        <view class="rank-stats">
          <text class="stat-item">{{item.totalGames}}场</text>
          <text class="stat-divider">|</text>
          <text class="stat-item win">{{item.winCount}}胜</text>
          <text class="stat-divider">|</text>
          <text class="stat-item loss">{{item.lossCount}}负</text>
        </view>
      </view>

      <!-- 积分 -->
      <view class="rank-points">
        <text class="points-value">{{item.totalPoints}}</text>
        <text class="points-label">积分</text>
      </view>
    </view>
  </view>
</view>
