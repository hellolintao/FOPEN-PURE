<view class="rank-page">

  <!-- HEAD -->
  <view class="page-head anim-stage-rise">
    <view class="head-meta">
      <text class="tape tape-stamped">SEASON · S{{seasonYear}}</text>
      <text class="head-meta-text">{{rankList.length}} 位选手 · 每日23:30更新</text>
    </view>
    <view class="head-title">
      <text class="head-title-zh">排行榜</text>
      <text class="head-title-en num">RANKINGS</text>
    </view>
  </view>

  <!-- TABS -->
  <view class="tab-wrap anim-stage-rise anim-delay-1">
    <chip-tab
      value="{{activeTab}}"
      options="{{rankTabOptions}}"
      bindchange="onTabChange"
    />
  </view>

  <!-- WEEKLY STAR HERO -->
  <view wx:if="{{starHero && starHero.mode !== 'empty'}}" class="star-card anim-stage-rise anim-delay-2" bindtap="onStarTap">
    <view class="star-tape-wrap">
      <text wx:if="{{starHero.mode === 'current'}}" class="tape tape-lime">★ WEEKLY STAR</text>
      <text wx:else class="tape">PREV WEEK · 上周冠军</text>
      <text class="star-range">{{starHero.weekStart}} – {{starHero.weekEnd}}</text>
    </view>
    <view class="star-body">
      <image class="star-avatar" src="{{(starHero.star && starHero.star.avatarUrl) || '/images/icons/default-avatar.png'}}" mode="aspectFill" />
      <view class="star-info">
        <text class="star-name">{{starHero.star && starHero.star.name}}</text>
        <text class="star-subtitle">{{starHero.subtitle}}</text>
      </view>
      <view class="star-cta-arrow">→</view>
    </view>
  </view>

  <!-- LIST HEADER -->
  <view class="list-head" wx:if="{{rankList.length}}">
    <text class="list-col list-col-rank">RANK</text>
    <text class="list-col list-col-player">PLAYER</text>
    <text class="list-col list-col-winrate">WIN%</text>
    <text class="list-col list-col-pts">PTS</text>
    <text class="list-col list-col-trend">TREND</text>
  </view>

  <!-- LIST -->
  <skeleton-loader wx:if="{{loading}}" rows="{{6}}" />

  <view wx:else class="rank-list">
    <rank-row
      wx:for="{{rankList}}" wx:key="_id"
      rank="{{index + 1}}"
      name="{{item.name}}"
      avatar-url="{{item.avatarUrl}}"
      win-rate-pct="{{item.winRatePct}}"
      total-points="{{item.totalPoints}}"
      trend-delta="{{item.trendDelta}}"
      player-id="{{item._id}}"
      highlight="{{currentMember && item._id === currentMember._id}}"
      bind:tap="onPlayerTap"
    />
  </view>

  <!-- EMPTY -->
  <view wx:if="{{!loading && rankList.length === 0}}" class="rank-empty">
    <text class="tape">暂无排名数据</text>
    <text class="rank-empty-hint">本赛季还未产生排名，先打几场再来看吧</text>
  </view>

</view>
