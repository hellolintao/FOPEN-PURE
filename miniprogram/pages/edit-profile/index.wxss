.edit-profile-container {
  background: #f7f7f7;
  min-height: 100vh;
  color: #333333;
  padding: 40rpx 0;
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: 44rpx;
  color: #333333;
  text-align: center;
  margin-bottom: 48rpx;
  font-weight: 600;
}

/* 表单区域 */
.form-section {
  padding: 0 40rpx;
  flex: 1;
}

.form-item {
  margin-bottom: 32rpx;
}

.field-label {
  color: #333333;
  font-size: 28rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  font-weight: 500;
}

.required {
  color: #999999;
  margin-right: 4rpx;
  font-size: 32rpx;
  font-weight: 500;
}

/* 头像区域 */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-preview {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #ffffff;
  border: 2rpx solid #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-hint {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #333333;
  color: #fff;
  font-size: 20rpx;
  padding: 8rpx 0;
  text-align: center;
}

/* 输入框样式 */
.dialog-input {
  width: 100%;
  background: #ffffff;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  color: #333333;
  font-size: 28rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

/* 底部按钮区域 */
.dialog-actions {
  display: flex;
  gap: 24rpx;
  padding: 40rpx;
  padding-bottom: 60rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #f7f7f7;
}

.dialog-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.dialog-btn.cancel {
  background: #f5f5f5;
  color: #333333;
}

.dialog-btn.cancel:active {
  background: #e8e8e8;
}

.dialog-btn.primary {
  background: #333333;
  color: #ffffff;
}

.dialog-btn.primary:active {
  opacity: 0.8;
}
