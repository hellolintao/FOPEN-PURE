.ep-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: var(--space-5) var(--space-5) 200rpx;
}

/* ============================================================
 * HEAD
 * ============================================================ */
.ep-head {
  margin-bottom: var(--space-6);
}

.head-tapes {
  margin-bottom: var(--space-4);
}

.head-title {
  display: block;
  font-size: 56rpx;
  font-weight: 900;
  color: var(--color-ink);
  line-height: 1;
  letter-spacing: -0.01em;
}

/* ============================================================
 * FORM
 * ============================================================ */
.ep-form {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.field-label {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
  margin-bottom: var(--space-2);
}

.field-num {
  font-size: 18rpx;
  font-weight: 900;
  color: var(--color-muted);
  letter-spacing: 0.08em;
}

.field-text {
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 0.06em;
  color: var(--color-ink);
  text-transform: uppercase;
}

.required {
  color: var(--color-danger);
  margin-left: 4rpx;
}

.optional {
  color: var(--color-muted-2);
  font-size: 18rpx;
  margin-left: 4rpx;
  text-transform: none;
}

/* ============================================================
 * AVATAR
 * ============================================================ */
.avatar-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: var(--space-5);
  width: 100%;
  min-height: 176rpx;
  padding: var(--space-5);
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-md);
  box-sizing: border-box;
  overflow: visible;
  line-height: 1.2;
}

.avatar-row[disabled] {
  opacity: 0.72;
}

.avatar-wrap {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--color-bg-3);
  border: 2rpx solid var(--color-ink);
  box-shadow: 4rpx 4rpx 0 var(--color-ink);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.avatar-meta-label {
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-muted);
}

.avatar-meta-val {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-ink);
  letter-spacing: 0.02em;
}

/* ============================================================
 * INPUT
 * ============================================================ */
.form-input {
  display: block;
  width: 100%;
  min-height: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--color-bg-3);
  border-radius: var(--radius-sm);
  color: var(--color-ink);
  font-size: 28rpx;
  font-weight: 700;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.form-placeholder {
  color: var(--color-muted-2);
  font-weight: 600;
}

.play-style-group {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3);
}

.ps-radio {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 72rpx;
  padding: 0 var(--space-3);
  background: var(--color-bg-3);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  box-sizing: border-box;
}

.ps-radio-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-ink);
  letter-spacing: 0;
}

/* ============================================================
 * AGREEMENT
 * ============================================================ */
.agreement-panel {
  margin-top: var(--space-6);
  padding: var(--space-4);
  background: var(--color-bg-2);
  border: 2rpx solid var(--color-border-strong);
  border-radius: var(--radius-sm);
}

.agreement-row {
  display: flex;
  align-items: flex-start;
  gap: var(--space-2);
}

.agreement-check {
  flex: 0 0 auto;
  padding-top: 2rpx;
}

.agreement-copy {
  flex: 1;
  min-width: 0;
  color: var(--color-muted);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.6;
  letter-spacing: 0;
}

.agreement-link {
  color: var(--color-ink);
  font-weight: 900;
  text-decoration: underline;
}

/* ============================================================
 * FOOTER
 * ============================================================ */
.ep-footer {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  display: flex;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-5) calc(var(--space-3) + env(safe-area-inset-bottom));
  background: var(--color-bg);
  border-top: 2rpx solid var(--color-ink);
  z-index: 10;
}

.footer-btn {
  flex: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-5) 0;
  border-radius: var(--radius-pill);
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.footer-btn-ghost {
  background: var(--color-bg);
  color: var(--color-ink);
  border: 2rpx solid var(--color-ink);
}

.footer-btn-primary {
  background: var(--color-ink);
  color: var(--color-bg);
}

.footer-btn-disabled {
  background: var(--color-muted-3);
  color: var(--color-bg);
}

button.avatar-row {
  width: 100%;
  margin: 0;
  text-align: left;
  line-height: 1.4;
}

button.avatar-row::after {
  border: none;
}
