.match-container {
	background: #FFFFFF;
	min-height: 100vh;
	padding: 40rpx 0;
}
.match-empty {
	color: #999;
	text-align: center;
	margin-top: 80rpx;
}
.match-item {
	background: #FFFFFF;
	border-radius: 16rpx;
	margin: 20rpx 32rpx;
	padding: 24rpx 20rpx;
	border: 2rpx solid #f0f0f0;
}
.match-name {
	font-size: 32rpx;
	color: #000000;
	font-weight: bold;
	margin-bottom: 12rpx;
}
.match-meta {
	display: flex;
	flex-direction: column;
	gap: 8rpx;
	color: #666;
	font-size: 26rpx;
}

