.match-container {
	padding: 40rpx 0;
}
.match-empty {
	color: #aaa;
	text-align: center;
	margin-top: 80rpx;
}
.match-item {
	background: #1a1a2e;
	border-radius: 16rpx;
	margin: 20rpx 32rpx;
	padding: 24rpx 20rpx;
}
.match-name {
	font-size: 32rpx;
	color: #FFFFFF;
	font-weight: bold;
	margin-bottom: 12rpx;
}
.match-meta {
	display: flex;
	flex-direction: column;
	gap: 8rpx;
	color: #aaa;
	font-size: 26rpx;
}

