<view class="tab-bar">
  <view
    wx:for="{{list}}" wx:key="pagePath"
    class="tab {{selected === item.pagePath ? 'on' : ''}}"
    data-index="{{index}}"
    bindtap="onTap"
  >
    <image class="tab-icon" src="{{selected === item.pagePath ? item.selectedIconPath : item.iconPath}}" mode="aspectFit" />
    <text class="tab-text {{selected === item.pagePath ? 'tab-text-on' : ''}}">{{item.text}}</text>
  </view>
</view>
