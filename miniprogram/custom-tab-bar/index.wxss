.tab-bar {
  display: flex;
  height: 128rpx;
  box-sizing: border-box;
  background-color: #BEF500;
  border: none;
  border-radius: 56rpx 56rpx 0 0;
  box-shadow: none;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding-bottom: 18rpx;
  z-index: 100;
  overflow: hidden;
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  min-width: 0;
  color: #0B0C09;
  position: relative;
  transition: transform 160ms ease-out, background 160ms ease-out;
}

.tab-icon {
  width: 42rpx;
  height: 42rpx;
  display: block;
  transition: transform 160ms ease-out;
}

.tab.on .tab-icon {
  transform: translateY(-2rpx);
}

.tab-text {
  max-width: 100%;
  overflow: hidden;
  text-overflow: clip;
  white-space: nowrap;
  font-size: 18rpx;
  line-height: 22rpx;
  font-weight: 700;
  letter-spacing: 0;
  color: #0B0C09;
}

.tab.on .tab-text {
  font-weight: 900;
}

.tab-text-on {
  color: #0B0C09;
  font-weight: 900;
}
