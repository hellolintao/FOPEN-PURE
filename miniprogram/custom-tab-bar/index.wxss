.tab-bar {
  display: flex;
  height: 120rpx;
  background: var(--color-bg, #101017);
  border-top: 1rpx solid var(--color-border);
  padding-bottom: env(safe-area-inset-bottom);
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #888;
}
.tab.on {
  color: var(--color-lime, #BEE645);
  font-weight: 700;
}
.tab-icon {
  width: 48rpx;
  height: 48rpx;
}
.tab-text {
  font-size: 22rpx;
}
.tab-text-on {
  color: var(--color-ink);
  font-weight: 700;
}
