.legal-page {
  min-height: 100vh;
  padding: var(--space-6) var(--space-5) var(--space-9);
  background: var(--color-bg);
}

.legal-head {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  margin-bottom: var(--space-7);
}

.legal-title {
  display: block;
  color: var(--color-ink);
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.1;
  letter-spacing: 0;
}

.legal-updated {
  color: var(--color-muted);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.legal-section {
  padding: var(--space-5) 0;
  border-top: 2rpx solid var(--color-border);
}

.legal-section-title {
  display: block;
  margin-bottom: var(--space-3);
  color: var(--color-ink);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.3;
  letter-spacing: 0;
}

.legal-body {
  display: block;
  color: var(--color-muted);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.75;
  letter-spacing: 0;
}
