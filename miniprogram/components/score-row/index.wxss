.row {
  border-bottom: 1rpx solid var(--color-border, #eee);
  padding: var(--space-2, 16rpx) 0;
}
.row.disabled {
  opacity: 0.55;
}
.row-head {
  display: flex;
  align-items: center;
  gap: var(--space-2, 16rpx);
  padding: 8rpx 4rpx;
}
.round-tag {
  padding: 4rpx 12rpx;
  background: var(--color-bg-soft, #f0f0f0);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-muted, #777);
  flex-shrink: 0;
}
.players {
  flex: 1;
  min-width: 0;
}
.players.singles {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
}
.players.doubles {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.doubles-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  line-height: 1.3;
}
.partner-sep {
  color: var(--color-text-muted, #999);
}
.vs {
  color: var(--color-text-muted, #999);
  font-size: 22rpx;
}
.player-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 200rpx;
}
.right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  flex-shrink: 0;
}
.score-summary {
  font-size: 26rpx;
  color: var(--color-text-strong, #222);
  font-feature-settings: "tnum";
}
.status-chip {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}
.status-confirmed { background: rgba(34, 197, 94, 0.12); color: #16a34a; }
.status-submitted { background: rgba(234, 179, 8, 0.12); color: #ca8a04; }
.status-pending   { background: rgba(0, 0, 0, 0.06); color: var(--color-text-muted, #777); }
.status-disputed  { background: rgba(239, 68, 68, 0.12); color: #b91c1c; }

.row-editor {
  padding: var(--space-2, 16rpx);
  display: flex;
  flex-direction: column;
  gap: var(--space-2, 16rpx);
  margin-top: var(--space-2, 16rpx);
  background: var(--color-bg-soft, #fafafa);
  border-radius: var(--radius-md, 12rpx);
}
.stepper-block {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.stepper-label {
  flex: 1;
  font-size: 26rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.stepper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.stepper-btn {
  width: 64rpx !important;
  padding: 0 !important;
  text-align: center;
}
.stepper-val {
  min-width: 56rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}
.tiebreak {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.tb-input {
  flex: 1;
  background: #fff;
  padding: 10rpx 16rpx;
  border-radius: var(--radius-md, 12rpx);
  border: 1rpx solid var(--color-border, #eee);
  font-size: 26rpx;
}
.err {
  color: var(--color-danger, #d33);
  font-size: 24rpx;
}
.submit {
  margin-top: 8rpx;
}
