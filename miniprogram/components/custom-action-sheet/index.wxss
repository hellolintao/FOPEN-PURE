.action-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 9999;
  visibility: hidden;
  transition: background 0.3s ease;
}

.action-sheet-mask.show {
  background: rgba(0, 0, 0, 0.5);
  visibility: visible;
}

.action-sheet-content {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: -100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  transition: bottom 0.3s ease;
  max-height: 80vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.action-sheet-mask.show .action-sheet-content {
  bottom: 0;
}

.action-sheet-title {
  padding: 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999;
  border-bottom: 1rpx solid #eee;
}

.action-sheet-list {
  max-height: 60vh;
  overflow-y: auto;
}

.action-sheet-item {
  padding: 36rpx;
  text-align: center;
  font-size: 32rpx;
  color: #333;
  border-bottom: 1rpx solid #f5f5f5;
}

.action-sheet-item.last {
  border-bottom: none;
}

.action-sheet-cancel {
  margin-top: 16rpx;
  padding: 32rpx;
  text-align: center;
  font-size: 32rpx;
  color: #333;
  background: #fff;
  border-top: 16rpx solid #f5f5f5;
}
