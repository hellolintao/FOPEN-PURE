.picker-mask {
  position: fixed; inset: 0;
  background: rgba(11, 12, 9, 0.55);
  z-index: 999;
  display: flex; align-items: flex-end;
}

.picker-sheet {
  background: var(--color-bg);
  width: 100%;
  max-height: 86vh;
  border-top-left-radius: var(--radius-lg);
  border-top-right-radius: var(--radius-lg);
  padding: var(--space-5) var(--space-5) calc(var(--space-4) + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  border-top: 2rpx solid var(--color-ink);
}

.picker-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: var(--space-3);
  border-bottom: 2rpx solid var(--color-ink);
  margin-bottom: var(--space-4);
}

.picker-title {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--color-ink);
  letter-spacing: 0.02em;
}

.picker-cancel {
  height: 56rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 18rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
  border-radius: var(--radius-pill);
}

.picker-search {
  background: var(--color-bg-3);
  padding: 0 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-ink);
  margin-bottom: var(--space-3);
  box-sizing: border-box;
  width: 100%;
}

.picker-list {
  flex: 1;
  overflow-y: auto;
  max-height: 60vh;
  margin: 0 calc(-1 * var(--space-2));
  padding: 0 var(--space-2);
}

.picker-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: 18rpx 16rpx;
  border-bottom: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  transition: background var(--dur-fast) var(--ease-out);
}

.picker-row.sel {
  background: var(--color-lime-wash);
  border-bottom-color: transparent;
  box-shadow: inset 0 0 0 2rpx var(--color-lime-strong);
}

.picker-row.disabled {
  opacity: 0.35;
  pointer-events: none;
}

.picker-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--color-bg-3);
  border: 2rpx solid var(--color-border);
  box-sizing: border-box;
  flex: 0 0 72rpx;
}

.picker-row.sel .picker-avatar {
  border-color: var(--color-lime-strong);
}

.picker-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-ink);
  letter-spacing: 0.01em;
}

.picker-tick {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--color-lime);
  color: var(--color-ink);
  font-weight: 900;
  font-size: 28rpx;
  line-height: 1;
}

.picker-confirm {
  margin-top: var(--space-4);
  height: 96rpx;
  line-height: 96rpx;
  background: var(--color-ink);
  color: var(--color-bg);
  border-radius: var(--radius-pill);
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: 0.06em;
  padding: 0;
}

.picker-confirm::after {
  border: none;
}

.picker-confirm:active {
  transform: scale(0.98);
  opacity: 0.92;
}
