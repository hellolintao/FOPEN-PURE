<view wx:if="{{show}}" class="picker-mask" bindtap="onMaskTap">
  <view class="picker-sheet" catchtap="onSheetTap">
    <view class="picker-head">
      <text class="picker-title">{{title}}</text>
      <text class="picker-cancel" bindtap="onCancel">取消</text>
    </view>
    <input class="picker-search" placeholder="搜索姓名" bindinput="onSearch" value="{{keyword}}" />
    <scroll-view scroll-y class="picker-list">
      <view
        wx:for="{{memberRows}}"
        wx:key="_id"
        class="picker-row {{item.selected ? 'sel' : ''}} {{item.disabled ? 'disabled' : ''}}"
        data-id="{{item._id}}"
        bindtap="onTap"
      >
        <image class="picker-avatar" src="{{item.avatarUrl}}" />
        <text class="picker-name">{{item.name}}</text>
        <text wx:if="{{item.selected}}" class="picker-tick">✓</text>
      </view>
    </scroll-view>
    <button class="picker-confirm" bindtap="onConfirm">{{confirmLabel}}</button>
  </view>
</view>
