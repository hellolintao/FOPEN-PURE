.board {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

/* ============================================================
 * 顶部：tape 标题 + 胶囊操作按钮
 * ============================================================ */
.board-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding-bottom: var(--space-3);
  border-bottom: 2rpx solid var(--color-ink);
}

.board-head {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.board-tape {
  display: inline-flex;
  align-self: flex-start;
  align-items: center;
  height: 40rpx;
  padding: 0 14rpx;
  background: var(--color-ink);
  color: var(--color-bg);
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  white-space: nowrap;
  line-height: 1;
}

.board-help {
  font-size: 20rpx;
  color: var(--color-muted);
  font-weight: 600;
  letter-spacing: 0.04em;
}

.board-actions {
  display: flex;
  gap: var(--space-2);
  flex: 0 0 auto;
}

.board-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 28rpx;
  background: var(--color-lime);
  color: var(--color-ink);
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  font-weight: 900;
  letter-spacing: 0.06em;
  line-height: 1;
}

.board-pill-ghost {
  background: var(--color-bg);
  color: var(--color-ink);
  border: 2rpx solid var(--color-ink);
}

/* ============================================================
 * 排程表（CSS Grid · 每列按列内最大 cell 自适应）
 * ============================================================ */
.schedule-scroll {
  width: 100%;
}

.schedule-table {
  display: grid;
  /* grid-template-columns inline:
     96rpx repeat(N, minmax(240rpx, max-content)) */
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--color-bg);
  width: max-content;
  min-width: 100%;
}

/* ============================================================
 * Cell 通用（time-col + schedule-cell）
 * ============================================================ */
.time-col,
.schedule-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-right: 1rpx solid var(--color-border);
  border-bottom: 1rpx solid var(--color-border);
  min-height: 112rpx;
  background: var(--color-bg);
}

.time-col {
  background: var(--color-bg-2);
  font-family: var(--font-family-num);
  font-size: 24rpx;
  font-weight: 800;
  color: var(--color-ink);
  padding: 8rpx 4rpx;
  letter-spacing: -0.02em;
}

.schedule-cell {
  position: relative;
  padding: 12rpx 8rpx;
}

/* 表头行 · ink 黑底 + 白字 */
.time-col.head,
.schedule-cell.head {
  min-height: 72rpx;
  background: var(--color-ink);
  color: var(--color-bg);
  border-right-color: var(--color-ink-2);
  border-bottom-color: var(--color-ink);
}

.time-col.head {
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  font-family: inherit;
}

.schedule-cell.head {
  flex-direction: column;
  gap: 4rpx;
  padding: 8rpx 12rpx;
}

.court-name {
  font-size: 24rpx;
  font-weight: 900;
  color: var(--color-bg);
  letter-spacing: 0.04em;
  text-align: center;
}

.court-slots {
  font-size: 18rpx;
  font-family: var(--font-family-num);
  color: var(--color-muted-2);
  font-weight: 700;
  letter-spacing: 0.02em;
}

/* ============================================================
 * 单元格按类型上色
 * ============================================================ */
.schedule-cell.cell-regularRound { background: var(--color-lime-wash); }
.schedule-cell.cell-bracket { background: var(--color-bg); }
.schedule-cell.cell-extra { background: var(--color-lime-wash); }
.schedule-cell.cell-freePlay { background: var(--color-warn-wash); }

.schedule-cell.cell-slot-conflict {
  background: #FFEDD5;
  box-shadow: inset 0 0 0 3rpx #F97316;
}

.schedule-cell.cell-slot-conflict .player {
  background: var(--color-bg);
  color: #C2410C;
  border-color: #F97316;
}

.schedule-cell.cell-duplicate {
  background: #FEE2E2;
  box-shadow: inset 0 0 0 3rpx var(--color-danger);
}

.schedule-cell.cell-duplicate .player {
  background: var(--color-bg);
  color: var(--color-danger);
  border-color: var(--color-danger);
}

.schedule-cell.unavailable {
  background: var(--color-bg-3);
  color: var(--color-muted-2);
}

/* ============================================================
 * 比赛对阵
 * ============================================================ */
.match-line {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding-right: 40rpx;
  box-sizing: border-box;
}

.match-line.doubles {
  gap: 4rpx;
}

.match-line.doubles .team-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
  justify-content: center;
}

.match-line.doubles .slash {
  color: var(--color-muted-2);
  font-size: 18rpx;
  font-weight: 800;
}

.match-line .vs {
  font-size: 16rpx;
}

.match-line.doubles .player {
  max-width: 200rpx;
  padding: 2rpx 8rpx;
}

.player {
  max-width: 320rpx;
  padding: 4rpx 10rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
  font-weight: 800;
  color: var(--color-ink);
  text-align: center;
  letter-spacing: 0;
  line-height: 1.15;
}

.vs {
  flex: 0 0 auto;
  color: var(--color-ink);
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 0.18em;
  padding: 0 4rpx;
}

/* 自由拉球 */
.free-line {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding-right: 40rpx;
  box-sizing: border-box;
}

.free-title {
  font-weight: 800;
  font-size: 22rpx;
  color: var(--color-ink-3);
  letter-spacing: 0.06em;
}

.free-players {
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 20rpx;
  color: var(--color-muted);
  font-weight: 600;
}

/* 删除按钮 · 右上角圆形 */
.row-del {
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  width: 30rpx;
  height: 30rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--color-bg);
  background: var(--color-ink);
  border-radius: 50%;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1;
}

.row-del.disabled {
  background: var(--color-bg-3);
  color: var(--color-muted-2);
  opacity: 0.5;
}

.empty-cell {
  color: var(--color-muted-2);
  font-size: 24rpx;
  font-weight: 700;
}

.empty-add {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: var(--radius-pill);
  border: 2rpx dashed var(--color-ink);
  color: var(--color-ink);
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0.04em;
  background: transparent;
}
