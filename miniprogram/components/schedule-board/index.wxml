<view class="board">
  <view class="board-top">
    <view class="board-head">
      <text class="board-tape">SCHEDULE · 排程</text>
      <text class="board-help">点选手换人 · 长按格子调整时间或场地</text>
    </view>
    <view class="board-actions">
      <view class="board-pill tap-scale" bindtap="onRegenerate">
        <text>重随</text>
      </view>
      <view class="board-pill board-pill-ghost tap-scale" bindtap="onClear">
        <text>清空</text>
      </view>
    </view>
  </view>

  <scroll-view scroll-x class="schedule-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="schedule-table" style="grid-template-columns: 96rpx repeat({{decoratedCourts.length}}, minmax(240rpx, max-content));">
      <!-- Header row · TIME label + court cells -->
      <view class="time-col head">TIME</view>
      <view wx:for="{{decoratedCourts}}" wx:key="courtId" class="schedule-cell head">
        <text class="court-name">{{item.name}}</text>
        <text class="court-slots">{{item.slotsLabel}}</text>
      </view>

      <!-- Data rows · flatten under grid -->
      <block wx:for="{{decoratedRows}}" wx:for-item="row" wx:key="slotKey">
        <view class="time-col num">{{row.slotLabel}}</view>
        <view
          wx:for="{{row.cells}}"
          wx:for-item="cell"
          wx:key="courtId"
          class="schedule-cell {{cell.available ? '' : 'unavailable'}} cell-{{cell.__rowKind}} {{cell.__duplicate ? 'cell-duplicate' : ''}}"
          bindlongpress="onTapItem"
          data-court-id="{{cell.courtId}}"
          data-match-id="{{cell.matchId}}"
          data-kind="{{cell.__rowKind}}"
        >
          <block wx:if="{{cell.available && cell.matchId}}">
            <block wx:if="{{cell.kind === 'match' && cell.__isDoubles}}">
              <view class="match-line doubles">
                <view class="team-row">
                  <text class="player" bindtap="onTapPlayer" data-match-id="{{cell.matchId}}" data-slot="player1">{{cell.__doublesP1}}</text>
                  <text class="slash">/</text>
                  <text class="player" bindtap="onTapPlayer" data-match-id="{{cell.matchId}}" data-slot="player1partner">{{cell.__doublesPartner1}}</text>
                </view>
                <text class="vs num">VS</text>
                <view class="team-row">
                  <text class="player" bindtap="onTapPlayer" data-match-id="{{cell.matchId}}" data-slot="player2">{{cell.__doublesP2}}</text>
                  <text class="slash">/</text>
                  <text class="player" bindtap="onTapPlayer" data-match-id="{{cell.matchId}}" data-slot="player2partner">{{cell.__doublesPartner2}}</text>
                </view>
              </view>
            </block>
            <block wx:elif="{{cell.kind === 'match'}}">
              <view class="match-line">
                <text class="player" bindtap="onTapPlayer" data-match-id="{{cell.matchId}}" data-slot="player1">{{cell.__player1Label}}</text>
                <text class="vs num">VS</text>
                <text class="player" bindtap="onTapPlayer" data-match-id="{{cell.matchId}}" data-slot="player2">{{cell.__player2Label}}</text>
              </view>
            </block>
            <block wx:elif="{{cell.kind === 'freePlay'}}">
              <view class="free-line">
                <text class="free-title">自由拉球</text>
                <text class="free-players">{{cell.__playersLabel || '占位'}}</text>
              </view>
            </block>
            <text class="row-del {{cell.__rowKind === 'bracket' ? 'disabled' : ''}}"
                  catchtap="onTapDelete"
                  data-court-id="{{cell.courtId}}"
                  data-match-id="{{cell.matchId}}"
                  data-kind="{{cell.__rowKind}}">✕</text>
          </block>
          <block wx:elif="{{cell.available}}">
            <view
              class="empty-add"
              catchtap="onTapEmpty"
              data-court-id="{{cell.courtId}}"
              data-slot-index="{{cell.slotIndex}}"
            >+ 添加</view>
          </block>
          <block wx:else>
            <text class="empty-cell">—</text>
          </block>
        </view>
      </block>
    </view>
  </scroll-view>

  <player-picker-sheet
    show="{{pickerShow}}"
    members="{{pickerMembers}}"
    required-count="{{pickerRequiredCount}}"
    exclude-ids="{{pickerExclude}}"
    title="{{pickerTitle}}"
    bindconfirm="onPickerConfirm"
    bindcancel="onPickerCancel"
  />
</view>
