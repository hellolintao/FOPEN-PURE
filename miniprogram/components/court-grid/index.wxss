.court-grid-wrapper {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  padding-bottom: var(--space-2);
}

.court-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  padding: 6rpx 24rpx;
  border-radius: var(--radius-pill);
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  font-size: 24rpx;
  line-height: 1.15;
  color: var(--color-ink);
  letter-spacing: 0.02em;
}

.court-chip.selected {
  background: var(--color-ink);
  border-color: var(--color-ink);
  color: var(--color-bg);
}

.chip-name {
  font-weight: 800;
}

.chip-loc {
  font-size: 18rpx;
  font-weight: 600;
  opacity: 0.7;
  margin-top: 2rpx;
  letter-spacing: 0.04em;
}

.timetable {
  display: flex;
  flex-direction: column;
  gap: 0;
  background: var(--color-bg);
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-md);
  padding: 0;
  max-height: 760rpx;
  overflow-y: auto;
}

.row {
  display: flex;
  align-items: stretch;
  gap: 4rpx;
  padding: 4rpx var(--space-3);
}

.row.header {
  padding: var(--space-3) var(--space-3) var(--space-2);
  border-bottom: 2rpx solid var(--color-ink);
  margin-bottom: 0;
  position: sticky;
  top: 0;
  background: var(--color-bg);
  z-index: 2;
}

.row:not(.header):first-of-type {
  padding-top: var(--space-2);
}

.row:last-of-type {
  padding-bottom: var(--space-2);
}

.time-col {
  flex: 0 0 96rpx;
  padding: 6rpx 4rpx;
  text-align: right;
  color: var(--color-muted);
  font-family: var(--font-family-num);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  letter-spacing: -0.02em;
}

.row.header .time-col {
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-ink);
  font-family: inherit;
}

.court-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 4rpx 2rpx;
}

.court-col.head {
  padding: 4rpx 2rpx;
}

.court-name {
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
  word-break: break-all;
  line-height: 1.2;
  letter-spacing: 0.02em;
  color: var(--color-ink);
}

.cell {
  width: 100%;
  height: 52rpx;
  background: var(--color-bg-3);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  transition: background var(--dur-fast) var(--ease-out);
}

.cell.picked {
  background: var(--color-lime);
  border-color: var(--color-lime-strong);
}

.empty {
  padding: var(--space-5);
  text-align: center;
  color: var(--color-muted);
  background: var(--color-bg);
  border: 2rpx dashed var(--color-border-strong);
  border-radius: var(--radius-md);
  font-size: var(--font-body-size);
  font-weight: 700;
}
