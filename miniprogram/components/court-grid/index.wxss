.timetable {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  background: #fff;
  padding: var(--space-2, 12rpx);
  border-radius: var(--radius-md, 12rpx);
}

.row {
  display: flex;
  align-items: stretch;
  gap: 4rpx;
}

.row.header {
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid var(--color-border, #e5e7eb);
  margin-bottom: 4rpx;
}

.time-col {
  flex: 0 0 92rpx;
  padding: 8rpx 4rpx;
  text-align: right;
  color: var(--color-text-muted, #6b7280);
  font-size: 24rpx;
  line-height: 1.3;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.row.header .time-col {
  font-weight: 600;
  color: var(--color-text, #111827);
}

.court-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 2rpx;
}

.court-col.head {
  padding: 4rpx 2rpx;
}

.court-name {
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  word-break: break-all;
  line-height: 1.2;
}

.court-loc {
  font-size: 20rpx;
  color: var(--color-text-muted, #6b7280);
  text-align: center;
  line-height: 1.2;
  margin-top: 2rpx;
}

.cell {
  width: 100%;
  height: 56rpx;
  background: var(--color-bg-soft, #f3f4f6);
  border: 1rpx solid var(--color-border, #e5e7eb);
  border-radius: 8rpx;
  transition: background 0.15s ease;
}

.cell.picked {
  background: var(--color-primary, #2563eb);
  border-color: var(--color-primary, #2563eb);
}

.empty {
  padding: var(--space-3, 16rpx);
  text-align: center;
  color: var(--color-text-muted, #6b7280);
  background: #fff;
  border-radius: var(--radius-md, 12rpx);
}
