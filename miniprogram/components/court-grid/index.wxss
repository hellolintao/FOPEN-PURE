.court-grid { display: flex; flex-direction: column; gap: var(--space-3, 16rpx); }
.court-row { border: 1rpx solid var(--color-border, #e5e7eb); border-radius: var(--radius-md, 12rpx); padding: var(--space-3, 16rpx); }
.court-head { display: flex; align-items: center; gap: var(--space-2, 12rpx); }
.court-check { width: 32rpx; height: 32rpx; border: 2rpx solid var(--color-border, #d1d5db); border-radius: 6rpx; flex-shrink: 0; }
.court-check.checked { background: var(--color-primary, #2563eb); border-color: var(--color-primary, #2563eb); position: relative; }
.court-check.checked::after { content: ''; position: absolute; left: 8rpx; top: 4rpx; width: 8rpx; height: 16rpx; border-right: 4rpx solid #fff; border-bottom: 4rpx solid #fff; transform: rotate(45deg); }
.court-name { font-weight: 600; }
.court-loc { font-size: 22rpx; color: var(--color-text-muted, #6b7280); margin-left: auto; }
.slot-grid { margin-top: var(--space-2, 12rpx); display: grid; grid-template-columns: repeat(4, 1fr); gap: 8rpx; }
.slot-cell { padding: 14rpx 0; text-align: center; border-radius: 8rpx; background: var(--color-bg-soft, #f3f4f6); font-size: 24rpx; color: var(--color-text, #111827); }
.slot-cell.picked { background: var(--color-primary, #2563eb); color: #fff; }
.empty { padding: var(--space-3, 16rpx); text-align: center; }
