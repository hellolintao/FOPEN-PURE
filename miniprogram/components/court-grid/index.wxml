<view class="timetable" wx:if="{{availableCourts.length > 0}}">
  <view class="row header">
    <view class="time-col">时间</view>
    <view wx:for="{{availableCourts}}" wx:key="courtId" class="court-col head">
      <text class="court-name">{{item.name}}</text>
      <text wx:if="{{item.location}}" class="court-loc">{{item.location}}</text>
    </view>
  </view>
  <view wx:for="{{rows}}" wx:for-item="row" wx:key="hour" class="row">
    <view class="time-col">{{row.hour}}</view>
    <view
      wx:for="{{row.cells}}"
      wx:for-item="cell"
      wx:key="courtId"
      class="court-col"
    >
      <view
        class="cell {{cell.picked ? 'picked' : ''}}"
        bindtap="onCellTap"
        data-court-id="{{cell.courtId}}"
        data-hour="{{row.hour}}"
      ></view>
    </view>
  </view>
</view>
<view wx:else class="empty">暂无可选球场，请先「+ 添加球场」</view>
