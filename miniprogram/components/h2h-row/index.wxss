.h2h-row {
  display: grid;
  align-items: center;
  gap: var(--space-3, 16rpx);
  min-height: 88rpx;
  padding: 16rpx var(--space-5, 24rpx);
  border-bottom: 1rpx solid var(--color-border, #f3f4f6);
  box-sizing: border-box;
  transition: background-color 160ms var(--ease-out, ease);
}

.h2h-row--single {
  grid-template-columns: minmax(0, 1fr) auto;
}

.h2h-row--team {
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
}

.h2h-row--active {
  background: var(--color-bg-2, #fafaf7);
}

.h2h-identity {
  grid-column: 1;
  display: flex;
  align-items: center;
  gap: var(--space-3, 16rpx);
  min-width: 0;
}

.avatar {
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-bg-3, #f3f4f6);
}

.name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--color-ink, #0a0a0a);
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 0;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pill {
  flex: 0 0 auto;
  max-width: 140rpx;
  overflow: hidden;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill, 999rpx);
  background: var(--color-bg-3, #f3f4f6);
  color: var(--color-ink, #0a0a0a);
  font-family: var(--font-family-num);
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 0;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.h2h-row--single .pill {
  grid-column: 2;
  justify-self: end;
}

.h2h-row--team .pill {
  grid-column: 2;
  justify-self: center;
}

.pill-win {
  background: var(--color-lime, #ddf099);
}

.pill-loss {
  background: rgba(220, 38, 38, 0.12);
  color: var(--color-danger, #dc2626);
}

.team {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}

.team-subject {
  grid-column: 1;
}

.team-opponent {
  grid-column: 3;
  text-align: right;
}

.team-kicker {
  color: var(--color-muted, #6b7280);
  font-size: 20rpx;
  font-weight: 800;
}

.team-name {
  color: var(--color-text-primary, var(--color-ink, #0a0a0a));
  font-size: 26rpx;
  font-weight: 850;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.h2h-recent {
  grid-column: 1 / -1;
  margin-top: 12rpx;
  border-top: 1rpx solid var(--color-border, #f3f4f6);
  padding-top: 10rpx;
}

.h2h-recent-row {
  display: flex;
  justify-content: space-between;
  color: var(--color-muted, #6b7280);
  font-size: 22rpx;
}
