.skeleton {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.skeleton-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) 0;
}

.skeleton-avatar,
.skeleton-line {
  background: var(--color-bg-3);
  animation: skeleton-pulse 900ms ease-in-out infinite;
}

.skeleton-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.skeleton-lines {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.skeleton-line {
  height: 22rpx;
  border-radius: var(--radius-pill);
}

.skeleton-line.long {
  width: 70%;
}

.skeleton-line.short {
  width: 42%;
}
