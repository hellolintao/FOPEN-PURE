.rank-row {
  display: grid;
  grid-template-columns: 64rpx 1fr 80rpx 80rpx 80rpx;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: transparent;
  position: relative;
}

/* 分隔线放在上沿 — 第一行没有，pages 自己控 */
.rank-row::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 1rpx;
  background: var(--color-border);
}

.rank-row.highlight {
  background: var(--color-lime-wash);
  border-left: 4rpx solid var(--color-lime);
}

.rank-row.highlight::before {
  background: transparent;
}

.rank-row.highlight-pride {
  margin: 8rpx 0;
  padding-top: 18rpx;
  padding-bottom: 18rpx;
  border-left: 0;
  border-radius: var(--radius-sm);
  background: linear-gradient(
    100deg,
    #F51F3E 0%,
    #FF8126 19%,
    #F6D84A 39%,
    #52B95E 58%,
    #2D82D9 76%,
    #8F20CE 100%
  );
  color: #FFF8F0;
}

.rank-row.highlight-pride::before {
  background: transparent;
}

.rank-num-cell {
  display: flex;
  align-items: baseline;
}

.rank-num {
  font-family: var(--font-family-num);
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: 0;
  color: var(--color-ink);
}

.player-cell {
  display: flex;
  align-items: center;
  min-width: 0;
}

.player-cell .name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-ink);
  letter-spacing: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.winrate-cell,
.pts-cell,
.trend-cell {
  text-align: right;
}

.winrate {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-ink-3);
  letter-spacing: 0;
}

.pts {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--color-ink);
  letter-spacing: 0;
}

.trend-cell {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.trend-text {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.trend-up .trend-text { color: var(--color-success); }
.trend-down .trend-text { color: var(--color-danger); }
.trend-flat .trend-text,
.trend-new .trend-text,
.trend-no_history .trend-text {
  color: var(--color-muted-2);
  font-size: 26rpx;
  font-weight: 600;
}

.rank-row.highlight-pride .rank-num,
.rank-row.highlight-pride .name,
.rank-row.highlight-pride .winrate,
.rank-row.highlight-pride .pts,
.rank-row.highlight-pride .trend-text {
  color: #FFF8F0;
}
