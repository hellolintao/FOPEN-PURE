.rank-row {
  display: grid;
  grid-template-columns: 96rpx 80rpx 1fr 96rpx;
  align-items: center;
  gap: var(--space-4);
  padding: var(--space-4) var(--space-3);
  background: transparent;
  position: relative;
}

/* 分隔线放在上沿 — 第一行没有，pages 自己控 */
.rank-row::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 1rpx;
  background: var(--color-border);
}

.rank-row.highlight {
  background: var(--color-lime-wash);
}

.rank-row.highlight::before {
  background: transparent;
}

.rank-row.highlight::after {
  /* highlight 行右侧贴一个 lime 印章块（非装饰条，是 stamp） */
  content: "";
  position: absolute;
  right: 0;
  top: 50%;
  width: 12rpx;
  height: 60%;
  background: var(--color-lime);
  transform: translateY(-50%);
}

.rank-num-cell {
  display: flex;
  align-items: baseline;
}

.rank-num {
  font-family: var(--font-family-num);
  font-size: 56rpx;
  font-weight: 900;
  line-height: 0.9;
  letter-spacing: -0.04em;
  color: var(--color-ink);
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--color-bg-3);
  border: 2rpx solid var(--color-ink);
}

.info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.info .name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-ink);
  letter-spacing: 0.02em;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.meta-row {
  display: inline-flex;
  align-items: baseline;
  gap: 6rpx;
}

.meta-points {
  font-family: var(--font-family-num);
  font-size: 26rpx;
  font-weight: 800;
  color: var(--color-ink-3);
  letter-spacing: -0.01em;
}

.meta-points-label {
  font-size: 18rpx;
  font-weight: 700;
  color: var(--color-muted-2);
  letter-spacing: 0.16em;
}

.trend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
  min-width: 96rpx;
}

.trend-arrow {
  font-size: 22rpx;
  line-height: 1;
}

.trend-num {
  font-size: 26rpx;
  font-weight: 800;
}

.trend-up { color: var(--color-success); }
.trend-up + .trend-num { color: var(--color-success); }

.trend-down { color: var(--color-danger); }
.trend-down + .trend-num { color: var(--color-danger); }

.trend-flat {
  color: var(--color-muted-2);
  font-size: 26rpx;
  font-weight: 600;
}
