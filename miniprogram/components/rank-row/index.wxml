<view class="rank-row {{highlight ? 'highlight' : ''}} {{prideHighlight ? 'highlight-pride' : ''}}" bindtap="onTap">
  <view class="rank-num-cell">
    <text class="rank-num num">{{rank < 10 ? '0' + rank : rank}}</text>
  </view>

  <view class="player-cell">
    <text class="name">{{name}}</text>
  </view>

  <view class="winrate-cell">
    <text class="winrate num">{{winRatePct || '—'}}</text>
  </view>

  <view class="pts-cell">
    <text class="pts num">{{totalPoints}}</text>
  </view>

  <view class="trend-cell trend-{{trendState}}">
    <text class="trend-text">{{trendLabel}}</text>
  </view>
</view>
